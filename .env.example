PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=twitch_chat_stats
# Separate database (same Mongo server) for web-only data the bot never reads:
# sessions, site preferences, cached Twitch profile data (avatar/chat color).
WEB_MONGODB_DB=chatwizardbot_web

SESSION_SECRET=change_me_to_a_long_random_string
# Encrypts channel owners' persisted Twitch refresh tokens at rest (see db/ownerTokensRepo.js).
# Keep this separate from SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=change_me_to_a_different_long_random_string

# Register a SEPARATE Twitch Developer Console app for this website
# (do not reuse the bot's Client_Id/client_secret from the TwitchBot repo).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback

# Comma-separated numeric Twitch user IDs granted tier-0 (app developer) access.
ADMIN_USER_IDS=

# The bot account's Twitch login, shown in the /request-bot "grant the bot moderator
# rights" instructions. Display-only.
BOT_LOGIN=chatwizardbot

# Bearer token for the /admin/api/* endpoints (Unban Bureau data, for external tooling - not a
# browser session). Leave blank to disable the routes entirely (404).
#
# These endpoints read the appeal queue, a case's dossier and its plain-text brief, and store the
# two expert opinions written onto the desk's fourth sheet. They CANNOT act on the queue: nothing
# reachable with this token approves an appeal, times anyone out, or changes what the bot will do to
# a Twitch account - those stay behind a moderator's session on /<channel>/unban-bureau.
#
# The opinions themselves are written by Claude Code running two subagents against the brief and
# PUT back through here (scripts/local/opinions.js). This app never calls Anthropic's API.
#
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In this project the live value lives in api_token.txt at the PROJECT root - deliberately outside
# both git repos - and scripts/local/opinions.js reads it from there.
ADMIN_API_TOKEN=