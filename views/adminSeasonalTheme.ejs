<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.tabSeasonalTheme') }) %>
<%- include('partials/nav') %>

<%
  const dateLocale = locale === 'ru' ? 'ru-RU' : 'en-US';
  const monthDayFmt = new Intl.DateTimeFormat(dateLocale, { day: 'numeric', month: 'long', timeZone: 'UTC' });
  const fullDateFmt = new Intl.DateTimeFormat(dateLocale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  const stampFmt = new Intl.DateTimeFormat(dateLocale, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  // Month/day only, so any leap year works as the carrier.
  const md = (p) => monthDayFmt.format(new Date(Date.UTC(2028, p.month - 1, p.day)));
  const themeName = (id) => t('season.themes.' + id + '.name');
  const effective = seasonalTheme; // what this very page is rendered with (middleware/seasonalTheme.js)
%>

<main class="pt-14 max-w-5xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('admin.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('admin.subtitle') %></p>

  <%- include('partials/adminTabs', { tab }) %>

  <section class="max-w-2xl">
    <h2 class="text-xl font-semibold text-neutral-100 mb-2"><%= t('season.admin.title') %></h2>
    <p class="text-sm text-neutral-400 mb-6"><%= t('season.admin.intro') %></p>

    <% if (saved) { %>
      <p class="mb-4 rounded-md border border-emerald-800 bg-emerald-900/20 px-4 py-2 text-sm text-emerald-300"><%= t('season.admin.saved') %></p>
    <% } %>
    <% if (invalid) { %>
      <p class="mb-4 rounded-md border border-red-800 bg-red-900/20 px-4 py-2 text-sm text-red-300"><%= t('season.admin.invalid') %></p>
    <% } %>

    <dl class="mb-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-neutral-500"><%= t('season.admin.effectiveNow') %></dt>
      <dd class="text-neutral-100 font-medium"><%= effective ? themeName(effective) : t('season.admin.none') %></dd>
      <dt class="text-neutral-500"><%= t('season.admin.calendarNow') %></dt>
      <dd class="text-neutral-300"><%= calendarTheme ? themeName(calendarTheme) : t('season.admin.none') %></dd>
      <% if (override.updatedAt) { %>
        <dt class="text-neutral-500"><%= t('season.admin.lastChanged') %></dt>
        <dd class="text-neutral-300"><%= stampFmt.format(new Date(override.updatedAt)) %><% if (override.updatedBy && override.updatedBy.login) { %> · <%= override.updatedBy.login %><% } %></dd>
      <% } %>
    </dl>

    <form method="post" action="/admin/seasonal-theme" class="rounded-lg border border-neutral-800 bg-neutral-900/60 p-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label for="season-mode" class="block text-sm font-medium text-neutral-200 mb-2"><%= t('season.admin.modeLabel') %></label>
      <select id="season-mode" name="seasonMode"
              class="w-full rounded-md border border-neutral-700 bg-neutral-950 px-3 py-2 text-sm text-neutral-100 focus:outline-none focus:ring-2 focus:ring-purple-500">
        <option value="auto"<%= formValue === 'auto' ? ' selected' : '' %>><%= t('season.admin.modeAuto') %></option>
        <% themes.forEach(function (theme) { %>
          <option value="force:<%= theme.id %>"<%= formValue === 'force:' + theme.id ? ' selected' : '' %>><%= t('season.admin.modeForce', { theme: themeName(theme.id) }) %></option>
        <% }); %>
        <option value="off"<%= formValue === 'off' ? ' selected' : '' %>><%= t('season.admin.modeOff') %></option>
      </select>
      <p class="mt-2 text-xs text-neutral-500"><%= t('season.admin.modeHint') %></p>
      <button type="submit" class="mt-4 px-4 py-2 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium transition-colors"><%= t('season.admin.save') %></button>
    </form>

    <h3 class="mt-10 mb-3 text-sm font-medium uppercase tracking-wide text-neutral-500"><%= t('season.admin.calendarTitle') %></h3>
    <ul class="divide-y divide-neutral-800 rounded-lg border border-neutral-800 text-sm">
      <% themes.forEach(function (theme) { %>
        <li class="px-4 py-3 flex flex-wrap items-baseline justify-between gap-2">
          <span class="text-neutral-100"><%= themeName(theme.id) %></span>
          <span class="text-neutral-400">
            <%= t('season.admin.window', { start: md(theme.start), end: md(theme.end) }) %>
            · <%= t('season.admin.nextStart', { date: fullDateFmt.format(new Date(Date.UTC(theme.next.year, theme.next.month - 1, theme.next.day))) }) %>
          </span>
        </li>
      <% }); %>
    </ul>
    <p class="mt-2 text-xs text-neutral-500"><%= t('season.admin.timeZone', { tz: timeZone }) %></p>
  </section>
</main>

<%- include('partials/foot') %>
