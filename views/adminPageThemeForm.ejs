<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.pageThemes.editTitle') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-3xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-8"><%= t('admin.title') %></h1>
  <%- include('partials/adminTabs', { tab }) %>

  <div class="flex items-center gap-3 mb-2">
    <% if (profile && profile.avatarUrl) { %>
      <img src="<%= profile.avatarUrl %>" alt="" width="40" height="40"
           class="rounded-full border border-neutral-800" style="width:40px;height:40px" />
    <% } %>
    <div>
      <h2 class="text-lg font-semibold text-neutral-100">
        <%= (profile && (profile.displayName || profile.login)) || userId %>
      </h2>
      <p class="text-xs text-neutral-600 tabular-nums">ID <%= userId %></p>
    </div>
  </div>
  <p class="text-neutral-500 text-sm mb-8">
    <%= t('admin.pageThemes.editHint') %>
    <% if (previewChannel && profile && profile.login) { %>
      <a href="/<%= previewChannel %>/user/<%= profile.login %>" class="text-purple-400 hover:text-purple-300 transition-colors">
        <%= t('admin.pageThemes.openPage') %>
      </a>
    <% } %>
  </p>

  <% if (error) { %>
    <div class="mb-6 rounded-md border border-red-800 bg-red-950/50 text-red-300 text-sm px-4 py-3"><%= error %></div>
  <% } %>

  <form method="post" action="/admin/page-themes/<%= userId %>" enctype="multipart/form-data" class="space-y-8">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <label class="flex items-center gap-2 text-sm text-neutral-200 cursor-pointer">
      <input type="checkbox" name="enabled" value="1" class="accent-purple-600" <%= theme.enabled ? 'checked' : '' %> />
      <%= t('admin.pageThemes.fieldEnabled') %>
    </label>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="theme-title" class="block text-xs text-neutral-500 mb-1">
          <%= t('admin.pageThemes.fieldTitle') %>
        </label>
        <input type="text" id="theme-title" name="title" maxlength="<%= constants.MAX_TITLE_LENGTH %>" value="<%= theme.title %>"
               class="w-full rounded-md bg-neutral-950 border border-neutral-700 text-sm text-neutral-200 px-3 py-1.5 focus:outline-none focus:border-purple-600" />
      </div>
      <div>
        <label for="theme-motto" class="block text-xs text-neutral-500 mb-1">
          <%= t('admin.pageThemes.fieldMotto') %>
        </label>
        <input type="text" id="theme-motto" name="motto" maxlength="<%= constants.MAX_MOTTO_LENGTH %>" value="<%= theme.motto %>"
               class="w-full rounded-md bg-neutral-950 border border-neutral-700 text-sm text-neutral-200 px-3 py-1.5 focus:outline-none focus:border-purple-600" />
      </div>
    </div>

    <%# Skin and palette. The skin decides which room is drawn; the palette decides what it is
        built from. They are separate controls because the palette lists are NOT shared - every
        preset belongs to exactly one skin (lib/pageThemeValidation.js's ACCENT_PRESETS).

        The preset always travels with the save - it supplies background and ink even when a
        custom accent is set, which is what keeps the page readable whatever colour is picked. %>
    <fieldset>
      <legend class="text-xs text-neutral-500 mb-2"><%= t('admin.pageThemes.fieldTheme') %></legend>
      <select name="theme" id="theme-skin"
              class="rounded-md bg-neutral-950 border border-neutral-700 text-sm text-neutral-200 px-3 py-1.5 focus:outline-none focus:border-purple-600">
        <% constants.THEMES.forEach(function(name) { %>
          <option value="<%= name %>" <%= theme.theme === name ? 'selected' : '' %>>
            <%= t('admin.pageThemes.themeName.' + name) %>
          </option>
        <% }) %>
      </select>
    </fieldset>

    <fieldset>
      <legend class="text-xs text-neutral-500 mb-2"><%= t('admin.pageThemes.fieldAccent') %></legend>
      <div class="flex flex-wrap items-center gap-4">
        <%# Every skin's palettes are rendered, and the ones that do not belong to the selected
            skin are disabled rather than omitted: public/js/page-theme-form.js swaps which group
            is live as the skin changes, without a round-trip. With the script absent the groups
            stay as the server drew them, and a save under a freshly-switched skin falls back to
            that skin's first palette - never to a preset from the other room. %>
        <select name="accent.preset" id="theme-accent-preset" data-skin-scoped
                class="rounded-md bg-neutral-950 border border-neutral-700 text-sm text-neutral-200 px-3 py-1.5 focus:outline-none focus:border-purple-600">
          <% constants.THEMES.forEach(function(name) { %>
            <optgroup label="<%= t('admin.pageThemes.themeName.' + name) %>" data-theme="<%= name %>"
                      <%= theme.theme === name ? '' : 'disabled hidden' %>>
              <% constants.ACCENT_PRESETS[name].forEach(function(preset) { %>
                <option value="<%= preset %>"
                        <%= theme.theme === name && theme.accent.preset === preset ? 'selected' : '' %>>
                  <%= t('admin.pageThemes.accentPreset.' + preset) %>
                </option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
        <label class="flex items-center gap-1.5 text-sm text-neutral-300 cursor-pointer">
          <input type="radio" name="accent.mode" value="preset" class="accent-purple-600" <%= theme.accent.custom ? '' : 'checked' %> />
          <%= t('admin.pageThemes.accentModePreset') %>
        </label>
        <label class="flex items-center gap-1.5 text-sm text-neutral-300 cursor-pointer">
          <input type="radio" name="accent.mode" value="custom" class="accent-purple-600" <%= theme.accent.custom ? 'checked' : '' %> />
          <%= t('admin.pageThemes.accentModeCustom') %>
        </label>
        <input type="color" name="accent.custom" value="<%= theme.accent.custom || '#c9a05c' %>"
               class="h-8 w-14 rounded border border-neutral-700 bg-neutral-950" />
      </div>
      <p class="text-xs text-neutral-600 mt-2"><%= t('admin.pageThemes.accentHint') %></p>
    </fieldset>

    <fieldset>
      <legend class="text-xs text-neutral-500 mb-2"><%= t('admin.pageThemes.fieldBackdrop') %></legend>
      <div class="flex flex-wrap items-center gap-4 mb-3">
        <% constants.BACKDROP_MODES.forEach(function(mode) { %>
          <label class="flex items-center gap-1.5 text-sm text-neutral-300 cursor-pointer">
            <input type="radio" name="backdrop.mode" value="<%= mode %>" class="accent-purple-600"
                   <%= theme.backdrop.mode === mode ? 'checked' : '' %> />
            <%= t('admin.pageThemes.backdropMode.' + mode) %>
          </label>
        <% }) %>
        <%# Grouped by skin for the same reason the palette is: the shipped wallpapers belong to
            one room each. public/js/page-theme-form.js swaps the live group with the skin. %>
        <select name="backdrop.preset" id="theme-backdrop-preset" data-skin-scoped
                class="rounded-md bg-neutral-950 border border-neutral-700 text-sm text-neutral-200 px-3 py-1.5 focus:outline-none focus:border-purple-600">
          <% constants.THEMES.forEach(function(name) { %>
            <optgroup label="<%= t('admin.pageThemes.themeName.' + name) %>" data-theme="<%= name %>"
                      <%= theme.theme === name ? '' : 'disabled hidden' %>>
              <% constants.BACKDROP_PRESETS[name].forEach(function(preset) { %>
                <option value="<%= preset %>"
                        <%= theme.theme === name && theme.backdrop.preset === preset ? 'selected' : '' %>>
                  <%= t('admin.pageThemes.backdropPreset.' + preset) %>
                </option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
        <select name="backdrop.scope"
                class="rounded-md bg-neutral-950 border border-neutral-700 text-sm text-neutral-200 px-3 py-1.5 focus:outline-none focus:border-purple-600">
          <% constants.BACKDROP_SCOPES.forEach(function(scope) { %>
            <option value="<%= scope %>" <%= theme.backdrop.scope === scope ? 'selected' : '' %>>
              <%= t('admin.pageThemes.backdropScope.' + scope) %>
            </option>
          <% }) %>
        </select>
      </div>
      <p class="text-xs text-neutral-600 -mt-1 mb-3"><%= t('admin.pageThemes.backdropScopeHint') %></p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="theme-backdrop-file" class="block text-xs text-neutral-500 mb-1">
            <%= t('admin.pageThemes.fieldBackdropFile') %>
          </label>
          <% if (theme.backdrop.uploadUrl) { %>
            <img src="<%= theme.backdrop.uploadUrl %>" alt="" class="mb-2 max-h-28 rounded-md border border-neutral-800" />
            <label class="flex items-center gap-1.5 text-xs text-neutral-400 mb-2 cursor-pointer">
              <input type="checkbox" name="backdrop.removeUpload" value="1" class="accent-red-600" />
              <%= t('admin.pageThemes.removeFile') %>
            </label>
          <% } %>
          <input type="file" id="theme-backdrop-file" name="backdropFile" accept="image/*"
                 class="w-full text-sm text-neutral-300 file:mr-3 file:px-3 file:py-1.5 file:rounded-md file:border file:border-neutral-700 file:bg-neutral-900 file:text-neutral-300 file:text-xs" />
        </div>

        <div>
          <label for="theme-medallion-file" class="block text-xs text-neutral-500 mb-1">
            <%= t('admin.pageThemes.fieldMedallion') %>
          </label>
          <% if (theme.medallionUrl) { %>
            <img src="<%= theme.medallionUrl %>" alt="" class="mb-2 max-h-28 rounded-md border border-neutral-800" />
            <label class="flex items-center gap-1.5 text-xs text-neutral-400 mb-2 cursor-pointer">
              <input type="checkbox" name="medallion.remove" value="1" class="accent-red-600" />
              <%= t('admin.pageThemes.removeFile') %>
            </label>
          <% } %>
          <input type="file" id="theme-medallion-file" name="medallionFile" accept="image/*"
                 class="w-full text-sm text-neutral-300 file:mr-3 file:px-3 file:py-1.5 file:rounded-md file:border file:border-neutral-700 file:bg-neutral-900 file:text-neutral-300 file:text-xs" />
          <p class="text-xs text-neutral-600 mt-1"><%= t('admin.pageThemes.medallionHint') %></p>
        </div>
      </div>
      <p class="text-xs text-neutral-600 mt-3">
        <%= t('admin.pageThemes.storageUsed') %>
        <span class="tabular-nums"><%= Math.round(theme.storageBytes / 1024).toLocaleString(locale) %></span> /
        <span class="tabular-nums"><%= Math.round(constants.MAX_USER_STORAGE_BYTES / 1024).toLocaleString(locale) %></span> KB
      </p>
    </fieldset>

    <%# The Steam display case. Only the profile URL is edited here - the items behind it are
        pulled from the profile when this URL changes or when the re-sync box is ticked. %>
    <fieldset>
      <legend class="text-xs text-neutral-500 mb-2"><%= t('admin.pageThemes.fieldSteam') %></legend>
      <input type="url" name="steam.profileUrl" value="<%= theme.steam.profileUrl || '' %>"
             placeholder="https://steamcommunity.com/id/..." autocomplete="off" spellcheck="false"
             class="w-full rounded-md bg-neutral-950 border border-neutral-700 text-sm text-neutral-200 px-3 py-1.5 focus:outline-none focus:border-purple-600" />
      <p class="text-xs text-neutral-600 mt-2"><%= t('admin.pageThemes.steamHint') %></p>
      <% if (theme.steam.items.length > 0) { %>
        <div class="flex items-center gap-2 mt-3 flex-wrap">
          <% theme.steam.items.forEach(function(item) { %>
            <img src="<%= item.image %>" alt="<%= item.name || '' %>" title="<%= item.name || '' %>"
                 class="w-10 h-10 rounded border" style="border-color: <%= item.borderColor || '#404040' %>" />
          <% }) %>
        </div>
        <p class="text-xs text-neutral-600 mt-2">
          <%= t('admin.pageThemes.steamSynced') %>
          <%= theme.steam.syncedAt ? new Date(theme.steam.syncedAt).toLocaleString(locale) : '—' %>
        </p>
        <label class="flex items-center gap-1.5 text-xs text-neutral-400 mt-2 cursor-pointer">
          <input type="checkbox" name="steam.resync" value="1" class="accent-purple-600" />
          <%= t('admin.pageThemes.steamResync') %>
        </label>
      <% } %>
    </fieldset>

    <label class="flex items-center gap-2 text-sm text-neutral-200 cursor-pointer">
      <input type="checkbox" name="intro" value="1" class="accent-purple-600" <%= theme.intro ? 'checked' : '' %> />
      <%= t('admin.pageThemes.fieldIntro') %>
    </label>

    <%# Four ordered slots rather than six checkboxes: the hero shows exactly four tiles, and
        their ORDER is what the reader sees left to right - a checkbox set can't express it. %>
    <fieldset>
      <legend class="text-xs text-neutral-500 mb-2"><%= t('admin.pageThemes.fieldTrophies') %></legend>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <% for (let slot = 0; slot < constants.TROPHY_COUNT; slot++) { %>
          <select name="trophies"
                  class="rounded-md bg-neutral-950 border border-neutral-700 text-sm text-neutral-200 px-3 py-1.5 focus:outline-none focus:border-purple-600">
            <% constants.TROPHIES.forEach(function(trophy) { %>
              <option value="<%= trophy %>" <%= theme.trophies[slot] === trophy ? 'selected' : '' %>>
                <%= t('admin.pageThemes.trophy.' + trophy) %>
              </option>
            <% }) %>
          </select>
        <% } %>
      </div>
      <p class="text-xs text-neutral-600 mt-2"><%= t('admin.pageThemes.trophiesHint') %></p>
    </fieldset>

    <div class="flex items-center gap-3 pt-2">
      <button type="submit"
              class="px-4 py-1.5 rounded-md bg-purple-700 hover:bg-purple-600 text-sm font-medium text-white transition-colors">
        <%= t('admin.pageThemes.save') %>
      </button>
      <a href="/admin/page-themes" class="text-sm text-neutral-500 hover:text-neutral-300 transition-colors">
        <%= t('admin.pageThemes.cancel') %>
      </a>
    </div>
  </form>

  <form method="post" action="/admin/page-themes/<%= userId %>/delete" class="mt-10 pt-6 border-t border-neutral-900"
        data-confirm-delete="<%= t('admin.pageThemes.deleteConfirm') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button type="submit" class="text-xs text-red-500 hover:text-red-400 transition-colors">
      <%= t('admin.pageThemes.delete') %>
    </button>
  </form>

  <script src="<%= asset('/js/confirm-delete.js') %>" defer></script>
  <script src="<%= asset('/js/page-theme-form.js') %>" defer></script>
</main>

<%- include('partials/foot') %>
