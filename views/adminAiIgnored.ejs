<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.ai.tabIgnored') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-5xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('admin.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('admin.subtitle') %></p>

  <%- include('partials/adminTabs', { tab }) %>
  <%- include('partials/aiTabs', { aiTab }) %>

  <p class="text-neutral-500 text-sm mb-6"><%= t('admin.ai.ignoredHint') %></p>

  <% if (!entries.length) { %>
    <p class="text-neutral-600 text-sm"><%= t('admin.ai.ignoredEmpty') %></p>
  <% } else { %>
    <div class="rounded-lg border border-neutral-800 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-neutral-900 text-neutral-400">
            <tr>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colWhen') %></th>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colChannel') %></th>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colUser') %></th>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colReason') %></th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800">
            <% entries.forEach(function (e) { %>
              <tr class="odd:bg-neutral-950 even:bg-neutral-900/40">
                <td class="px-4 py-2 text-neutral-500 whitespace-nowrap tabular-nums"><%= new Date(e.createdAt).toLocaleString() %></td>
                <td class="px-4 py-2 text-neutral-500"><%= e.channel %></td>
                <td class="px-4 py-2 text-neutral-200"><%= e.login %></td>
                <td class="px-4 py-2 text-neutral-400"><%= e.reason || '—' %></td>
                <td class="px-4 py-2 text-right">
                  <form method="post" action="/admin/ai/ignored/delete">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="channel" value="<%= e.channel %>" />
                    <input type="hidden" name="userId" value="<%= e.userId %>" />
                    <button type="submit" class="text-purple-400 hover:text-purple-300 text-xs"><%= t('admin.ai.unignore') %></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/foot') %>
