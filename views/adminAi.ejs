<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.tabAi') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-5xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('admin.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('admin.subtitle') %></p>

  <%- include('partials/adminTabs', { tab }) %>
  <%- include('partials/aiTabs', { aiTab }) %>

  <% if (saved) { %>
    <div class="mb-8 rounded-md border border-green-800 bg-green-950/50 text-green-300 text-sm px-4 py-3">
      <%= t('admin.ai.saved') %>
    </div>
  <% } %>

  <% if (!keyPresent) { %>
    <div class="mb-8 rounded-md border border-amber-800 bg-amber-950/40 text-amber-300 text-sm px-4 py-3">
      <%= t('admin.ai.keyMissing') %>
    </div>
  <% } %>

  <%# --- today's spend ------------------------------------------------- %>
  <section class="mb-12">
    <h2 class="text-lg font-semibold text-neutral-100 mb-4"><%= t('admin.ai.todayHeading') %></h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 px-4 py-3">
        <div class="text-xs text-neutral-500 mb-1"><%= t('admin.ai.todayRequests') %></div>
        <div class="text-xl font-semibold tabular-nums <%= today.requests >= config.dailyRequestLimit ? 'text-amber-400' : 'text-neutral-100' %>">
          <%= today.requests %> / <%= config.dailyRequestLimit %>
        </div>
      </div>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 px-4 py-3">
        <div class="text-xs text-neutral-500 mb-1"><%= t('admin.ai.todayCost') %></div>
        <div class="text-xl font-semibold tabular-nums text-neutral-100">$<%= (today.costUsd || 0).toFixed(3) %></div>
      </div>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 px-4 py-3">
        <div class="text-xs text-neutral-500 mb-1"><%= t('admin.ai.filterSize') %></div>
        <div class="text-xl font-semibold tabular-nums text-neutral-100"><%= filterCount %></div>
      </div>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 px-4 py-3">
        <div class="text-xs text-neutral-500 mb-1"><%= t('admin.ai.ignoredSize') %></div>
        <div class="text-xl font-semibold tabular-nums text-neutral-100"><%= ignoredCount %></div>
      </div>
    </div>
    <% if (today.requests >= config.dailyRequestLimit) { %>
      <p class="mt-3 text-sm text-amber-400"><%= t('admin.ai.limitReached') %></p>
    <% } %>
  </section>

  <form method="post" action="/admin/ai">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <%# --- master switch ----------------------------------------------- %>
    <section class="mb-12">
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 px-4 py-4 flex items-center justify-between gap-4">
        <div class="min-w-0">
          <span class="text-sm font-medium text-neutral-200"><%= t('admin.ai.masterSwitch') %></span>
          <p class="text-neutral-600 text-xs mt-0.5"><%= t('admin.ai.masterSwitchHint') %></p>
        </div>
        <label class="toggle-switch shrink-0">
          <input type="checkbox" name="enabled" <%= config.enabled ? 'checked' : '' %> class="sr-only" />
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
        </label>
      </div>
    </section>

    <%# --- model and budget -------------------------------------------- %>
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-neutral-100 mb-4"><%= t('admin.ai.budgetHeading') %></h2>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 divide-y divide-neutral-800">
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.model') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.modelHint') %></p>
          <select name="model" class="w-full sm:w-72 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500">
            <% validation.MODELS.forEach(function (m) { %>
              <option value="<%= m %>" <%= config.model === m ? 'selected' : '' %>><%= m %></option>
            <% }); %>
          </select>
        </div>

        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.dailyLimit') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.dailyLimitHint') %></p>
          <input type="number" name="dailyRequestLimit" value="<%= config.dailyRequestLimit %>"
                 min="<%= validation.BOUNDS.dailyRequestLimit.min %>" max="<%= validation.BOUNDS.dailyRequestLimit.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
        </div>

        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.cooldown') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.cooldownHint') %></p>
          <input type="number" name="cooldownSeconds" value="<%= Math.round(config.cooldownMs / 1000) %>"
                 min="<%= validation.BOUNDS.cooldownSeconds.min %>" max="<%= validation.BOUNDS.cooldownSeconds.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
        </div>

        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.requestTimeout') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.requestTimeoutHint') %></p>
          <input type="number" name="requestTimeoutSeconds" value="<%= Math.round(config.requestTimeoutMs / 1000) %>"
                 min="<%= validation.BOUNDS.requestTimeoutSeconds.min %>" max="<%= validation.BOUNDS.requestTimeoutSeconds.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
        </div>
      </div>
    </section>

    <%# --- memory ------------------------------------------------------- %>
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-neutral-100 mb-4"><%= t('admin.ai.memoryHeading') %></h2>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 divide-y divide-neutral-800">
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.memoryPairs') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.memoryPairsHint') %></p>
          <input type="number" name="memoryPairs" value="<%= config.memoryPairs %>"
                 min="<%= validation.BOUNDS.memoryPairs.min %>" max="<%= validation.BOUNDS.memoryPairs.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
        </div>
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.memoryTtl') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.memoryTtlHint') %></p>
          <input type="number" name="memoryTtlDays" value="<%= config.memoryTtlDays %>"
                 min="<%= validation.BOUNDS.memoryTtlDays.min %>" max="<%= validation.BOUNDS.memoryTtlDays.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
        </div>

        <%# The channel memory the bot fills in for itself. Separate from the pairs above: those are
            this viewer's last few exchanges, this is what the bot knows about the channel. %>
        <div class="px-4 py-4 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <span class="text-sm font-medium text-neutral-200"><%= t('admin.ai.channelMemoryEnabled') %></span>
            <p class="text-neutral-600 text-xs mt-0.5"><%= t('admin.ai.channelMemoryEnabledHint') %></p>
          </div>
          <label class="toggle-switch shrink-0">
            <input type="checkbox" name="channelMemoryEnabled" <%= config.channelMemoryEnabled ? 'checked' : '' %> class="sr-only" />
            <span class="toggle-track"><span class="toggle-thumb"></span></span>
          </label>
        </div>
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.channelMemoryMax') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.channelMemoryMaxHint') %></p>
          <input type="number" name="channelMemoryMax" value="<%= config.channelMemoryMax %>"
                 min="<%= validation.BOUNDS.channelMemoryMax.min %>" max="<%= validation.BOUNDS.channelMemoryMax.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
        </div>
        <%# Второе число - то самое, которое стоит денег: сколько фактов уезжает в один запрос.
            Первое ограничивает только размер списка, который админ потом разгребает. %>
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.channelMemoryRecall') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.channelMemoryRecallHint') %></p>
          <input type="number" name="channelMemoryRecall" value="<%= config.channelMemoryRecall %>"
                 min="<%= validation.BOUNDS.channelMemoryRecall.min %>" max="<%= validation.BOUNDS.channelMemoryRecall.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
          <p class="text-neutral-600 text-xs mt-2">
            <a href="/admin/ai/memory" class="text-purple-400 hover:text-purple-300"><%= t('admin.ai.channelMemoryLink') %></a>
          </p>
        </div>

        <%# Память о зрителях. Отдельный выключатель от памяти канала, потому что это разные
            решения: «пусть не запоминает про канал» и «пусть не запоминает про людей». %>
        <div class="px-4 py-4 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <span class="text-sm font-medium text-neutral-200"><%= t('admin.ai.userMemoryEnabled') %></span>
            <p class="text-neutral-600 text-xs mt-0.5"><%= t('admin.ai.userMemoryEnabledHint') %></p>
          </div>
          <label class="toggle-switch shrink-0">
            <input type="checkbox" name="userMemoryEnabled" <%= config.userMemoryEnabled ? 'checked' : '' %> class="sr-only" />
            <span class="toggle-track"><span class="toggle-thumb"></span></span>
          </label>
        </div>
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.userMemoryMax') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.userMemoryMaxHint') %></p>
          <input type="number" name="userMemoryMax" value="<%= config.userMemoryMax %>"
                 min="<%= validation.BOUNDS.userMemoryMax.min %>" max="<%= validation.BOUNDS.userMemoryMax.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
          <p class="text-neutral-600 text-xs mt-2">
            <a href="/admin/ai/viewers" class="text-purple-400 hover:text-purple-300"><%= t('admin.ai.userMemoryLink') %></a>
          </p>
        </div>
      </div>
    </section>

    <%# --- punishments --------------------------------------------------- %>
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-neutral-100 mb-1"><%= t('admin.ai.punishHeading') %></h2>
      <p class="text-neutral-500 text-sm mb-4"><%= t('admin.ai.punishHint') %></p>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 divide-y divide-neutral-800">
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-2"><%= t('admin.ai.punishMode') %></label>
          <label class="flex items-center gap-2 text-sm text-neutral-300 mb-1">
            <input type="radio" name="punishMode" value="observe" <%= config.punishMode === 'observe' ? 'checked' : '' %> />
            <%= t('admin.ai.punishObserve') %>
          </label>
          <label class="flex items-center gap-2 text-sm text-neutral-300">
            <input type="radio" name="punishMode" value="enforce" <%= config.punishMode === 'enforce' ? 'checked' : '' %> />
            <%= t('admin.ai.punishEnforce') %>
          </label>
          <p class="text-neutral-600 text-xs mt-2">
            <%= t('admin.ai.tallySoFar') %>
            <span class="text-green-400"><%= tally.agree %></span> /
            <span class="text-red-400"><%= tally.disagree %></span> /
            <span class="text-neutral-500"><%= tally.unreviewed %></span>
          </p>
        </div>
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.timeoutSeconds') %></label>
          <input type="number" name="timeoutSeconds" value="<%= config.timeoutSeconds %>"
                 min="<%= validation.BOUNDS.timeoutSeconds.min %>" max="<%= validation.BOUNDS.timeoutSeconds.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
        </div>

        <%# Шкала отношения стоит в разделе наказаний, а не памяти, хотя хранит она именно память:
            видимое её действие - кто получит предупреждение вместо мута и насколько длинным будет
            мут. Настройка, которую ищут глазами там, где смотрят на наказания. %>
        <div class="px-4 py-4 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <span class="text-sm font-medium text-neutral-200"><%= t('admin.ai.rapportEnabled') %></span>
            <p class="text-neutral-600 text-xs mt-0.5"><%= t('admin.ai.rapportEnabledHint') %></p>
          </div>
          <label class="toggle-switch shrink-0">
            <input type="checkbox" name="rapportEnabled" <%= config.rapportEnabled ? 'checked' : '' %> class="sr-only" />
            <span class="toggle-track"><span class="toggle-thumb"></span></span>
          </label>
        </div>
        <div class="px-4 py-3">
          <label class="block text-sm text-neutral-300 mb-1"><%= t('admin.ai.rapportMaxMultiplier') %></label>
          <p class="text-neutral-600 text-xs mb-2"><%= t('admin.ai.rapportMaxMultiplierHint') %></p>
          <input type="number" name="rapportMaxMultiplier" value="<%= config.rapportMaxMultiplier %>"
                 min="<%= validation.BOUNDS.rapportMaxMultiplier.min %>" max="<%= validation.BOUNDS.rapportMaxMultiplier.max %>"
                 class="w-32 rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
          <p class="text-neutral-600 text-xs mt-2">
            <a href="/admin/ai/rapport" class="text-purple-400 hover:text-purple-300"><%= t('admin.ai.tabRapport') %></a>
          </p>
        </div>
      </div>
    </section>

    <%# --- persona ------------------------------------------------------- %>
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-neutral-100 mb-1"><%= t('admin.ai.persona') %></h2>
      <p class="text-neutral-500 text-sm mb-4"><%= t('admin.ai.personaHint') %></p>
      <textarea name="persona" rows="6" maxlength="<%= validation.MAX_PERSONA_LEN %>"
                class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500"><%= config.persona %></textarea>
    </section>

    <%# --- правила целиком ----------------------------------------------- %>
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-neutral-100 mb-1"><%= t('admin.ai.systemPrompt') %></h2>
      <p class="text-neutral-500 text-sm mb-2"><%= t('admin.ai.systemPromptHint') %></p>
      <%# Единственное, что правка этого текста ломает молча: без блока про remember/forget модель
          перестаёт заполнять поля, ошибки при этом нет. Об этом надо сказать прямо. %>
      <p class="text-amber-500/80 text-xs mb-3"><%= t('admin.ai.systemPromptWarning') %></p>
      <%# В поле ВСЕГДА лежит текст, который сейчас работает: свой, если он сохранён, иначе
          встроенный из кода бота. Так правила можно править по одной строке, а не только
          заменять целиком. Пустым поле не остаётся никогда — пустое поле не подсказывает, что
          вообще уходит в модель.

          Обратная сторона: сохранённая копия перестаёт следовать за кодом. Поэтому при
          сохранении текст, дословно совпавший со встроенным, пишется как пустой — тогда канал
          снова следует за кодом, и правка правил в коде до него доедет. См. parseGlobalConfig. %>
      <p class="text-xs mb-2 <%= config.systemPrompt ? 'text-purple-400' : 'text-neutral-600' %>">
        <%= config.systemPrompt ? t('admin.ai.systemPromptCustom') : t('admin.ai.systemPromptBuiltinInUse') %>
      </p>
      <textarea id="systemPrompt" name="systemPrompt" rows="20" maxlength="<%= validation.MAX_SYSTEM_PROMPT_LEN %>"
                class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 font-mono leading-relaxed focus:outline-none focus:border-purple-500"><%= config.systemPrompt || config.builtinSystemPrompt %></textarea>
      <% if (config.builtinSystemPrompt) { %>
        <%# Текст приходит из кода бота, а не из копии в этом репозитории - см. aiConfigRepo.
            Кнопка только возвращает его в поле: сохранение остаётся отдельным шагом.
            nonce обязателен - CSP сайта не разрешает inline-скрипты без него (см. app.js). %>
        <button type="button" id="fillBuiltinPrompt"
                class="mt-2 text-xs text-purple-400 hover:text-purple-300"><%= t('admin.ai.systemPromptFillBuiltin') %></button>
        <script type="application/json" id="builtinPromptData"><%- safeJson(config.builtinSystemPrompt) %></script>
        <script nonce="<%= cspNonce %>">
          document.getElementById('fillBuiltinPrompt').addEventListener('click', function () {
            document.getElementById('systemPrompt').value =
              JSON.parse(document.getElementById('builtinPromptData').textContent);
          });
        </script>
      <% } else { %>
        <p class="mt-2 text-xs text-neutral-600"><%= t('admin.ai.systemPromptBuiltinUnknown') %></p>
      <% } %>

      <%# Сверка со встроенными правилами. Свёрнута по умолчанию: сравнение нужно, когда правила
          правят, а не каждый раз, когда страницу открыли ради лимита.

          Показывается СОХРАНЁННЫЙ текст, а не набранный в поле. Живая сверка по мере набора
          потребовала бы алгоритм ещё и на клиенте — третью копию того, чему нельзя разъезжаться, —
          и отвечала бы на другой вопрос: «что я сейчас печатаю» вместо «что у меня сохранено». %>
      <% if (promptDiff) { %>
        <details class="mt-4 rounded-lg border border-neutral-800 bg-neutral-900/40">
          <summary class="cursor-pointer select-none px-4 py-3 text-sm text-neutral-300">
            <%= t('admin.ai.promptDiffTitle') %>
            <% if (promptDiff.identical) { %>
              <span class="ml-2 text-xs text-neutral-500"><%= t('admin.ai.promptDiffNone') %></span>
            <% } else { %>
              <span class="ml-2 text-xs text-emerald-400">+<%= promptDiff.added %></span>
              <span class="ml-1 text-xs text-red-400">&minus;<%= promptDiff.removed %></span>
            <% } %>
          </summary>
          <div class="border-t border-neutral-800 px-2 py-2">
            <p class="px-2 pb-2 text-xs text-neutral-600"><%= t('admin.ai.promptDiffLegend') %></p>
            <div class="overflow-x-auto">
              <%# Маркер +/- живёт в собственной колонке, а не приклеен к тексту. Строки правил сами
                  начинаются с дефиса, и слитный вариант давал «- - Мат, грубость...» — читается как
                  опечатка. Он же select-none: при копировании блока маркеры не попадают в буфер, то
                  есть скопированное остаётся текстом промта, а не диффом. Цвет при этом не
                  единственный признак — маркер работает и в монохроме. %>
              <pre class="text-xs leading-relaxed font-mono"><% promptDiff.rows.forEach(function (row) { %><%
                %><span class="block px-2 whitespace-pre-wrap <%= row.type === 'add' ? 'bg-emerald-500/10 text-emerald-300' : row.type === 'del' ? 'bg-red-500/10 text-red-300' : 'text-neutral-500' %>"><span class="select-none opacity-50"><%= row.type === 'add' ? '+ ' : row.type === 'del' ? '- ' : '  ' %></span><%= row.text %></span><%
              %><% }); %></pre>
            </div>
          </div>
        </details>
      <% } %>
    </section>

    <button type="submit" class="px-4 py-2 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium transition-colors">
      <%= t('admin.ai.save') %>
    </button>
  </form>
</main>

<%- include('partials/foot') %>
