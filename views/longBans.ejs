<%- include('partials/head', { title: channel.channelLogin + ' · ' + t('longBans.title') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-4xl mx-auto px-6 py-12">

  <header class="mb-8">
    <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('longBans.title') %></h1>
    <p class="text-sm text-neutral-500"><%= channel.channelLogin %> · <%= t('longBans.subtitle') %></p>
  </header>

  <% if (saved) { %>
    <p class="mb-6 rounded-lg border border-green-800/50 bg-green-900/20 text-green-400 px-4 py-2.5 text-sm">
      <%= saved === 'cancelled' ? t('longBans.cancelled') : t('longBans.saved') %>
    </p>
  <% } %>
  <% if (error) { %>
    <p class="mb-6 rounded-lg border border-red-800/50 bg-red-900/20 text-red-400 px-4 py-2.5 text-sm">
      <%= t('longBans.errors.' + error) %><%= error === 'duration_overflow' ? ': ' + maxUnbanYear : '' %>
    </p>
  <% } %>

  <!-- Create -->
  <section class="mb-10 rounded-lg border border-neutral-800 bg-neutral-900 p-6">
    <h2 class="text-lg font-semibold text-neutral-100 mb-4"><%= t('longBans.create') %></h2>

    <form method="post" action="/<%= channel.channelLogin %>/settings/long-bans" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_10rem] gap-4">
        <div>
          <label for="userLogin" class="block text-xs uppercase tracking-wide text-neutral-500 mb-1"><%= t('longBans.user') %></label>
          <input type="text" id="userLogin" name="userLogin" required autocomplete="off"
                 class="w-full bg-neutral-950 border border-neutral-800 rounded-md px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-600" />
        </div>
        <div>
          <label for="mode" class="block text-xs uppercase tracking-wide text-neutral-500 mb-1"><%= t('longBans.mode') %></label>
          <select id="mode" name="mode"
                  class="w-full bg-neutral-950 border border-neutral-800 rounded-md px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-600">
            <option value="timeout"><%= t('longBans.modeTimeout') %></option>
            <option value="ban"><%= t('longBans.modeBan') %></option>
          </select>
        </div>
      </div>

      <div>
        <label for="duration" class="block text-xs uppercase tracking-wide text-neutral-500 mb-1"><%= t('longBans.duration') %></label>
        <input type="text" id="duration" name="duration" required autocomplete="off" placeholder="30d / 6w / 2m / 1y / 01.01.2030"
               class="w-full bg-neutral-950 border border-neutral-800 rounded-md px-3 py-2 text-sm text-neutral-200 placeholder:text-neutral-600 focus:outline-none focus:border-purple-600" />
        <p class="text-xs text-neutral-600 mt-1"><%= t('longBans.durationHint') %> <%= t('longBans.maxYear') %> <%= maxUnbanYear %>.</p>
      </div>

      <div>
        <label for="reason" class="block text-xs uppercase tracking-wide text-neutral-500 mb-1"><%= t('longBans.reason') %></label>
        <input type="text" id="reason" name="reason" maxlength="<%= maxReasonLength %>"
               class="w-full bg-neutral-950 border border-neutral-800 rounded-md px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-600" />
      </div>

      <button type="submit"
              class="px-4 py-2 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium transition-colors"><%= t('longBans.save') %></button>
    </form>
  </section>

  <!-- Existing -->
  <section>
    <h2 class="text-lg font-semibold text-neutral-100 mb-3"><%= t('longBans.existing') %> <span class="text-neutral-600 text-sm">(<%= longBans.length %>)</span></h2>

    <% if (longBans.length === 0) { %>
      <p class="rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-6 text-center text-neutral-600 text-sm"><%= t('longBans.none') %></p>
    <% } else { %>
      <ul class="rounded-lg border border-neutral-800 bg-neutral-900 divide-y divide-neutral-800/70">
        <% longBans.forEach(function(b) { %>
          <li class="px-4 py-3 flex items-start gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-neutral-200 font-medium">@<%= b.userLogin %></span>
                <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded <%= b.mode === 'ban' ? 'bg-red-600/20 text-red-400 border border-red-600/30' : 'bg-amber-600/20 text-amber-500 border border-amber-600/30' %>">
                  <%= b.mode === 'ban' ? t('longBans.modeBan') : t('longBans.modeTimeout') %>
                </span>
                <% if (b.status === 'pending') { %>
                  <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-500 border border-neutral-700"><%= t('longBans.statusPending') %></span>
                <% } else if (b.status === 'cancelRequested') { %>
                  <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-500 border border-neutral-700"><%= t('longBans.statusCancelling') %></span>
                <% } %>
              </div>
              <p class="text-sm text-neutral-400 mt-1"><%= t('longBans.until') %> <%= new Date(b.unbanAt).toLocaleString(locale) %></p>
              <% if (b.reason) { %><p class="text-sm text-neutral-500 mt-0.5 break-words"><%= b.reason %></p><% } %>
              <p class="text-xs text-neutral-600 mt-1"><%= b.createdBySource === 'web' ? t('longBans.originWeb') : t('longBans.originChat') %>: <%= b.createdByDisplayName || b.createdByLogin %></p>
            </div>

            <div class="flex items-center gap-1 shrink-0">
              <% if (b.status !== 'cancelRequested') { %>
                <form method="post" action="/<%= channel.channelLogin %>/settings/long-bans" data-confirm-delete="<%= t('longBans.cancelConfirm') %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="action" value="cancel" />
                  <input type="hidden" name="id" value="<%= b._id %>" />
                  <button type="submit"
                          class="px-2.5 py-1.5 rounded text-xs text-neutral-400 hover:text-red-400 hover:bg-red-500/10 transition-colors border border-neutral-800"><%= t('longBans.cancelButton') %></button>
                </form>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

</main>

<script src="/js/confirm-delete.js" defer></script>

<%- include('partials/foot') %>
