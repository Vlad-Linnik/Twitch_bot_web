<%- include('partials/head', { title: channel.channelLogin + ' — ' + t('unbanBureau.title') }) %>
<%- include('partials/nav') %>

<%#
  «Бюро амнистии» — the unban-appeal review desk for /:channel/unban-bureau
  (routes/unbanBureau.js, requireLevel(2)).

  A fixed 1920x1080 scene that public/js/games/unban-bureau.js scales to the viewport - every
  coordinate lives in public/css/unban-bureau.css, pinned to the artwork in main-gui.png. That
  stylesheet is linked here and ONLY here (see its own header for why it isn't part of input.css).

  Nothing on this page talks to Twitch. Handing a stamped visa through the window records the
  decision on the shared UnbanRequests doc; TwitchBot/twitch/unbanRequestScheduler.js applies it on
  its next ~60s poll. Same for the sniper: a shot writes a request, the bot fires it. See
  ../CLAUDE.md's "Бюро амнистии" section.

  #ub-config at the bottom is the entire server→client contract.
%>

<link rel="stylesheet" href="<%= asset('/css/unban-bureau.css') %>" />

<% if (!cases.length) { %>
  <main class="pt-14 max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold text-neutral-100 mb-2"><%= t('unbanBureau.title') %></h1>
    <p class="text-neutral-500 text-sm mb-10"><%= channel.channelLogin %> · <%= t('unbanBureau.subtitle') %></p>
    <p class="rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-16 text-center text-neutral-400">
      <%= t('unbanBureau.empty') %>
    </p>
  </main>
<% } else { %>

  <div id="ub-wrapper">

    <%# The applicant, behind the booth glass. Parked off-screen until called. %>
    <div id="ub-character-window">
      <div id="ub-character">
        <img id="ub-char-torso" src="" alt="" />
        <img id="ub-char-avatar" src="" alt="" />
      </div>
    </div>

    <%# The booth artwork, plus the things painted onto it. %>
    <div id="ub-desk">
      <div id="ub-street"></div>
      <div id="ub-window-zone"></div>
      <div id="ub-appeal-zone"></div>
      <div id="ub-experts-zone"></div>
      <div id="ub-rules-zone"></div>
      <%# Covers the sheet painted into the desk artwork while the experts card is off its home,
          so lifting the card leaves an empty pocket instead of a second, immovable sheet. %>
      <div id="ub-experts-slot"></div>
      <%# Same idea for the notebook of channel rules - see ub-rules-slot's CSS. %>
      <div id="ub-rules-slot"></div>

      <div id="ub-loudspeaker" title="<%= t('unbanBureau.callNext') %>"></div>
      <div id="ub-weight">82</div>
      <div id="ub-date">—</div>

      <div id="ub-awp" title="<%= t('unbanBureau.sniperHeading') %>"></div>
      <%# The second weapon. Same interaction as the rifle - arm it, then click the street - so it
          sits next to it on the wall rather than anywhere in the UI layer. %>
      <div id="ub-grenade" title="<%= t('unbanBureau.grenadeHeading') %>"></div>
      <div id="ub-grenade-timer" class="hidden"></div>
      <div id="ub-stamp-toggle"></div>
    </div>

    <div id="ub-ui-layer">
      <div id="ub-shift-stats">
        <span id="ub-stat-total">0 / 0</span> |
        <%= t('unbanBureau.approvedCount') %> <span id="ub-stat-approved">0</span> |
        <%= t('unbanBureau.deniedCount') %> <span id="ub-stat-denied">0</span>
      </div>

      <div id="ub-vote-bar" class="hidden">
        <div id="ub-vote-yea"><span class="ub-vote-label"><%= voteEmotes.approve %></span> <span id="ub-vote-yea-count">0</span></div>
        <div id="ub-vote-nay"><span class="ub-vote-label"><%= voteEmotes.deny %></span> <span id="ub-vote-nay-count">0</span></div>
      </div>

      <a id="ub-exit" class="ub-top-btn" href="/<%= channel.channelLogin %>/settings">&larr; <%= t('channelSettings.backToSettings') %></a>

      <div class="ub-top-buttons">
        <button type="button" id="ub-settings-btn" class="ub-top-btn"><%= t('unbanBureau.settings') %></button>
      </div>

      <%# Slides in from the right; its two buttons stamp the visa. %>
      <div id="ub-stamp-machine">
        <div id="ub-stamp-machine-body">
          <div class="ub-stamp-btn" id="ub-stamp-approve" data-decision="approved"></div>
          <div class="ub-stamp-btn" id="ub-stamp-deny" data-decision="denied"></div>
        </div>
      </div>

      <div id="ub-settings-modal">
        <div class="ub-modal-header"><%= t('unbanBureau.settings') %></div>

        <div class="ub-settings-section">
          <div class="ub-settings-title"><%= t('unbanBureau.pickModeHeading') %></div>
          <div class="ub-settings-row">
            <label class="ub-settings-option"><input type="radio" name="ub-pick-mode" value="shuffle" checked> <%= t('unbanBureau.pickShuffle') %></label>
            <label class="ub-settings-option"><input type="radio" name="ub-pick-mode" value="oldest"> <%= t('unbanBureau.pickOldest') %></label>
            <label class="ub-settings-option"><input type="radio" name="ub-pick-mode" value="newest"> <%= t('unbanBureau.pickNewest') %></label>
          </div>
        </div>

        <div class="ub-settings-section">
          <div class="ub-settings-title"><%= t('unbanBureau.fontsHeading') %></div>
          <div class="ub-settings-row">
            <span><%= t('unbanBureau.fontChat') %></span>
            <div class="ub-controls-group">
              <button type="button" class="ub-font-btn" data-font="chat" data-delta="-1">-</button>
              <span id="ub-font-chat-display">14px</span>
              <button type="button" class="ub-font-btn" data-font="chat" data-delta="1">+</button>
            </div>
          </div>
          <div class="ub-settings-row">
            <span><%= t('unbanBureau.fontAppeal') %></span>
            <div class="ub-controls-group">
              <button type="button" class="ub-font-btn" data-font="appeal" data-delta="-1">-</button>
              <span id="ub-font-appeal-display">30px</span>
              <button type="button" class="ub-font-btn" data-font="appeal" data-delta="1">+</button>
            </div>
          </div>
          <div class="ub-settings-row">
            <span><%= t('unbanBureau.fontVisa') %></span>
            <div class="ub-controls-group">
              <button type="button" class="ub-font-btn" data-font="visa" data-delta="-1">-</button>
              <span id="ub-font-visa-display">13px</span>
              <button type="button" class="ub-font-btn" data-font="visa" data-delta="1">+</button>
            </div>
          </div>
          <div class="ub-settings-row">
            <span><%= t('unbanBureau.fontExperts') %></span>
            <div class="ub-controls-group">
              <button type="button" class="ub-font-btn" data-font="experts" data-delta="-1">-</button>
              <span id="ub-font-experts-display">14px</span>
              <button type="button" class="ub-font-btn" data-font="experts" data-delta="1">+</button>
            </div>
          </div>
          <div class="ub-settings-row">
            <span><%= t('unbanBureau.fontRules') %></span>
            <div class="ub-controls-group">
              <button type="button" class="ub-font-btn" data-font="rules" data-delta="-1">-</button>
              <span id="ub-font-rules-display">13px</span>
              <button type="button" class="ub-font-btn" data-font="rules" data-delta="1">+</button>
            </div>
          </div>
        </div>

        <div class="ub-settings-section">
          <div class="ub-settings-title"><%= t('unbanBureau.soundsHeading') %></div>
          <div class="ub-settings-row"><span><%= t('unbanBureau.volMaster') %></span><input type="range" data-vol="master" min="0" max="1" step="0.05" value="0.5"></div>
          <div class="ub-settings-row"><span><%= t('unbanBureau.volDrag') %></span><input type="range" data-vol="drag" min="0" max="1" step="0.05" value="1"></div>
          <div class="ub-settings-row"><span><%= t('unbanBureau.volStamp') %></span><input type="range" data-vol="stamp" min="0" max="1" step="0.05" value="1"></div>
          <div class="ub-settings-row"><span><%= t('unbanBureau.volPrinter') %></span><input type="range" data-vol="printer" min="0" max="1" step="0.05" value="0.8"></div>
          <div class="ub-settings-row"><span><%= t('unbanBureau.volSpit') %></span><input type="range" data-vol="spit" min="0" max="1" step="0.05" value="1"></div>
          <div class="ub-settings-row"><span><%= t('unbanBureau.volSpeaker') %></span><input type="range" data-vol="speaker" min="0" max="1" step="0.05" value="0.4"></div>
          <div class="ub-settings-row"><span><%= t('unbanBureau.volShoot') %></span><input type="range" data-vol="shoot" min="0" max="1" step="0.05" value="0.6"></div>
        </div>

        <div class="ub-settings-row" style="justify-content:center">
          <button type="button" id="ub-close-settings" class="ub-top-btn"><%= t('unbanBureau.close') %></button>
        </div>
      </div>

      <div id="ub-toast"></div>
    </div>

    <%# The five case documents (everything inside them is filled via textContent by the client),
        plus the manual, which is about the desk rather than about a case. %>
    <div id="ub-papers-layer">

      <%# The manual: what lies on the desk before anybody has been called. The first call sweeps
          it off (hideGuide() in the client), and a reload is the way back to it.
          Static and server-rendered - it is the one paper here whose text the client never
          touches, which is why it can be written in the template instead of built from a
          dictionary like everything else on this page.
          Its pictures are the desk's OWN things, printed: the megaphone is cropped out of the
          artwork at the coordinates #ub-loudspeaker sits on, the rifle and the grenade are the
          wall buttons themselves. See #ub-guide-card in the stylesheet for why they are grey. %>
      <div class="ub-paper ub-draggable" id="ub-guide-card">
        <div id="ub-guide-title"><%= t('unbanBureau.guideTitle') %></div>
        <div id="ub-guide-subtitle"><%= t('unbanBureau.guideSubtitle') %></div>

        <div id="ub-guide-rows">
          <div class="ub-guide-row">
            <div class="ub-guide-pic ub-pic-call"></div>
            <div class="ub-guide-text"><span class="ub-guide-term"><%= t('unbanBureau.guideCallTitle') %></span><%= t('unbanBureau.guideCallText') %></div>
          </div>

          <div class="ub-guide-row">
            <div class="ub-guide-pic ub-pic-papers"></div>
            <div class="ub-guide-text"><span class="ub-guide-term"><%= t('unbanBureau.guidePapersTitle') %></span><%= t('unbanBureau.guidePapersText') %></div>
          </div>

          <div class="ub-guide-row">
            <div class="ub-guide-pic ub-pic-stamp"></div>
            <div class="ub-guide-text"><span class="ub-guide-term"><%= t('unbanBureau.guideStampTitle') %></span><%= t('unbanBureau.guideStampText') %></div>
          </div>

          <div class="ub-guide-row">
            <%# The one picture with nothing in the room behind it - the vote is a bar on the HUD,
                not an object on the wall. Drawn as ink on the page instead. A constant with no
                interpolated data, like the three badge SVGs in the client. %>
            <div class="ub-guide-pic ub-pic-vote">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 4h18v12h-8l-4 4v-4H3V4Z" />
                <path d="M6 10h5M8.5 7.5v5" />
                <path d="M14 10h4" />
              </svg>
            </div>
            <div class="ub-guide-text"><span class="ub-guide-term"><%= t('unbanBureau.guideVoteTitle') %></span><%= t('unbanBureau.guideVoteText') %></div>
          </div>

          <div class="ub-guide-row">
            <div class="ub-guide-pic ub-pic-awp"></div>
            <div class="ub-guide-text"><span class="ub-guide-term"><%= t('unbanBureau.guideSniperTitle') %></span><%= t('unbanBureau.guideSniperText') %></div>
          </div>

          <div class="ub-guide-row">
            <div class="ub-guide-pic ub-pic-grenade"></div>
            <div class="ub-guide-text"><span class="ub-guide-term"><%= t('unbanBureau.guideGrenadeTitle') %></span><%= t('unbanBureau.guideGrenadeText') %></div>
          </div>
        </div>

        <div id="ub-guide-foot"><%= t('unbanBureau.guideFoot') %></div>
      </div>
      <div class="ub-paper ub-draggable" id="ub-user-card">
        <%# Covers the card until Twitch's half of the dossier is on it. The bot is the only side
            that can read it (see ../CLAUDE.md's "Бюро амнистии"), so the site asks and waits ~2s.
            This exists to prevent the alternative, which is worse than a wait: painting the bot's
            own much smaller counts - which a moderator may read and decide on - and then swapping
            them for Twitch's real ones a moment later. Held back by a CSS transition delay, so a
            case whose card is already mirrored never flashes it. %>
        <div id="ub-uc-preparing" aria-hidden="true">
          <div id="ub-uc-preparing-title"><%= t('unbanBureau.preparingTitle') %></div>
          <div class="ub-prep-dots"><span></span><span></span><span></span></div>
          <div id="ub-uc-preparing-note"><%= t('unbanBureau.preparingNote') %></div>
        </div>
        <img id="ub-uc-avatar" src="" alt="" />
        <div id="ub-uc-header">
          <div id="ub-uc-name"></div>
          <div id="ub-uc-created" class="ub-info-row"></div>
          <div id="ub-uc-follow" class="ub-info-row"></div>
          <div id="ub-uc-sub" class="ub-info-row"></div>
          <%# Twitch's risk read. Hidden unless it has something to report - see renderRisk(). %>
          <div id="ub-uc-risk" class="ub-info-row" style="display:none"></div>
        </div>
        <div id="ub-uc-ban-stats">
          <div class="ub-stat-box">
            <div class="ub-stat-label"><%= t('unbanBureau.bannedBy') %></div>
            <div class="ub-stat-value" id="ub-uc-banned-by">—</div>
          </div>
          <div class="ub-stat-box">
            <div class="ub-stat-label"><%= t('unbanBureau.bannedAt') %></div>
            <div class="ub-stat-value" id="ub-uc-banned-at">—</div>
          </div>
          <div class="ub-stat-box">
            <div class="ub-stat-label"><%= t('unbanBureau.bans') %></div>
            <div class="ub-stat-value" id="ub-uc-bans">0</div>
          </div>
          <div class="ub-stat-box">
            <div class="ub-stat-label"><%= t('unbanBureau.timeouts') %></div>
            <div class="ub-stat-value" id="ub-uc-timeouts">0</div>
          </div>
          <div class="ub-stat-box">
            <div class="ub-stat-label"><%= t('unbanBureau.warns') %></div>
            <div class="ub-stat-value" id="ub-uc-warns">0</div>
          </div>
        </div>
        <div id="ub-uc-tabs">
          <div class="ub-tab ub-active" data-ub-tab="log"><%= t('unbanBureau.tabLog') %></div>
          <div class="ub-tab" data-ub-tab="comments"><%= t('unbanBureau.tabComments') %></div>
          <div class="ub-tab" data-ub-tab="actions"><%= t('unbanBureau.tabActions') %></div>
        </div>
        <label id="ub-hide-bots-toggle" style="display:none">
          <input type="checkbox" id="ub-hide-bots" checked>
          <%= t('unbanBureau.hideBots') %>
        </label>
        <div id="ub-log-msg-count"></div>
        <div id="ub-chat-logs"></div>
        <div id="ub-mod-comments" style="display:none"></div>
        <div id="ub-actions" style="display:none"></div>
      </div>

      <div class="ub-paper ub-draggable" id="ub-appeal-card">
        <div id="ub-appeal-text"></div>
        <div id="ub-appeal-date"></div>
      </div>

      <%# The fourth sheet: the prosecutor's and advocate's speeches on this case. Filled either
          by the button below (routes/unbanBureau.js) or by hand through the admin API
          (routes/adminApi.js), and stored web-only - the bot never sees them and a verdict is
          decided identically without them. Every string
          inside is set from Mongo via textContent by renderOpinions(); nothing here is
          server-rendered per case. %>
      <div class="ub-paper ub-draggable" id="ub-experts-card">
        <div id="ub-experts-title"><%= t('unbanBureau.expertsHeading') %></div>
        <div id="ub-experts-body"></div>
        <%# Empty state doubles as the order form: a blank sheet is the only place the hearing can
            be requested from, which is also the server's rule (a case with a sheet answers 409). %>
        <div id="ub-experts-empty">
          <div id="ub-experts-empty-text"><%= t('unbanBureau.expertsEmpty') %></div>
          <button type="button" id="ub-experts-generate"><%= t('unbanBureau.expertsGenerate') %></button>
        </div>
        <%# The bench: what the judge can do about what is on the sheet. Shown only once a hearing
            exists (.ub-has-opinions in the stylesheet) - on a blank sheet the only control is the
            order button above. The textarea and the buttons appear in the drag handler's allow-list
            in the client, or grabbing one of them would drag the whole sheet instead of typing. %>
        <div id="ub-experts-foot">
          <textarea id="ub-judge-input" maxlength="<%= maxRemarkChars %>" placeholder="<%= t('unbanBureau.expertRemarkPlaceholder') %>"></textarea>
          <div id="ub-experts-actions">
            <button type="button" id="ub-judge-send" class="ub-sheet-btn"><%= t('unbanBureau.expertRemarkSend') %></button>
            <button type="button" id="ub-floor-next" class="ub-sheet-btn"><%= t('unbanBureau.expertFloorAdvocate') %></button>
          </div>
        </div>
        <div id="ub-experts-mark"></div>
      </div>

      <%# The notebook: this channel's own posted chat rules (Twitch's chatSettings.rules,
          mirrored by the bot). Channel-wide, not per-case - see db/unbanDossierRepo.js's
          getDossier() and renderRules() in the client. %>
      <div class="ub-paper ub-draggable" id="ub-rules-card">
        <div id="ub-rules-title"><%= t('unbanBureau.rulesHeading') %></div>
        <div id="ub-rules-body"></div>
        <div id="ub-rules-empty"><%= t('unbanBureau.rulesEmpty') %></div>
      </div>

      <div class="ub-paper ub-draggable" id="ub-visa-card">
        <div id="ub-visa-name"></div>
        <textarea id="ub-visa-reason" maxlength="500" placeholder="<%= t('unbanBureau.resolutionPlaceholder') %>"></textarea>
        <%# Only acted on for an "approved" stamp - see submitDecision(). A blank date means
            immediately, the default; picking one asks the bot to hold the actual Twitch unban
            until that date instead of applying it on its next ~60s tick. %>
        <div id="ub-visa-effective">
          <label id="ub-visa-effective-label" for="ub-visa-effective-date"><%= t('unbanBureau.effectiveLabel') %></label>
          <%# Native date inputs render their OWN locale placeholder ("tt.mm.jjjj", "dd/mm/yyyy", ...)
              when empty - there's no attribute that swaps that text for "Немедленно". So the input's
              own text is made transparent while empty (see .ub-date-empty in the stylesheet) and this
              overlay sits on top instead; pointer-events:none lets a click still reach the input
              underneath and open its picker. Toggled by updateEffectiveDatePlaceholder() in the client. %>
          <div id="ub-visa-effective-wrap">
            <input type="date" id="ub-visa-effective-date" class="ub-date-empty" />
            <span id="ub-visa-effective-placeholder"><%= t('unbanBureau.effectiveImmediate') %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%#
    The server→client contract. `cases` are the raw UnbanRequests docs (ObjectId serializes to its
    hex string, which is what the client sends back as `id`). i18n is passed as a dictionary rather
    than rendered into markup because nearly every string here lands in a dynamically built row.
  %>
  <div id="ub-config" class="hidden"
       data-channel="<%= channel.channelLogin %>"
       data-csrf="<%= csrfToken %>"
       data-locale="<%= locale %>"
       data-newest-first="<%= newestFirst ? '1' : '0' %>"
       data-heartbeat-ms="<%= heartbeatMs %>"
       data-max-spoken-turns="<%= maxSpokenTurns %>"
       <%# Identifies this page load at the desk. Echoed back on the heartbeat and the pagehide
           hand-back so a reload's beacon can't delete the lease the NEW page just took. %>
       data-shift-token="<%= shiftToken %>"
       data-cases="<%= JSON.stringify(cases) %>"
       data-emotes="<%= JSON.stringify(emoteList) %>"
       data-i18n="<%= JSON.stringify({
         allDone: t('unbanBureau.allDone'),
         notFollowing: t('unbanBureau.notFollowing'),
         following: t('unbanBureau.following'),
         accountCreated: t('unbanBureau.accountCreated'),
         subUnknown: t('unbanBureau.subUnknown'),
         subNone: t('unbanBureau.subNone'),
         subActive: t('unbanBureau.subActive'),
         subTier: t('unbanBureau.subTier'),
         subPrime: t('unbanBureau.subPrime'),
         subUnavailable: t('unbanBureau.subUnavailable'),
         noAppealText: t('unbanBureau.noAppealText'),
         appealSubmitted: t('unbanBureau.appealSubmitted'),
         logEmpty: t('unbanBureau.logEmpty'),
         messages: t('unbanBureau.messages'),
         needStamp: t('unbanBureau.needStamp'),
         expertProsecutor: t('unbanBureau.expertProsecutor'),
         expertAdvocate: t('unbanBureau.expertAdvocate'),
         expertJudge: t('unbanBureau.expertJudge'),
         expertRewritten: t('unbanBureau.expertRewritten'),
         expertLabelDemand: t('unbanBureau.expertLabelDemand'),
         expertLabelCounter: t('unbanBureau.expertLabelCounter'),
         expertFloorProsecutor: t('unbanBureau.expertFloorProsecutor'),
         expertFloorAdvocate: t('unbanBureau.expertFloorAdvocate'),
         expertFloorWorking: t('unbanBureau.expertFloorWorking'),
         expertFloorClosed: t('unbanBureau.expertFloorClosed'),
         expertTurnFailed: t('unbanBureau.expertTurnFailed'),
         expertRemarkSend: t('unbanBureau.expertRemarkSend'),
         expertRemarkSending: t('unbanBureau.expertRemarkSending'),
         expertRemarkFailed: t('unbanBureau.expertRemarkFailed'),
         expertNoHearing: t('unbanBureau.expertNoHearing'),
         expertsGenerate: t('unbanBureau.expertsGenerate'),
         expertsGenerating: t('unbanBureau.expertsGenerating'),
         expertsGenerated: t('unbanBureau.expertsGenerated'),
         expertsGenerateFailed: t('unbanBureau.expertsGenerateFailed'),
         expertsGenerateUnavailable: t('unbanBureau.expertsGenerateUnavailable'),
         expertsGenerateTooMany: t('unbanBureau.expertsGenerateTooMany'),
         queued: t('unbanBureau.queued'),
         applied: t('unbanBureau.applied'),
         approveScheduled: t('unbanBureau.approveScheduled'),
         decisionFailed: t('unbanBureau.decisionFailed'),
         voteQueued: t('unbanBureau.voteQueued'),
         voteRunning: t('unbanBureau.voteRunning'),
         voteClosed: t('unbanBureau.voteClosed'),
         sniperQueued: t('unbanBureau.sniperQueued'),
         sniperHit: t('unbanBureau.sniperHit'),
         sniperNoTarget: t('unbanBureau.sniperNoTarget'),
         sniperRejected: t('unbanBureau.sniperRejected'),
         // These two, and backToSettings below, are read by the client but were never passed in -
         // arming the rifle toasted `undefined`. Their grenade counterparts are here from the start.
         sniperArmed: t('unbanBureau.sniperArmed'),
         sniperDisarmed: t('unbanBureau.sniperDisarmed'),
         backToSettings: t('channelSettings.backToSettings'),
         grenadeArmed: t('unbanBureau.grenadeArmed'),
         grenadeDisarmed: t('unbanBureau.grenadeDisarmed'),
         grenadeQueued: t('unbanBureau.grenadeQueued'),
         grenadeHit: t('unbanBureau.grenadeHit'),
         grenadeNoTarget: t('unbanBureau.grenadeNoTarget'),
         grenadeRejected: t('unbanBureau.grenadeRejected'),
         grenadeCooldown: t('unbanBureau.grenadeCooldown'),
         failed: t('unbanBureau.failed'),
         alreadyDecided: t('unbanBureau.alreadyDecided'),
         voteAlreadyRunning: t('unbanBureau.voteAlreadyRunning'),
         loadError: t('unbanBureau.loadError'),
         logBanned: t('unbanBureau.logBanned'),
