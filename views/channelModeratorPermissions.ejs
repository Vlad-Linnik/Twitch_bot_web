<%- include('partials/head', { title: channel.channelLogin + ' ' + t('moderatorPermissions.title') }) %>
<%- include('partials/nav') %>

<%#
  One row per moderator, one box per section of lib/moderatorSections.js: ticked = may change it.
  public/js/moderator-permissions.js saves the whole form on every change and sets the boxes from
  the server's answer; without JS the Save button posts it and the page comes back. Every row
  carries a hidden `mod` field - the server only touches rows the form actually rendered.
%>
<main class="pt-14 max-w-4xl mx-auto px-6 py-16">
  <a href="/<%= channel.channelLogin %>/settings" data-transition="backward" class="text-sm text-purple-400 hover:text-purple-300"><%= t('channelSettings.backToSettings') %></a>
  <h1 class="settings-heading text-3xl font-bold text-neutral-100 mt-2 mb-1"><%= t('moderatorPermissions.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('moderatorPermissions.intro') %></p>

  <% if (saved) { %>
    <div class="mb-8 rounded-md border border-green-800 bg-green-950/50 text-green-300 text-sm px-4 py-3">
      <%= t('moderatorPermissions.saved') %>
    </div>
  <% } %>

  <form method="post" action="/<%= channel.channelLogin %>/settings/moderators" data-transition="instant" data-mod-permissions>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="rounded-lg border border-neutral-800 overflow-x-auto" id="moderator-list">
      <table class="w-full text-sm">
        <thead class="bg-neutral-900 text-neutral-400">
          <tr>
            <th class="text-left font-medium px-4 py-2 align-bottom" rowspan="2"><%= t('moderatorPermissions.colModerator') %></th>
            <th class="text-center font-normal text-xs uppercase tracking-wide text-neutral-500 px-2 pt-2" colspan="<%= sections.length %>"><%= t('moderatorPermissions.canChange') %></th>
          </tr>
          <tr>
            <% sections.forEach(function(s) { %>
              <th class="text-center font-medium px-2 pb-2 whitespace-nowrap">
                <span class="cursor-help border-b border-dotted border-neutral-600" title="<%= t(s.hintKey) %>"><%= t(s.labelKey) %></span>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-800">
          <% moderators.forEach(function(m) { %>
            <tr class="odd:bg-neutral-950 even:bg-neutral-900/40" data-mod-row="<%= m.userId %>">
              <td class="px-4 py-2 text-neutral-200 whitespace-nowrap">
                <input type="hidden" name="mod" value="<%= m.userId %>" />
                <%= m.userName %>
              </td>
              <% sections.forEach(function(s) { %>
                <td class="px-2 py-2 text-center">
                  <label class="inline-flex items-center justify-center p-1 cursor-pointer" title="<%= t(s.hintKey) %>">
                    <input type="checkbox"
                           class="w-4 h-4 accent-purple-600 cursor-pointer"
                           name="allow.<%= m.userId %>.<%= s.key %>"
                           data-section="<%= s.key %>"
                           aria-label="<%= m.userName %>: <%= t(s.labelKey) %>"
                           aria-description="<%= t(s.hintKey) %>"
                           <%= m.allowed[s.key] ? 'checked' : '' %> />
                  </label>
                </td>
              <% }) %>
            </tr>
          <% }) %>
          <% if (moderators.length === 0) { %>
            <tr><td colspan="<%= sections.length + 1 %>" class="px-4 py-6 text-center text-neutral-500"><%= t('moderatorPermissions.empty') %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (moderators.length > 0) { %>
      <%- include('partials/autosaveStatus') %>
    <% } %>
  </form>
</main>

<script src="<%= asset('/js/moderator-permissions.js') %>" defer></script>
<%- include('partials/foot') %>
