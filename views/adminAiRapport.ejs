<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.ai.tabRapport') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-5xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('admin.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('admin.subtitle') %></p>

  <%- include('partials/adminTabs', { tab }) %>
  <%- include('partials/aiTabs', { aiTab }) %>

  <% if (editError) { %>
    <p class="mb-4 text-sm text-red-400"><%= t('admin.ai.factEditError.' + editError) %></p>
  <% } %>

  <p class="text-neutral-500 text-sm mb-2"><%= t('admin.ai.rapportPageHint') %></p>
  <% if (!config.rapportEnabled) { %>
    <p class="mb-6 text-sm text-amber-500"><%= t('admin.ai.rapportOff') %></p>
  <% } else { %>
    <p class="text-neutral-600 text-xs mb-6"><%= t('admin.ai.rapportScaleHint') %></p>
  <% } %>

  <div class="flex flex-wrap items-end gap-3 mb-6">
    <form method="get" action="/admin/ai/rapport">
      <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.colChannel') %></label>
      <select name="channel" onchange="this.form.submit()"
              class="rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500">
        <% channels.forEach(function (c) { %>
          <option value="<%= c.channelLogin %>" <%= selected === c.channelLogin ? 'selected' : '' %>><%= c.channelLogin %></option>
        <% }); %>
      </select>
    </form>
    <% if (selected && rows.length) { %>
      <form method="post" action="/admin/ai/rapport/clear">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="channel" value="<%= selected %>" />
        <button type="submit" class="px-3 py-2 rounded-md border border-neutral-800 text-neutral-400 hover:text-neutral-200 text-sm transition-colors"><%= t('admin.ai.rapportClear') %></button>
      </form>
    <% } %>
  </div>

  <%# Выставить отношение можно и тому, чьей строки ещё нет: она заводится только на том, кто дожил
      до платного вызова, а «этому поменьше терпения» решают заранее. Ник разрешается через
      UserIdentities — незнакомого бот ни разу не видел, и писать не на кого. %>
  <% if (selected) { %>
    <form method="post" action="/admin/ai/rapport/set" class="mb-8 flex flex-wrap items-end gap-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="channel" value="<%= selected %>" />
      <div class="w-48">
        <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.addFactLogin') %></label>
        <input type="text" name="login" required
               placeholder="<%= t('admin.ai.addFactLoginPlaceholder') %>"
               class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
      </div>
      <div class="w-32">
        <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.colScore') %></label>
        <input type="number" name="score" required value="0" min="<%= minScore %>" max="<%= maxScore %>" step="1"
               class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
      </div>
      <button type="submit" class="px-4 py-2 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium transition-colors">
        <%= t('admin.ai.save') %>
      </button>
    </form>
  <% } %>

  <%# Общий пул значит здесь не то же, что на странице памяти: по нему счёт засевается ОДИН раз,
      когда человек впервые заговорил на этом канале, а дальше строка живёт своей жизнью. Иначе
      непонятно, откуда у новичка минус — на это отвечает колонка «кем выставлено». %>
  <% if (memoryShare) { %>
    <p class="mb-4 rounded-md border border-neutral-800 bg-neutral-900/40 px-4 py-3 text-sm text-neutral-400">
      <%= t('admin.ai.rapportSeedNotice') %>
    </p>
  <% } %>

  <% if (!channelAiEnabled) { %>
    <p class="mb-4 text-sm text-amber-500"><%= t('admin.ai.memoryChannelAiOff') %></p>
  <% } %>

  <% if (!rows.length) { %>
    <p class="text-neutral-500 text-sm"><%= t('admin.ai.rapportEmpty') %></p>
  <% } else { %>
    <div class="overflow-x-auto rounded-lg border border-neutral-800">
      <table class="w-full text-sm">
        <thead class="bg-neutral-900/60 text-neutral-500 text-xs">
          <tr>
            <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colViewer') %></th>
            <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colScore') %></th>
            <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colNextPunishment') %></th>
            <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colFactSource') %></th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-800">
          <% rows.forEach(function (r) { %>
            <tr>
              <td class="px-4 py-2 align-middle">
                <span class="text-neutral-200"><%= r.login || r.userId %></span>
                <% if (r.friend) { %>
                  <span class="ml-2 text-xs text-purple-400"><%= t('admin.ai.rapportFriend') %></span>
                <% } %>
              </td>
              <td class="px-4 py-2 align-middle">
                <form method="post" action="/admin/ai/rapport/set" class="flex items-center gap-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="channel" value="<%= selected %>" />
                  <input type="hidden" name="userId" value="<%= r.userId %>" />
                  <input type="hidden" name="login" value="<%= r.login || '' %>" />
                  <input type="number" name="score" value="<%= r.score %>" min="<%= minScore %>" max="<%= maxScore %>" step="1"
                         class="w-16 rounded-md bg-neutral-900 border border-neutral-800 px-2 py-1 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
                  <button type="submit" class="text-xs text-purple-400 hover:text-purple-300"><%= t('admin.ai.factSave') %></button>
                  <span class="text-xs text-neutral-500"><%= r.label %></span>
                </form>
              </td>
              <td class="px-4 py-2 align-middle text-neutral-400">
                <% if (r.action === 'warn') { %>
                  <%= t('admin.ai.rapportNextWarn') %>
                <% } else { %>
                  <%= t('admin.ai.rapportNextTimeout') %> <%= Math.round(r.willBeSeconds / 60) %> <%= t('admin.ai.minutesShort') %>
                <% } %>
                <%# На дне нарушением считается уже сам минус от модели, а не её вердикт - строка
                    отвечает на «что будет дальше» иначе всех прочих, и это надо сказать. %>
                <% if (r.hostile) { %>
                  <span class="block text-xs text-amber-500 mt-0.5"><%= t('admin.ai.rapportHostile') %></span>
                <% } %>
              </td>
              <td class="px-4 py-2 align-middle text-xs text-neutral-500">
                <%= r.source === 'admin' ? t('admin.ai.factSourceAdmin') : t('admin.ai.factSourceAi') %>
                <% if (r.seededFrom) { %> · <%= t('admin.ai.rapportSeededFrom') %> <%= r.seededFrom %><% } %>
              </td>
              <td class="px-4 py-2 align-middle text-right">
                <form method="post" action="/admin/ai/rapport/forget">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="channel" value="<%= selected %>" />
                  <input type="hidden" name="userId" value="<%= r.userId %>" />
                  <input type="hidden" name="login" value="<%= r.login || '' %>" />
                  <button type="submit" class="text-xs text-neutral-500 hover:text-red-400"><%= t('admin.ai.rapportForget') %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('partials/foot') %>
