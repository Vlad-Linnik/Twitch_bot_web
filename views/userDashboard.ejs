<%
  // A hidden profile shows the ordinary stub even when a theme exists - privacy outranks
  // decoration, and the route has already skipped every query the hero would need.
  const throne = theme.enabled && !profileHidden;
%>
<%- include('partials/head', {
      title: identity.currentUserName + ' · ' + channel.channelLogin,
      bodyClass: throne ? 'theme-throne' : ''
    }) %>
<%- include('partials/nav') %>
<%# The curtain has to be the first thing in the body after the nav: it covers the page while
    it plays, and a later position would let the page paint above it for a frame. %>
<% if (throne && theme.intro) { %><%- include('partials/throneIntro') %><% } %>

<%
  // Data handed to the client as JSON rather than re-fetched on load: the server already paid for
  // these queries to render the page, so making the browser ask again would double the cost of
  // every page view on a 2GB box. Period switches DO re-fetch (stats.json) - only the initial
  // state is inlined. Privacy-hidden data arrives here as null (the route skips the query) -
  // hiding only the markup while inlining the numbers would hide nothing.
  const bootstrap = {
    channel: channel.channelLogin,
    username: identity.currentUserName,
    period,
    locale,
    maxHeatmapDays,
    activity,
    heatmap,
    clouds,
    mentions,
    canModerate,
    // Only used by the panel-toggle buttons below, which only exist in the DOM when isOwner -
    // harmless to inline for every viewer (every logged-in page already has this same value in
    // res.locals.csrfToken; it isn't scoped to this user's data).
    csrfToken,
  };
%>

<main class="pt-14 max-w-5xl mx-auto px-6 py-12">

  <!-- Header: avatar, name, nickname-history dropdown. user-header pinned via
       view-transition-name (public/css/input.css) so a Top Chatters row or search hit
       (data-vt-name="user-header", public/js/page-transitions.js) morphs into it on arrival -
       same technique as stats-header (see that partial). The throne theme swaps this whole
       block for its own hero, which carries the same .user-header class so the morph survives
       the swap - the row unfolds into the hall instead of into a name and an avatar. -->
  <% if (throne) { %>
    <%- include('partials/throneHero', { theme, identity, profile, trophies, nicknames, t, locale }) %>
  <% } else { %>
  <header class="user-header flex items-start gap-4 mb-10">
    <% if (profile && profile.avatarUrl) { %>
      <img src="<%= profile.avatarUrl %>" alt="" width="72" height="72"
           class="w-18 h-18 rounded-full border border-neutral-800 shrink-0" style="width:72px;height:72px" />
    <% } else { %>
      <%# No cached avatar (Twitch lookup failed or the user is gone) - a monogram beats a broken image. %>
      <div class="rounded-full border border-neutral-800 bg-neutral-900 shrink-0 grid place-items-center text-2xl font-semibold text-neutral-500"
           style="width:72px;height:72px">
        <%= identity.currentUserName.charAt(0).toUpperCase() %>
      </div>
    <% } %>

    <div class="min-w-0">
      <div class="flex items-center gap-1.5">
        <%# One class attribute, colour applied as an optional style - emitting a second `class`
            in an else-branch would be invalid HTML and silently drop the styling. %>
        <h1 class="text-3xl font-bold truncate text-neutral-100"
            <% if (profile && profile.color) { %>style="color: <%= profile.color %>"<% } %>>
          <%= identity.currentUserName %>
        </h1>

        <% if (nicknames.length > 0) { %>
          <%# <details> gives a keyboard-accessible, JS-free disclosure. Names only, no dates, per spec. %>
          <details class="relative" id="nickname-history">
            <summary class="list-none cursor-pointer p-1 rounded text-neutral-500 hover:text-neutral-200 transition-colors"
                     aria-label="<%= t('userDashboard.nicknameHistory') %>">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M5.5 7.5L10 12l4.5-4.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="absolute left-0 top-full mt-1 z-20 w-56 rounded-lg border border-neutral-800 bg-neutral-900 shadow-lg shadow-black/40 py-2">
              <p class="px-3 pb-1.5 text-neutral-500 text-xs uppercase tracking-wide"><%= t('userDashboard.nicknameHistory') %></p>
              <ul class="max-h-64 overflow-y-auto">
                <% nicknames.forEach(function(name) { %>
                  <li class="px-3 py-1 text-sm text-neutral-300 truncate"><%= name %></li>
                <% }) %>
              </ul>
            </div>
          </details>
        <% } %>
      </div>

      <% if (!profileHidden) { %>
        <p class="text-sm text-neutral-500 mt-1">
          <% if (standing.rank) { %>
            <%= t('userDashboard.rank') %> #<%= standing.rank.toLocaleString() %>
            <span class="text-neutral-700">/</span> <%= standing.totalChatters.toLocaleString() %>
            <span class="text-neutral-700">·</span>
            <%= standing.totalMessages.toLocaleString() %> <%= t('userDashboard.messages') %>
          <% } else { %>
            <%= t('userDashboard.noMessages') %>
          <% } %>
        </p>
      <% } %>
    </div>
  </header>
  <% } %>

  <% if (profileHidden) { %>
    <section class="mb-10">
      <div class="rounded-lg border border-neutral-800 bg-neutral-900 px-6 py-12 text-center">
        <p class="text-lg font-semibold text-neutral-300 mb-1"><%= t('userDashboard.profileHiddenTitle') %></p>
        <p class="text-sm text-neutral-500"><%= t('userDashboard.profileHiddenBody') %></p>
        <%# Only the profile's owner learns WHERE to undo this - everyone else just sees the stub. %>
        <% if (isOwner) { %>
          <p class="text-sm text-neutral-500 mt-4">
            <a href="/settings" class="text-purple-400 hover:text-purple-300 underline decoration-dotted transition-colors"><%= t('userDashboard.profileHiddenOwnerHint') %></a>
          </p>
        <% } %>
      </div>
    </section>
  <% } else { %>

  <!-- Message count over time (visual !countmsg). Bootstrap data is null and the query never
       ran when the profile owner keeps hideMessageVolume on (see routes/userDashboard.js) - for
       any OTHER viewer the whole section is then omitted too. The owner still gets the header
       row (with the panel-toggle button) rendered UNHIDDEN even when the panel itself is off -
       only the inner [data-panel-body] collapses. The toggle must never hide itself along with
       the content it controls, or there'd be no way to bring the panel back. -->
  <% if (activity || isOwner) { %>
  <section class="mb-10" data-component="activity">
    <div class="flex items-center justify-between mb-3 gap-4">
      <h2 class="text-lg font-semibold text-neutral-100"><%= panelLabel('activity', t('userDashboard.messageVolume')) %></h2>
      <div class="flex items-center gap-2">
        <%- include('partials/periodToggle', { periods, period, component: 'activity' }) %>
        <% if (isOwner) { %><%- include('partials/panelToggle', { panel: 'activity', hiddenState: !activity, t }) %><% } %>
      </div>
    </div>
    <div data-panel-body <% if (!activity) { %>hidden<% } %>>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900 p-4">
        <%# Axis labels are HTML, not SVG <text>: the svg stretches (preserveAspectRatio="none"),
            which would distort glyphs. The Y gutter is a justify-between column matching the svg's
            height; the X row sits under the plot, inset by the gutter width. Both filled by JS. %>
        <div class="flex items-stretch gap-2">
          <div id="activity-yaxis" class="w-10 shrink-0 flex flex-col justify-between items-end text-[10px] leading-none text-neutral-500 tabular-nums py-0.5"></div>
          <svg id="activity-chart" class="flex-1 min-w-0 h-48" viewBox="0 0 800 200" preserveAspectRatio="none" role="img"
               aria-label="<%= t('userDashboard.messageVolume') %>"></svg>
        </div>
        <div id="activity-xaxis" class="flex justify-between text-[10px] leading-none text-neutral-500 tabular-nums mt-1.5 ml-12"></div>
        <p class="text-xs text-neutral-600 mt-2" data-empty hidden><%= t('userDashboard.noData') %></p>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Word + emote clouds - one panel, one hideWordCloud flag covers both columns. The grid
       moved from being the <section> itself to a [data-panel-body] inside it, so the section-
       level heading + toggle (added specifically for this) survives being hidden. -->
  <% if (clouds || isOwner) { %>
  <section class="mb-10" data-component="clouds">
    <div class="flex items-center justify-between mb-3 gap-4">
      <h2 class="text-lg font-semibold text-neutral-100"><%= panelLabel('clouds', t('userDashboard.clouds')) %></h2>
      <% if (isOwner) { %><%- include('partials/panelToggle', { panel: 'clouds', hiddenState: !clouds, t }) %><% } %>
    </div>
    <div data-panel-body class="grid grid-cols-1 md:grid-cols-2 gap-6" <% if (!clouds) { %>hidden<% } %>>
      <div>
        <div class="flex items-center justify-between mb-3 gap-4">
          <h3 class="text-sm font-medium text-neutral-300"><%= t('userDashboard.wordCloud') %></h3>
          <%- include('partials/periodToggle', { periods, period, component: 'clouds' }) %>
        </div>
        <%# relative + no padding: cloud-layout.js positions children absolutely (padding is baked
            into its own PAD constant) and grows the height past min-h as the cloud fills in. %>
        <div id="word-cloud" class="relative overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900 min-h-40"></div>
        <p id="cloud-sampled" class="text-xs text-amber-600/80 mt-2" hidden><%= t('userDashboard.sampled') %></p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-neutral-300 mb-3"><%= t('userDashboard.emoteCloud') %></h3>
        <div id="emote-cloud" class="relative overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900 min-h-40"></div>
        <p class="text-xs text-neutral-600 mt-2" id="emote-empty" hidden><%= t('userDashboard.noTrackedEmotes') %></p>
      </div>
    </div>
  </section>
  <% } %>

  <!-- @mentions - null (and the section omitted for non-owners) when hideMentions is on, same
       shell-when-owner rule as the sections above. -->
  <% if (mentions || isOwner) { %>
  <section class="mb-10" data-component="mentions">
    <div class="flex items-center justify-between mb-3 gap-4">
      <h2 class="text-lg font-semibold text-neutral-100"><%= panelLabel('mentions', t('userDashboard.mentions')) %></h2>
      <div class="flex items-center gap-2">
        <%- include('partials/periodToggle', { periods, period, component: 'mentions' }) %>
        <% if (isOwner) { %><%- include('partials/panelToggle', { panel: 'mentions', hiddenState: !mentions, t }) %><% } %>
      </div>
    </div>
    <div data-panel-body <% if (!mentions) { %>hidden<% } %>>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900 p-4 flex items-center gap-6">
        <div class="shrink-0">
          <%# Follows the period toggle (the repo scopes `total` to the selected range). Hidden
              panels never fetched a total - the client fills this in once the owner shows it. %>
          <p class="text-3xl font-semibold text-neutral-100 tabular-nums" id="mention-total"><%= mentions ? mentions.total.toLocaleString(locale) : '—' %></p>
          <p class="text-xs text-neutral-500 uppercase tracking-wide"><%= t('userDashboard.mentionsTotal') %></p>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-stretch gap-2">
            <div id="mention-yaxis" class="w-8 shrink-0 flex flex-col justify-between items-end text-[10px] leading-none text-neutral-500 tabular-nums py-0.5"></div>
            <svg id="mention-spark" class="flex-1 min-w-0 h-24" viewBox="0 0 400 96" preserveAspectRatio="none" aria-hidden="true"></svg>
          </div>
          <div id="mention-xaxis" class="flex justify-between text-[10px] leading-none text-neutral-500 tabular-nums mt-1.5 ml-10"></div>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Activity heatmap (GitHub-style, capped at MAX_HEATMAP_DAYS). Bootstrap data is null and
       the query never ran when the profile owner keeps hideChatActivity on - same
       shell-when-owner rule as the sections above. -->
  <% if (heatmap || isOwner) { %>
  <section class="mb-10" data-component="heatmap">
    <div class="flex items-center justify-between mb-3 gap-4">
      <h2 class="text-lg font-semibold text-neutral-100"><%= panelLabel('heatmap', t('userDashboard.heatmap')) %></h2>
      <% if (isOwner) { %><%- include('partials/panelToggle', { panel: 'heatmap', hiddenState: !heatmap, t }) %><% } %>
    </div>
    <div data-panel-body <% if (!heatmap) { %>hidden<% } %>>
      <%# w-fit + mx-auto: the card hugs the calendar and centers instead of stretching to the
          section width; max-w-full + overflow keep it scrollable on narrow screens. %>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900 p-5 w-fit max-w-full mx-auto overflow-x-auto">
        <svg id="heatmap" role="img" aria-label="<%= t('userDashboard.heatmap') %>"></svg>
        <div class="flex items-center gap-4 mt-3 text-xs text-neutral-600">
          <span><%= t('userDashboard.heatmapCap') %></span>
          <span class="flex items-center gap-1 ml-auto">
            <%= t('userDashboard.heatmapLess') %>
            <%# Same ramp renderHeatmap uses (user-dashboard.js `shade()`) - keep in sync. %>
            <% ['#171717', '#3b1d52', '#5b2a80', '#7e3ab8', '#a855f7'].forEach(function(color) { %>
              <span class="inline-block w-2.5 h-2.5 rounded-[2px]" style="background:<%= color %>"></span>
            <% }) %>
            <%= t('userDashboard.heatmapMore') %>
          </span>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Moderator-only: this user's chat logs, with live keyword search -->
  <% if (canModerate) { %>
    <section class="mb-10" id="mod-logs">
      <div class="flex items-center justify-between mb-3 gap-4">
        <h2 class="text-lg font-semibold text-neutral-100">
          <%= panelLabel('modLogs', t('userDashboard.modLogs')) %>
          <span class="ml-2 align-middle text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-purple-600/20 text-purple-400 border border-purple-600/30"><%= t('userDashboard.modOnly') %></span>
        </h2>
        <%- include('partials/periodToggle', { periods, period, component: 'logs' }) %>
      </div>

      <div class="rounded-lg border border-neutral-800 bg-neutral-900">
        <div class="p-3 border-b border-neutral-800 flex items-center gap-3">
          <input type="search" id="log-search" autocomplete="off"
                 placeholder="<%= t('userDashboard.searchPlaceholder') %>"
                 class="flex-1 bg-neutral-950 border border-neutral-800 rounded-md px-3 py-1.5 text-sm text-neutral-200 placeholder:text-neutral-600 focus:outline-none focus:border-purple-600" />
          <label class="flex items-center gap-1.5 text-xs text-neutral-500 shrink-0 cursor-pointer">
            <input type="checkbox" id="log-fuzzy" class="accent-purple-600" />
            <%= t('userDashboard.fuzzy') %>
          </label>
        </div>
        <p id="log-status" class="px-3 py-2 text-xs text-neutral-600 border-b border-neutral-800"></p>
        <ul id="log-results" class="divide-y divide-neutral-900 max-h-96 overflow-y-auto text-sm"></ul>
      </div>
    </section>
  <% } %>

  <% } /* end !profileHidden */ %>

</main>

<% if (!profileHidden) { %>
  <%# NOT JSON.stringify() - this payload carries chat-derived strings (cloud words, nickname
      history, raw message bodies), so it must be escaped against a "</script>" breakout.
      See lib/safeJson.js. The hidden stub inlines no data and loads no dashboard scripts. %>
  <% if (throne && theme.intro) { %>
    <script src="<%= asset('/js/throne-intro.js') %>" defer></script>
  <% } %>
  <script id="dashboard-data" type="application/json"><%- safeJson(bootstrap) %></script>
  <script src="<%= asset('/js/cloud-layout.js') %>" defer></script>
  <script src="<%= asset('/js/user-dashboard.js') %>" defer></script>
<% } %>

<%- include('partials/foot') %>
