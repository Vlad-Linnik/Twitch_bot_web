<%- include('partials/head', { title: channel.channelLogin + ' ' + t('news.titleSuffix') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-2xl mx-auto px-6 py-12">

  <%- include('partials/channelHeader', { channel, broadcaster, channelNav }) %>

  <% if (newsDisabledPreview) { %>
    <div class="mb-8 rounded-md border border-amber-800/60 bg-amber-950/40 text-amber-300 text-sm px-4 py-3">
      <%= t('news.previewNotice') %>
    </div>
  <% } %>

  <% if (canCreate) { %>
    <div class="flex justify-end mb-6">
      <a href="/<%= channel.channelLogin %>/news/new"
         class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-purple-700 hover:bg-purple-600 text-white text-sm font-medium transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
        </svg>
        <%= t('news.create') %>
      </a>
    </div>
  <% } %>

  <% if (posts.length === 0) { %>
    <p class="text-center text-neutral-500 text-sm py-16"><%= t('news.empty') %></p>
  <% } else { %>
    <%# data-src is list.json without a cursor; public/js/infinite-list.js takes each next
        cursor from the "show more" link below, so the link stays the single source of where
        the feed continues - with or without JS. data-restore is set only on the top of the
        feed (see routes/news.js's isFeedTop). %>
    <div id="news-feed" data-infinite-list
         data-src="/<%= channel.channelLogin %>/news/list.json"
         <% if (isFeedTop) { %>data-restore="news:<%= channel.channelLogin %>"<% } %>>
      <%- include('partials/newsCards', { posts, channel }) %>
    </div>
  <% } %>

  <% if (nextCursor) { %>
    <div class="flex justify-center mt-2">
      <a href="?cursor=<%= encodeURIComponent(nextCursor) %>" data-infinite-more="news-feed" data-transition="instant"
         data-retry-label="<%= t('news.loadFailed') %>" data-loading-label="<%= t('news.loading') %>"
         class="px-4 py-2 rounded-md border border-neutral-800 text-sm text-neutral-300 hover:border-purple-600 hover:text-neutral-100 transition-colors">
        <%= t('news.loadMore') %>
      </a>
    </div>
  <% } %>
</main>

<script src="<%= asset('/js/reactions.js') %>" defer></script>
<script src="<%= asset('/js/infinite-list.js') %>" defer></script>

<%- include('partials/foot') %>
