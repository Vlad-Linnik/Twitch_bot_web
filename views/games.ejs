<%- include('partials/head', { title: t('games.title') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-3xl mx-auto px-6 py-12">
  <div class="mb-8 flex items-center justify-between gap-4 flex-wrap">
    <h1 class="text-3xl font-bold text-neutral-100"><%= t('games.title') %></h1>
    <%# Entry point to the cross-game spectator hub - drops the viewer into a
        random live match and auto-advances. Login-gated (spectating needs a
        session), so it renders as a login link for logged-out visitors. %>
    <% if (typeof user !== "undefined" && user) { %>
      <a href="/games/watch"
         class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium transition-colors shrink-0">
        <span aria-hidden="true">👁</span> <%= t('games.watch.watchButton') %>
      </a>
    <% } else { %>
      <a href="/auth/login"
         class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-200 text-sm font-medium transition-colors shrink-0">
        <span aria-hidden="true">👁</span> <%= t('games.watch.watchButton') %>
      </a>
    <% } %>
  </div>

  <%
    // Category names are per-locale (db/gameCatalogRepo.js's `names` map) -
    // fall back to English, then whatever locale is present, so a category
    // never renders blank if it's missing a translation.
    function categoryName(category) {
      if (!category || !category.names) return '';
      return category.names[locale] || category.names.en || Object.values(category.names).find(Boolean) || '';
    }
  %>
  <% groups.forEach(function(group, i) { %>
    <div class="<%= i === 0 ? '' : 'mt-10' %>">
      <% if (group.category) { %>
        <h2 class="text-xl font-semibold text-neutral-200 mb-4"><%= categoryName(group.category) %></h2>
      <% } %>
      <div class="grid gap-4 sm:grid-cols-2">
        <% group.games.forEach(function(game) { %>
          <%- include('partials/gameCard', { game }) %>
        <% }) %>
      </div>
    </div>
  <% }) %>
</main>

<%- include('partials/foot') %>
