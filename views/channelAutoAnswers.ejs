<%- include('partials/head', { title: channel.channelLogin + ' ' + t('autoAnswers.title') }) %>
<%- include('partials/nav') %>

<%
  // Render a message with the matched words highlighted, using the spans the matcher produced.
  // Done here rather than client-side because a chat message is attacker-controlled text on a
  // page a moderator is logged into - EJS's escaping interpolation tag is the whole defence,
  // and building this with innerHTML in the browser would throw it away.
  // (Do not write a literal EJS tag in this comment: the lexer is not JS-aware and would read
  // it as a real tag, which is exactly how this file failed to compile the first time.)
  function segments(text, spans) {
    const out = [];
    let cursor = 0;
    for (const s of (spans || []).slice().sort((a, b) => a.start - b.start)) {
      if (s.start < cursor) continue;
      if (s.start > cursor) out.push({ text: text.slice(cursor, s.start), hit: false });
      out.push({ text: text.slice(s.start, s.end), hit: true, required: s.required, how: s.how });
      cursor = s.end;
    }
    if (cursor < text.length) out.push({ text: text.slice(cursor), hit: false });
    return out;
  }
  const modeStyle = {
    off:  'border-neutral-700 text-neutral-400',
    test: 'border-amber-700 text-amber-300',
    live: 'border-green-700 text-green-300',
  };
%>

<main class="pt-14 max-w-5xl mx-auto px-6 py-16">
  <a href="/<%= channel.channelLogin %>/settings" data-transition="backward" class="text-sm text-purple-400 hover:text-purple-300"><%= t('channelSettings.backToSettings') %></a>
  <h1 class="settings-heading text-3xl font-bold text-neutral-100 mt-2 mb-1"><%= t('autoAnswers.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('autoAnswers.intro') %></p>

  <% if (saved) { %>
    <div class="mb-6 rounded-md border border-green-800 bg-green-950/50 text-green-300 text-sm px-4 py-3"><%= t('channelSettings.saved') %></div>
  <% } %>
  <% if (error) { %>
    <div class="mb-6 rounded-md border border-red-800 bg-red-950/50 text-red-300 text-sm px-4 py-3"><%= t('autoAnswers.error.' + error) %></div>
  <% } %>

  <!-- ================= список тем ================= -->
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-neutral-200"><%= t('autoAnswers.topics') %></h2>
    <% if (!creating && !editing) { %>
      <a href="?new=1" data-transition="instant" class="px-4 py-2 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium transition-colors">+ <%= t('autoAnswers.newTopic') %></a>
    <% } %>
  </div>

  <% if (!topics.length) { %>
    <p class="text-neutral-600 text-sm mb-10"><%= t('autoAnswers.empty') %></p>
  <% } %>

  <div class="space-y-3 mb-12">
    <% topics.forEach(function (topic) { %>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 px-4 py-3">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-neutral-100 font-medium"><%= topic.title %></span>
              <span class="text-[11px] px-2 py-0.5 rounded border <%= modeStyle[topic.mode] || modeStyle.off %>"><%= t('autoAnswers.mode.' + topic.mode) %></span>
              <% if (topic.hits) { %>
                <span class="text-[11px] text-neutral-500 tabular-nums" title="<%= t('autoAnswers.hitsHint') %>"><%= topic.hits.total %> / <%= topic.hits.sent %> <%= t('autoAnswers.sentShort') %></span>
              <% } %>
            </div>
            <div class="mt-1.5 flex items-center gap-1.5 flex-wrap">
              <% (topic.requiredWords || []).forEach(function (w) { %>
                <span class="text-[11px] px-1.5 py-0.5 rounded bg-amber-900/40 text-amber-200 border border-amber-800/60"><%= w %></span>
              <% }) %>
              <% (topic.optionalWords || []).slice(0, 6).forEach(function (w) { %>
                <span class="text-[11px] px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400"><%= w %></span>
              <% }) %>
            </div>
            <p class="text-neutral-500 text-xs mt-2 truncate"><%= topic.answer %></p>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <form method="post" action="/<%= channel.channelLogin %>/auto-answers" data-transition="instant">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="action" value="mode" />
              <input type="hidden" name="id" value="<%= topic.id %>" />
              <select name="mode" onchange="this.form.submit()" class="rounded-md bg-neutral-900 border border-neutral-800 px-2 py-1 text-xs text-neutral-200 focus:outline-none focus:border-purple-500">
                <% ['off','test','live'].forEach(function (m) { %>
                  <option value="<%= m %>" <%= topic.mode === m ? 'selected' : '' %>><%= t('autoAnswers.mode.' + m) %></option>
                <% }) %>
              </select>
            </form>
            <a href="?edit=<%= topic.id %>" data-transition="instant" class="px-3 py-1.5 rounded-md border border-neutral-700 text-neutral-300 hover:border-neutral-500 text-xs"><%= t('autoAnswers.edit') %></a>
            <form method="post" action="/<%= channel.channelLogin %>/auto-answers" data-transition="instant"
                  onsubmit="return confirm('<%= t('autoAnswers.confirmDelete') %>')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value="<%= topic.id %>" />
              <button type="submit" class="px-3 py-1.5 rounded-md border border-red-900/70 text-red-400 hover:border-red-700 text-xs"><%= t('autoAnswers.delete') %></button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- ================= редактор темы ================= -->
  <% if (creating || editing) { %>
    <form method="post" action="/<%= channel.channelLogin %>/auto-answers" data-transition="instant"
          id="aa-form" data-channel="<%= channel.channelLogin %>"
          class="rounded-lg border border-neutral-800 bg-neutral-900/40 p-5 mb-12 space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <% if (editing) { %><input type="hidden" name="id" value="<%= editing.id %>" /><% } %>

      <h2 class="text-lg font-semibold text-neutral-200"><%= editing ? t('autoAnswers.editTopic') : t('autoAnswers.newTopic') %></h2>

      <div>
        <label class="block text-sm text-neutral-300 mb-1"><%= t('autoAnswers.field.title') %></label>
        <input name="title" maxlength="<%= limits.MAX_TITLE %>" required value="<%= editing ? editing.title : '' %>"
               class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
      </div>

      <div>
        <label class="block text-sm text-neutral-300 mb-1"><%= t('autoAnswers.field.answer') %></label>
        <p class="text-neutral-600 text-xs mb-1.5"><%= t('autoAnswers.field.answerHint') %></p>
        <textarea name="answer" rows="2" maxlength="<%= limits.MAX_ANSWER %>" required
                  class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500"><%= editing ? editing.answer : '' %></textarea>
      </div>

      <div>
        <label class="block text-sm text-neutral-300 mb-1"><%= t('autoAnswers.field.examples') %></label>
        <p class="text-neutral-600 text-xs mb-1.5"><%= t('autoAnswers.field.examplesHint') %></p>
        <textarea name="examples" rows="5" id="aa-examples"
                  class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 font-mono focus:outline-none focus:border-purple-500"><%= editing ? (editing.examples || []).join('\n') : '' %></textarea>
        <button type="button" id="aa-derive" class="mt-2 px-3 py-1.5 rounded-md border border-purple-700 text-purple-300 hover:border-purple-500 text-xs"><%= t('autoAnswers.deriveButton') %></button>
        <span id="aa-derive-note" class="ml-2 text-xs text-neutral-500"></span>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-neutral-300 mb-1"><%= t('autoAnswers.field.required') %></label>
          <p class="text-neutral-600 text-xs mb-1.5"><%= t('autoAnswers.field.requiredHint') %></p>
          <input name="requiredWords" id="aa-required" required value="<%= editing ? (editing.requiredWords || []).join(', ') : '' %>"
                 class="w-full rounded-md bg-neutral-900 border border-amber-900/60 px-3 py-2 text-sm text-amber-200 focus:outline-none focus:border-amber-600" />
        </div>
        <div>
          <label class="block text-sm text-neutral-300 mb-1"><%= t('autoAnswers.field.optional') %></label>
          <p class="text-neutral-600 text-xs mb-1.5"><%= t('autoAnswers.field.optionalHint') %></p>
          <input name="optionalWords" id="aa-optional" value="<%= editing ? (editing.optionalWords || []).join(', ') : '' %>"
                 class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-300 focus:outline-none focus:border-purple-500" />
        </div>
        <div>
          <label class="block text-sm text-neutral-300 mb-1"><%= t('autoAnswers.field.exclude') %></label>
          <p class="text-neutral-600 text-xs mb-1.5"><%= t('autoAnswers.field.excludeHint') %></p>
          <input name="excludeWords" value="<%= editing ? (editing.excludeWords || []).join(', ') : '' %>"
                 class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-300 focus:outline-none focus:border-purple-500" />
        </div>
        <div>
          <label class="block text-sm text-neutral-300 mb-1"><%= t('autoAnswers.field.notQuestion') %></label>
          <p class="text-neutral-600 text-xs mb-1.5"><%= t('autoAnswers.field.notQuestionHint') %></p>
          <input name="notQuestionWords" value="<%= editing ? (editing.notQuestionWords || []).join(', ') : '' %>"
                 class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-300 focus:outline-none focus:border-purple-500" />
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        <label class="flex items-center gap-2 text-sm text-neutral-300">
          <input type="checkbox" name="requireQuestion" <%= (!editing || editing.requireQuestion !== false) ? 'checked' : '' %>
                 class="rounded border-neutral-700 bg-neutral-900 text-purple-600 focus:ring-purple-500" />
          <%= t('autoAnswers.field.requireQuestion') %>
        </label>
        <label class="flex items-center gap-2 text-sm text-neutral-300">
          <%= t('autoAnswers.field.cooldown') %>
          <input type="number" name="cooldownSeconds" min="<%= limits.MIN_COOLDOWN_SECONDS %>" max="<%= limits.MAX_COOLDOWN_SECONDS %>"
                 value="<%= editing ? (editing.cooldownSeconds || limits.DEFAULT_COOLDOWN_SECONDS) : limits.DEFAULT_COOLDOWN_SECONDS %>"
                 class="w-24 rounded-md bg-neutral-900 border border-neutral-800 px-2 py-1 text-sm text-neutral-200 tabular-nums focus:outline-none focus:border-purple-500" />
        </label>
        <label class="flex items-center gap-2 text-sm text-neutral-300">
          <%= t('autoAnswers.field.mode') %>
          <select name="mode" class="rounded-md bg-neutral-900 border border-neutral-800 px-2 py-1 text-sm text-neutral-200 focus:outline-none focus:border-purple-500">
            <% ['off','test','live'].forEach(function (m) { %>
              <option value="<%= m %>" <%= (editing ? editing.mode : 'test') === m ? 'selected' : '' %>><%= t('autoAnswers.mode.' + m) %></option>
            <% }) %>
          </select>
        </label>
      </div>

      <div>
        <label class="block text-sm text-neutral-300 mb-1"><%= t('autoAnswers.field.antiExamples') %></label>
        <p class="text-neutral-600 text-xs mb-1.5"><%= t('autoAnswers.field.antiExamplesHint') %></p>
        <textarea name="antiExamples" rows="3" id="aa-anti"
                  class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-400 font-mono focus:outline-none focus:border-purple-500"><%= editing ? (editing.antiExamples || []).join('\n') : '' %></textarea>
        <button type="button" id="aa-exclusions" class="mt-2 px-3 py-1.5 rounded-md border border-red-800 text-red-300 hover:border-red-600 text-xs"><%= t('autoAnswers.excludeButton') %></button>
        <span id="aa-exclusions-note" class="ml-2 text-xs text-neutral-500"></span>
      </div>

      <div class="flex items-center gap-3 pt-1">
        <button type="submit" class="px-4 py-2 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium"><%= t('autoAnswers.save') %></button>
        <button type="button" id="aa-replay" class="px-4 py-2 rounded-md border border-neutral-700 text-neutral-300 hover:border-neutral-500 text-sm"><%= t('autoAnswers.replayButton') %></button>
        <a href="/<%= channel.channelLogin %>/auto-answers" data-transition="instant" class="text-sm text-neutral-500 hover:text-neutral-300"><%= t('autoAnswers.cancel') %></a>
      </div>

      <div id="aa-replay-out" class="hidden rounded-md border border-neutral-800 bg-neutral-950/60 p-4 text-sm"></div>
    </form>
  <% } %>

  <!-- ================= журнал срабатываний ================= -->
  <h2 class="text-lg font-semibold text-neutral-200 mb-1"><%= t('autoAnswers.feed') %></h2>
  <p class="text-neutral-600 text-sm mb-4"><%= t('autoAnswers.feedHint') %></p>

  <% if (!hits.length) { %>
    <p class="text-neutral-600 text-sm"><%= t('autoAnswers.feedEmpty') %></p>
  <% } %>

  <div class="space-y-2" id="aa-feed" data-channel="<%= channel.channelLogin %>" data-csrf="<%= csrfToken %>">
    <% hits.forEach(function (hit) { %>
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/40 px-4 py-3 <%= hit.review === 'false_positive' ? 'opacity-50' : '' %>" data-hit="<%= hit.id %>">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="text-xs text-neutral-500 mb-1">
              <span class="tabular-nums"><%= new Date(hit.createdAt).toLocaleString(locale === 'ru' ? 'ru-RU' : 'en-GB') %></span>
              · <span class="text-neutral-400"><%= hit.userName %></span>
              · <span class="text-purple-400"><%= hit.topicTitle %></span>
              <% if (hit.sent) { %>
                <span class="ml-1 text-green-500"><%= t('autoAnswers.wasSent') %></span>
              <% } else { %>
                <span class="ml-1 text-amber-500"><%= t('autoAnswers.notSent.' + (hit.skipReason || 'test_mode')) %></span>
              <% } %>
            </div>
            <p class="text-sm text-neutral-200 break-words">
              <% segments(hit.message, hit.spans).forEach(function (seg) { %><% if (seg.hit) { %><mark class="<%= seg.required ? 'bg-amber-500/30 text-amber-100' : 'bg-cyan-500/20 text-cyan-100' %> rounded px-0.5" title="<%= seg.how %>"><%= seg.text %></mark><% } else { %><%= seg.text %><% } %><% }) %>
            </p>
          </div>
          <button type="button" class="aa-reject shrink-0 px-3 py-1.5 rounded-md border border-neutral-700 text-neutral-400 hover:border-red-700 hover:text-red-400 text-xs"
                  data-id="<%= hit.id %>" <%= hit.review === 'false_positive' ? 'disabled' : '' %>>
            <%= hit.review === 'false_positive' ? t('autoAnswers.rejected') : t('autoAnswers.reject') %>
          </button>
        </div>
      </div>
    <% }) %>
  </div>
</main>

<script src="<%= asset('/js/auto-answers.js') %>" defer></script>
<%- include('partials/foot') %>
