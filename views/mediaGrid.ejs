<%- include('partials/head', { title: channel.channelLogin + ' · ' + st('titleSuffix') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-5xl mx-auto px-6 py-12 media-theme-<%= sec.theme %>">

  <%- include('partials/channelHeader', { channel, broadcaster, channelNav }) %>

  <% if (sectionPreview) { %>
    <div class="mb-8 rounded-md border border-amber-800/60 bg-amber-950/40 text-amber-300 text-sm px-4 py-3">
      <%= st('previewNotice') %>
    </div>
  <% } %>

  <%# The section's own controls: amber pills on warm black, not the news feed's purple and
      underlined tabs. The colours and shapes come from the section's theme (the media-theme-* classes
      in public/css/input.css): gold on warm black for films, cyan on cold slate for games. %>
  <div class="flex flex-wrap items-center gap-3 mb-5">
    <%# Switching tabs slides the page like the channel navbar does: towards the tab picked
        (data-transition backward/forward - all tabs share one path, so without an explicit type
        views/partials/head.ejs would read it as a same-page reload). The bar itself is pinned and
        its highlight slides between tabs (.media-tabs / .media-tabs-pill in public/css/input.css). %>
    <% const activeTabIndex = tabs.findIndex(function(t) { return t.key === view.tab; }); %>
    <nav class="media-tabs inline-flex gap-1 p-1 rounded-full bg-(--sec-surface) ring-1 ring-white/5" aria-label="<%= st('tabsLabel') %>">
      <% tabs.forEach(function(tab, i) { %>
        <a href="<%= tab.href %>" data-media-tab data-transition="<%= i < activeTabIndex ? 'backward' : 'forward' %>"<% if (tab.key === view.tab) { %> aria-current="page"<% } %>
           class="relative px-3.5 py-1.5 rounded-full text-sm font-semibold transition-colors <%= tab.key === view.tab ? 'text-stone-950' : 'text-stone-400 hover:text-(--sec-accent-soft)' %>">
          <% if (tab.key === view.tab) { %><span class="media-tabs-pill absolute inset-0 rounded-full bg-(--sec-accent)" aria-hidden="true"></span><% } %>
          <span class="relative"><%= st('tab.' + tab.key) %> <span class="text-xs tabular-nums <%= tab.key === view.tab ? 'text-stone-800' : 'text-stone-600' %>"><%= tab.count %></span></span>
        </a>
      <% }) %>
    </nav>
    <% if (view.tab === 'suggestions' && suggest) { %>
      <%# Suggesting is a viewer action, so it sits on the suggestions tab only - and says why it is
          not offered rather than just hiding the button. %>
      <% if (suggest.allowed) { %>
        <a href="/<%= channel.channelLogin %>/<%= sec.path %>/suggest"
           class="<%= canEdit ? '' : 'ml-auto ' %>inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-500 text-stone-950 hover:bg-emerald-400 text-sm font-semibold transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" /></svg>
          <%= st('suggest.button') %>
        </a>
      <% } else if (suggest.reason === 'login') { %>
        <a href="/auth/login?returnTo=<%= encodeURIComponent(currentUrl) %>" class="text-sm text-emerald-300 hover:text-emerald-200"><%= st('suggest.loginToSuggest') %></a>
      <% } else { %>
        <span class="text-xs text-stone-500"><%= st('suggest.chatOnly') %></span>
      <% } %>
    <% } %>
    <% if (canEdit) { %>
      <a href="/<%= channel.channelLogin %>/<%= sec.path %>/new"
         class="ml-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-(--sec-accent)/60 text-(--sec-accent-strong) hover:bg-(--sec-accent) hover:text-stone-950 text-sm font-semibold transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" /></svg>
        <%= st('create') %>
      </a>
    <% } %>
  </div>

  <%# A plain GET form: sort, filters and search work without JS (Enter submits; the button is in
      <noscript>), and the URL is shareable. With JS public/js/media-grid.js answers every keystroke
      and change itself: it fetches list.json for the new view and animates the grid into it. %>
  <form method="get" action="/<%= channel.channelLogin %>/<%= sec.path %>" data-transition="instant" data-media-filter
        class="flex flex-col gap-3 mb-8" role="search">
    <% if (view.tab !== 'done') { %><input type="hidden" name="tab" value="<%= view.tab %>" /><% } %>
    <% if (mediaTypes.length) { %>
      <fieldset class="flex flex-wrap gap-1.5">
        <legend class="sr-only"><%= st('filterTypeLabel') %></legend>
        <% [''].concat(mediaTypes).forEach(function(mt) { %>
          <label class="cursor-pointer">
            <input type="radio" name="type" value="<%= mt %>" class="peer sr-only"<%= mt === view.type ? ' checked' : '' %> />
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold ring-1 transition-colors ring-stone-700 text-stone-400 hover:text-(--sec-accent-soft) hover:ring-(--sec-accent)/50
                         peer-checked:bg-(--sec-accent)/15 peer-checked:text-(--sec-accent-strong) peer-checked:ring-(--sec-accent)/70
                         peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-(--sec-accent)">
              <%= mt ? st('filterType.' + mt) : st('filterTypeAll') %>
            </span>
          </label>
        <% }) %>
      </fieldset>
    <% } %>
    <div class="flex flex-wrap items-center gap-2">
      <div class="relative flex-1 min-w-[12rem]">
        <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.45 4.39l3.08 3.08a.75.75 0 11-1.06 1.06l-3.08-3.08A7 7 0 012 9z" clip-rule="evenodd"/></svg>
        <input type="search" name="q" value="<%= view.q %>" maxlength="100" placeholder="<%= st('searchPlaceholder') %>" autocomplete="off"
               aria-label="<%= st('searchPlaceholder') %>"
               class="w-full rounded-full bg-(--sec-surface) border border-stone-700 text-sm text-stone-100 placeholder:text-stone-500 pl-10 pr-4 py-1.5 focus:outline-none focus:border-(--sec-accent)" />
      </div>
      <% if (genres.length) { %>
        <label class="flex items-center">
          <span class="sr-only"><%= st('filterGenreLabel') %></span>
          <select name="genre"
                  class="max-w-[12rem] rounded-full bg-(--sec-surface) border border-stone-700 text-sm text-stone-100 px-3 py-1.5 focus:outline-none focus:border-(--sec-accent)">
            <option value=""><%= st('filterGenreAll') %></option>
            <% genres.forEach(function(g) { %>
              <option value="<%= g %>"<%= g === view.genre ? ' selected' : '' %>><%= g %></option>
            <% }) %>
          </select>
        </label>
      <% } %>
      <label class="flex items-center gap-2 text-sm text-neutral-400">
        <span class="sr-only sm:not-sr-only"><%= st('sortLabel') %></span>
        <select name="sort"
                class="rounded-full bg-(--sec-surface) border border-stone-700 text-sm text-stone-100 px-3 py-1.5 focus:outline-none focus:border-(--sec-accent)">
          <% sorts.forEach(function(s) { %>
            <option value="<%= s %>"<%= s === view.sort ? ' selected' : '' %>><%= st('sort.' + s) %></option>
          <% }) %>
        </select>
      </label>
      <noscript><button type="submit" class="px-4 py-1.5 rounded-full bg-stone-800 text-stone-200 hover:bg-stone-700 text-sm"><%= st('searchSubmit') %></button></noscript>
    </div>
  </form>

  <%# Always present, even empty: the live filter swaps cards in and out of it. %>
  <p data-media-empty data-empty-search="<%= st('emptySearch') %>" data-empty-tab="<%= st('empty.' + view.tab) %>"
     class="text-center text-stone-500 text-sm py-16"<%= cards.length ? ' hidden' : '' %>>
    <%= (view.q || view.type || view.genre) ? st('emptySearch') : st('empty.' + view.tab) %>
  </p>
  <%# Same contract as the news feed (public/js/infinite-list.js): data-src without a cursor, the
      next cursor lives in the "show more" link below. %>
  <div id="media-grid" data-infinite-list data-src="<%= listSrc %>"
       <% if (restoreKey) { %>data-restore="<%= restoreKey %>"<% } %>
       class="relative grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-6">
    <%- include('partials/mediaCards', { cards, channel, section: sec.path, csrf }) %>
  </div>

  <%# The "show more" link, rendered when there is a next portion. infinite-list.js removes it at the
      end of the list; the live filter re-creates it from the template when a new view has more. %>
  <template data-media-more-template>
    <div data-media-more class="flex justify-center mt-8">
      <a href="" data-infinite-more="media-grid" data-transition="instant"
         data-retry-label="<%= t('news.loadFailed') %>" data-loading-label="<%= t('news.loading') %>"
         class="px-5 py-2 rounded-full border border-(--sec-accent)/40 text-sm text-(--sec-accent-soft) hover:bg-(--sec-accent) hover:text-stone-950 transition-colors">
        <%= t('news.loadMore') %>
      </a>
    </div>
  </template>
  <% if (nextHref) { %>
    <div data-media-more class="flex justify-center mt-8">
      <a href="<%= nextHref %>" data-infinite-more="media-grid" data-transition="instant"
         data-retry-label="<%= t('news.loadFailed') %>" data-loading-label="<%= t('news.loading') %>"
         class="px-5 py-2 rounded-full border border-(--sec-accent)/40 text-sm text-(--sec-accent-soft) hover:bg-(--sec-accent) hover:text-stone-950 transition-colors">
        <%= t('news.loadMore') %>
      </a>
    </div>
  <% } %>

  <%- include('partials/mediaAttribution', { which: sec.attribution }) %>
</main>

<script src="<%= asset('/js/infinite-list.js') %>" defer></script>
<script src="<%= asset('/js/media-grid.js') %>" defer></script>
<script src="<%= asset('/js/suggestion-vote.js') %>" defer></script>

<%- include('partials/foot') %>
