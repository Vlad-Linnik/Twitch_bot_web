<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.ai.tabFilter') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-5xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('admin.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('admin.subtitle') %></p>

  <%- include('partials/adminTabs', { tab }) %>
  <%- include('partials/aiTabs', { aiTab }) %>

  <p class="text-neutral-500 text-sm mb-6"><%= t('admin.ai.filterHint') %></p>

  <% if (editError) { %>
    <p class="mb-4 text-sm text-red-400"><%= t('admin.ai.filterEditError.' + editError) %></p>
  <% } %>

  <%# Заготовки теперь по каналам: пишет их модель, и в общей таблице придуманный ею ответ
      выдавался бы во всех чатах бота сразу. %>
  <form method="get" action="/admin/ai/filter" class="mb-6">
    <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.colChannel') %></label>
    <select name="channel" onchange="this.form.submit()"
            class="rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500">
      <% channels.forEach(function (c) { %>
        <option value="<%= c.channelLogin %>" <%= selected === c.channelLogin ? 'selected' : '' %>><%= c.channelLogin %></option>
      <% }); %>
    </select>
  </form>

  <form method="post" action="/admin/ai/filter" class="mb-8 rounded-lg border border-neutral-800 bg-neutral-900/40 px-4 py-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="channel" value="<%= selected %>" />
    <div class="grid sm:grid-cols-2 gap-3 mb-3">
      <div>
        <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.colText') %></label>
        <input type="text" name="text" required maxlength="300"
               class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
      </div>
      <div>
        <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.colAnswer') %></label>
        <input type="text" name="answer" required maxlength="500"
               class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
      </div>
    </div>
    <button type="submit" class="px-3 py-1.5 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-xs font-medium transition-colors"><%= t('admin.ai.add') %></button>
  </form>

  <% if (!entries.length) { %>
    <p class="text-neutral-600 text-sm"><%= t('admin.ai.filterEmpty') %></p>
  <% } else { %>
    <div class="rounded-lg border border-neutral-800 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-neutral-900 text-neutral-400">
            <tr>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colText') %></th>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colAnswer') %></th>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colHits') %></th>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colSource') %></th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800">
            <% entries.forEach(function (e, i) { %>
              <tr class="odd:bg-neutral-950 even:bg-neutral-900/40 align-top">
                <%# Строка правится на месте: заготовку пишет модель, и чаще всего от неё нужен не
                    снос, а исправленный ответ. Поля стоят каждое в своей колонке, а сама форма
                    лежит в последней ячейке и связана с ними атрибутом form - растянуть <form> на
                    несколько <td> нельзя. На соседней странице памяти правится одно поле, поэтому
                    там форма целиком помещается в одну ячейку и этот приём не нужен. %>
                <td class="px-4 py-2 align-middle">
                  <input type="text" form="filter-edit-<%= i %>" name="newText" value="<%= e.text %>" required maxlength="300"
                         class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-2 py-1 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
                </td>
                <td class="px-4 py-2 align-middle">
                  <input type="text" form="filter-edit-<%= i %>" name="answer" value="<%= e.answer %>" required maxlength="500"
                         class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-2 py-1 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
                </td>
                <td class="px-4 py-2 text-neutral-400 tabular-nums align-middle"><%= e.hits || 0 %></td>
                <td class="px-4 py-2 text-neutral-500 align-middle"><%= t('admin.ai.source.' + (e.source || 'admin')) %></td>
                <td class="px-4 py-2 align-middle">
                  <div class="flex items-center justify-end gap-4">
                    <form method="post" action="/admin/ai/filter/edit" id="filter-edit-<%= i %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="channel" value="<%= selected %>" />
                      <input type="hidden" name="text" value="<%= e.text %>" />
                      <button type="submit" class="text-purple-400 hover:text-purple-300 text-xs whitespace-nowrap"><%= t('admin.ai.save') %></button>
                    </form>
                    <form method="post" action="/admin/ai/filter/delete">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="channel" value="<%= selected %>" />
                      <input type="hidden" name="text" value="<%= e.text %>" />
                      <button type="submit" class="text-red-400 hover:text-red-300 text-xs"><%= t('admin.ai.delete') %></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/foot') %>
