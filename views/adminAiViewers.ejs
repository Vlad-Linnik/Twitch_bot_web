<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.ai.tabViewers') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-5xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('admin.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('admin.subtitle') %></p>

  <%- include('partials/adminTabs', { tab }) %>
  <%- include('partials/aiTabs', { aiTab }) %>

  <% if (editError) { %>
    <p class="mb-4 text-sm text-red-400"><%= t('admin.ai.factEditError.' + editError) %></p>
  <% } %>

  <p class="text-neutral-500 text-sm mb-2"><%= t('admin.ai.viewersPageHint') %></p>
  <% if (!config.userMemoryEnabled) { %>
    <p class="mb-6 text-sm text-amber-500"><%= t('admin.ai.viewerMemoryWritesOff') %></p>
  <% } else { %>
    <p class="text-neutral-600 text-xs mb-6"><%= t('admin.ai.viewerMemoryCountHint') %> <%= config.userMemoryMax %>.</p>
  <% } %>

  <div class="flex flex-wrap items-end gap-3 mb-6">
    <form method="get" action="/admin/ai/viewers">
      <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.colChannel') %></label>
      <select name="channel" onchange="this.form.submit()"
              class="rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500">
        <% channels.forEach(function (c) { %>
          <option value="<%= c.channelLogin %>" <%= selected === c.channelLogin ? 'selected' : '' %>><%= c.channelLogin %></option>
        <% }); %>
      </select>
    </form>
    <% if (selected && groups.length) { %>
      <form method="post" action="/admin/ai/viewers/clear">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="channel" value="<%= selected %>" />
        <button type="submit" class="px-3 py-2 rounded-md border border-neutral-800 text-neutral-400 hover:text-neutral-200 text-sm transition-colors"><%= t('admin.ai.clearViewerMemory') %></button>
      </form>
    <% } %>
  </div>

  <%# Добавление руками требует ника: строка живёт под user-id, а его сайт узнаёт по нику из
      UserIdentities. Незнакомого бот ни разу не видел — записывать факт не на кого. %>
  <% if (selected) { %>
    <form method="post" action="/admin/ai/viewers" class="mb-8 flex flex-wrap items-end gap-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="channel" value="<%= selected %>" />
      <div class="w-48">
        <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.addFactLogin') %></label>
        <input type="text" name="login" required
               placeholder="<%= t('admin.ai.addFactLoginPlaceholder') %>"
               class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
      </div>
      <div class="flex-1 min-w-64">
        <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.addFact') %></label>
        <input type="text" name="fact" maxlength="<%= maxFactLen %>" required
               placeholder="<%= t('admin.ai.addViewerFactPlaceholder') %>"
               class="w-full rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
      </div>
      <button type="submit" class="px-4 py-2 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium transition-colors">
        <%= t('admin.ai.addFactButton') %>
      </button>
    </form>
  <% } %>

  <% if (!groups.length) { %>
    <% if (!channelAiEnabled) { %>
      <p class="text-sm text-amber-500"><%= t('admin.ai.memoryChannelAiOff') %></p>
    <% } else { %>
      <p class="text-neutral-600 text-sm"><%= t('admin.ai.viewerMemoryEmpty') %></p>
    <% } %>
  <% } else { %>
    <%# Сгруппировано по адресату, потому что разбирают тут человека, а не отдельную строку:
        вопрос звучит как «что бот вообще насобирал про этого зрителя». %>
    <div class="space-y-4">
      <% groups.forEach(function (g) { %>
        <section class="rounded-lg border border-neutral-800 overflow-hidden">
          <header class="flex items-center justify-between gap-4 bg-neutral-900 px-4 py-3">
            <div class="min-w-0">
              <a href="/<%= selected %>/user/<%= g.login %>" class="text-neutral-100 text-sm font-medium hover:text-purple-300"><%= g.login || g.userId %></a>
              <span class="text-neutral-600 text-xs ml-2"><%= g.facts.length %></span>
            </div>
            <form method="post" action="/admin/ai/viewers/clear-user">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="channel" value="<%= selected %>" />
              <input type="hidden" name="userId" value="<%= g.userId %>" />
              <button type="submit" class="text-neutral-500 hover:text-red-300 text-xs whitespace-nowrap"><%= t('admin.ai.clearViewerFacts') %></button>
            </form>
          </header>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-neutral-900/60 text-neutral-500">
                <tr>
                  <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colFact') %></th>
                  <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colFactSource') %></th>
                  <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colLearnedFrom') %></th>
                  <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colTime') %></th>
                  <th class="px-3 py-2"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-800">
                <% g.facts.forEach(function (e) { %>
                  <tr class="odd:bg-neutral-950 even:bg-neutral-900/40 align-top">
                    <td class="px-3 py-2 text-neutral-200 max-w-md">
                      <form method="post" action="/admin/ai/viewers/edit" class="flex gap-2 items-start">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="channel" value="<%= selected %>" />
                        <input type="hidden" name="userId" value="<%= e.userId %>" />
                        <input type="hidden" name="key" value="<%= e.key %>" />
                        <input type="text" name="fact" value="<%= e.fact %>" maxlength="<%= maxFactLen %>"
                               class="flex-1 rounded-md bg-neutral-900 border border-neutral-800 px-2 py-1 text-sm text-neutral-200 focus:outline-none focus:border-purple-500" />
                        <button type="submit" class="text-purple-400 hover:text-purple-300 text-xs whitespace-nowrap mt-1"><%= t('admin.ai.factSave') %></button>
                      </form>
                    </td>
                    <td class="px-3 py-2 whitespace-nowrap">
                      <% if (e.source === 'admin') { %>
                        <span class="text-purple-400 text-xs"><%= t('admin.ai.factSourceAdmin') %></span>
                      <% } else { %>
                        <span class="text-neutral-500 text-xs"><%= t('admin.ai.factRole.' + (e.authorRole || 'viewer')) %></span>
                      <% } %>
                    </td>
                    <%# Адресат и автор — разные люди: про зрителя мог рассказать кто угодно из чата.
                        Без этой колонки спорную строку разобрать нечем. %>
                    <td class="px-3 py-2 text-neutral-500 max-w-xs">
                      <% if (e.authorLogin) { %>
                        <span class="<%= e.authorLogin.toLowerCase() === (e.login || '').toLowerCase() ? 'text-neutral-600' : 'text-amber-500' %>"><%= e.authorLogin %></span>
                        <% if (e.sourceMessage) { %>
                          <p class="text-neutral-600 text-xs mt-0.5"><%= e.sourceMessage %></p>
                        <% } %>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                    <td class="px-3 py-2 text-neutral-500 whitespace-nowrap tabular-nums">
                      <%= new Date(e.createdAt).toLocaleDateString(locale) %>
                    </td>
                    <td class="px-3 py-2 text-right">
                      <form method="post" action="/admin/ai/viewers/delete">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="channel" value="<%= selected %>" />
                        <input type="hidden" name="userId" value="<%= e.userId %>" />
                        <input type="hidden" name="key" value="<%= e.key %>" />
                        <button type="submit" class="text-red-400 hover:text-red-300 text-xs"><%= t('admin.ai.delete') %></button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </section>
      <% }); %>
    </div>
  <% } %>
</main>

<%- include('partials/foot') %>
