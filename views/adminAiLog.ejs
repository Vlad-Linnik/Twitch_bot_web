<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.ai.tabLog') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-6xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('admin.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('admin.subtitle') %></p>

  <%- include('partials/adminTabs', { tab }) %>
  <%- include('partials/aiTabs', { aiTab }) %>

  <p class="text-neutral-500 text-sm mb-1">
    <%= t('admin.ai.logHint') %>
    <span class="text-neutral-300"><%= today.requests %></span> · $<span class="text-neutral-300"><%= (today.costUsd || 0).toFixed(3) %></span>
  </p>
  <%# Разбивка по токенам нужна, чтобы цифру расхода можно было проверить: вход в ответе API —
      это только некэшированный остаток, а префикс с правилами приезжает отдельными полями и по другой цене. %>
  <p class="text-neutral-600 text-xs mb-6 tabular-nums">
    <%= t('admin.ai.tokensIn') %> <%= (today.inputTokens || 0).toLocaleString(locale) %> ·
    <%= t('admin.ai.tokensOut') %> <%= (today.outputTokens || 0).toLocaleString(locale) %> ·
    <%= t('admin.ai.tokensCacheRead') %> <%= (today.cacheReadTokens || 0).toLocaleString(locale) %> ·
    <%= t('admin.ai.tokensCacheWrite') %> <%= (today.cacheWriteTokens || 0).toLocaleString(locale) %>
  </p>

  <form method="get" action="/admin/ai/log" class="mb-6">
    <select name="channel" onchange="this.form.submit()"
            class="rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500">
      <option value=""><%= t('admin.ai.allChannels') %></option>
      <% channels.forEach(function (c) { %>
        <option value="#<%= c.channelLogin %>" <%= selected === '#' + c.channelLogin ? 'selected' : '' %>><%= c.channelLogin %></option>
      <% }); %>
    </select>
  </form>

  <% if (!rows.length) { %>
    <p class="text-neutral-600 text-sm"><%= t('admin.ai.logEmpty') %></p>
  <% } else { %>
    <div class="rounded-lg border border-neutral-800 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-neutral-900 text-neutral-400">
            <tr>
              <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colTime') %></th>
              <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colChannel') %></th>
              <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colUser') %></th>
              <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colQuestion') %></th>
              <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colReply') %></th>
              <th class="text-left font-medium px-3 py-2"><%= t('admin.ai.colSource') %></th>
              <th class="text-right font-medium px-3 py-2"><%= t('admin.ai.colCost') %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800">
            <% rows.forEach(function (r) { %>
              <tr class="odd:bg-neutral-950 even:bg-neutral-900/40 align-top">
                <td class="px-3 py-2 text-neutral-500 whitespace-nowrap tabular-nums"><%= new Date(r.createdAt).toLocaleString(locale) %></td>
                <td class="px-3 py-2 text-neutral-500"><%= r.channel %></td>
                <td class="px-3 py-2 text-neutral-300"><%= r.login %></td>
                <td class="px-3 py-2 text-neutral-400 max-w-xs"><%= r.question %></td>
                <td class="px-3 py-2 text-neutral-200 max-w-md">
                  <%= r.answer %>
                  <% if (r.sent === false) { %>
                    <span class="ml-1 text-xs text-amber-500"><%= t('admin.ai.notSent') %></span>
                  <% } %>
                  <%# What this call did to the channel memory. Shown here rather than only on the
                      memory page so a fact can be traced back to the exchange that produced it. %>
                  <% if (r.similarTo) { %>
                    <p class="text-xs text-sky-400 mt-1"><%= t('admin.ai.similarTo') %>: <%= r.similarTo %></p>
                  <% } %>
                  <%# Правка кэша самой моделью. Стоит вплотную к similarTo не случайно: вместе они
                      говорят, КАКУЮ заготовку она тронула, а порознь не говорят - стёртой строки в
                      кэше уже нет, а переписанная выглядит там как обычная. %>
                  <% if (r.cacheFix === 'delete' || r.cacheFix === 'replace') { %>
                    <p class="text-xs text-orange-400 mt-1"><%= t('admin.ai.cacheFix.' + r.cacheFix) %></p>
                  <% } %>
                  <% if (r.remembered) { %>
                    <p class="text-xs text-purple-400 mt-1"><%= t('admin.ai.memoryAdded') %>: <%= r.remembered %></p>
                  <% } %>
                  <% if (r.forgot) { %>
                    <p class="text-xs text-neutral-500 mt-1"><%= t('admin.ai.memoryForgot') %>: <%= r.forgot %></p>
                  <% } %>
                  <%# Шкала отношения: чем была, чем стала, и во что вылился вердикт. Без этих строк
                      по журналу нельзя решить, стоит ли переводить режим в боевой, - не видно, кому
                      досталось бы предупреждение, а кому мут и на сколько. Строки, записанные до
                      появления полей, не показывают ничего: у них ответа на этот вопрос нет. %>
                  <% if (typeof r.rapportAfter === 'number' && r.rapportAfter !== r.rapportBefore) { %>
                    <p class="text-xs mt-1 <%= r.rapportAfter > r.rapportBefore ? 'text-emerald-500' : 'text-amber-500' %>">
                      <%= t('admin.ai.logRapport') %>: <%= r.rapportBefore %> &rarr; <%= r.rapportAfter %>
                    </p>
                  <% } %>
                  <% if (r.punishAction === 'warn') { %>
                    <p class="text-xs text-amber-500 mt-1"><%= t('admin.ai.logPunishWarn') %></p>
                  <% } else if (r.punishAction === 'timeout' && r.timeoutSeconds) { %>
                    <p class="text-xs text-red-400 mt-1"><%= t('admin.ai.logPunishTimeout') %> <%= Math.round(r.timeoutSeconds / 60) %> <%= t('admin.ai.minutesShort') %></p>
                  <% } %>
                </td>
                <td class="px-3 py-2 text-neutral-500 whitespace-nowrap">
                  <%= t('admin.ai.sourceKind.' + (r.source || 'model')) %>
                  <%# Что стало с ответом дальше: лёг ли он в кэш канала, и если нет - кто решил.
                      Без этой строки «вечный» ответ модели и отклонённый нами выглядят одинаково,
                      а «почему кэш не растёт» выясняется только чтением кода. Строки, записанные
                      до появления поля, не показывают ничего - у них ответа на этот вопрос нет. %>
                  <% if (typeof r.cached === 'boolean') { %>
                    <p class="text-xs mt-1 <%= r.cached ? 'text-emerald-500' : 'text-neutral-600' %>">
                      <%= t('admin.ai.cacheFate.' + (r.cached ? 'stored' : r.cacheable === 'eternal' ? 'volatile' : 'temporary')) %>
                    </p>
                  <% } %>
                </td>
                <td class="px-3 py-2 text-right text-neutral-500 tabular-nums whitespace-nowrap">
                  <%= r.costUsd != null ? '$' + r.costUsd.toFixed(4) : '—' %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/foot') %>
