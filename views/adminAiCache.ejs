<%- include('partials/head', { title: t('admin.title') + ' · ' + t('admin.ai.tabCache') }) %>
<%- include('partials/nav') %>

<main class="pt-14 max-w-5xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-neutral-100 mb-1"><%= t('admin.title') %></h1>
  <p class="text-neutral-500 text-sm mb-8"><%= t('admin.subtitle') %></p>

  <%- include('partials/adminTabs', { tab }) %>
  <%- include('partials/aiTabs', { aiTab }) %>

  <p class="text-neutral-500 text-sm mb-6"><%= t('admin.ai.cacheHint') %></p>

  <div class="flex flex-wrap items-end gap-3 mb-6">
    <form method="get" action="/admin/ai/cache">
      <label class="block text-xs text-neutral-500 mb-1"><%= t('admin.ai.colChannel') %></label>
      <select name="channel" onchange="this.form.submit()"
              class="rounded-md bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-purple-500">
        <% channels.forEach(function (c) { %>
          <option value="<%= c.channelLogin %>" <%= selected === c.channelLogin ? 'selected' : '' %>><%= c.channelLogin %></option>
        <% }); %>
      </select>
    </form>
    <% if (selected) { %>
      <form method="post" action="/admin/ai/cache/clear">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="channel" value="<%= selected %>" />
        <button type="submit" class="px-3 py-2 rounded-md border border-neutral-800 text-neutral-400 hover:text-neutral-200 text-sm transition-colors"><%= t('admin.ai.clearCache') %></button>
      </form>
    <% } %>
  </div>

  <% if (!entries.length) { %>
    <p class="text-neutral-600 text-sm"><%= t('admin.ai.cacheEmpty') %></p>
  <% } else { %>
    <div class="rounded-lg border border-neutral-800 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-neutral-900 text-neutral-400">
            <tr>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colText') %></th>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colAnswer') %></th>
              <th class="text-left font-medium px-4 py-2"><%= t('admin.ai.colHits') %></th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800">
            <% entries.forEach(function (e) { %>
              <tr class="odd:bg-neutral-950 even:bg-neutral-900/40">
                <td class="px-4 py-2 text-neutral-200"><%= e.text %></td>
                <td class="px-4 py-2 text-neutral-400"><%= e.answer %></td>
                <td class="px-4 py-2 text-neutral-400 tabular-nums"><%= e.hits || 0 %></td>
                <td class="px-4 py-2 text-right">
                  <form method="post" action="/admin/ai/cache/delete">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="channel" value="<%= selected %>" />
                    <input type="hidden" name="text" value="<%= e.text %>" />
                    <button type="submit" class="text-red-400 hover:text-red-300 text-xs"><%= t('admin.ai.delete') %></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/foot') %>
