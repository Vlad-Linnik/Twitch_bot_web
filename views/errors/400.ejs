<%#
  A request whose parameters cannot be honoured - e.g. a feed `?cursor=` that was hand-edited or
  truncated. Expects: backHref (optional) - where a working version of the page lives; read via
  typeof because most callers have no better place to send the visitor than home.
%>
<% const back = typeof backHref === 'string' && backHref ? backHref : '/'; %>
<%- include('../partials/head', { title: t('errors.badRequestTitle') }) %>
<%- include('../partials/nav') %>

<main class="pt-14 max-w-lg mx-auto px-6 py-24 text-center">
  <h1 class="text-2xl font-bold text-neutral-100 mb-3"><%= t('errors.badRequestTitle') %></h1>
  <p class="text-neutral-400"><%= t('errors.badRequestMessage') %></p>
  <a href="<%= back %>" data-transition="backward" class="inline-block mt-6 text-purple-400 hover:text-purple-300"><%= back === '/' ? t('errors.backToHome') : t('errors.backToPage') %></a>
</main>

<%- include('../partials/foot') %>
