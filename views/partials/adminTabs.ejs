<%# Sub-page switcher for /admin{,/settings-log,/actions,/statistics,/games,/news,/game-runs,/disk-usage}.
    Expects: tab ("overview"|"settings-log"|"actions"|"statistics"|"games"|"news"|"game-runs"|"disk-usage").
    Same look as statsTabs.ejs. %>
<nav class="flex gap-1 mb-10 border-b border-neutral-800">
  <a href="/admin" data-transition="backward"
     class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors <%= tab === 'overview' ? 'border-purple-500 text-neutral-100' : 'border-transparent text-neutral-500 hover:text-neutral-300' %>">
    <%= t('admin.tabOverview') %>
  </a>
  <a href="/admin/visits"
     class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors <%= tab === 'statistics' ? 'border-purple-500 text-neutral-100' : 'border-transparent text-neutral-500 hover:text-neutral-300' %>">
    <%= t('admin.tabStatistics') %>
  </a>
  <a href="/admin/games"
     class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors <%= tab === 'games' ? 'border-purple-500 text-neutral-100' : 'border-transparent text-neutral-500 hover:text-neutral-300' %>">
    <%= t('admin.tabGames') %>
  </a>
  <a href="/admin/news"
     class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors <%= tab === 'news' ? 'border-purple-500 text-neutral-100' : 'border-transparent text-neutral-500 hover:text-neutral-300' %>">
    <%= t('admin.tabNews') %>
  </a>
  <a href="/admin/game-runs"
     class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors <%= tab === 'game-runs' ? 'border-purple-500 text-neutral-100' : 'border-transparent text-neutral-500 hover:text-neutral-300' %>">
    <%= t('admin.tabGameRuns') %>
  </a>
  <a href="/admin/disk-usage"
     class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors <%= tab === 'disk-usage' ? 'border-purple-500 text-neutral-100' : 'border-transparent text-neutral-500 hover:text-neutral-300' %>">
    <%= t('admin.tabDiskUsage') %>
  </a>
  <a href="/admin/settings-log"
     class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors <%= tab === 'settings-log' ? 'border-purple-500 text-neutral-100' : 'border-transparent text-neutral-500 hover:text-neutral-300' %>">
    <%= t('admin.tabSettingsLog') %>
  </a>
  <a href="/admin/actions"
     class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors <%= tab === 'actions' ? 'border-purple-500 text-neutral-100' : 'border-transparent text-neutral-500 hover:text-neutral-300' %>">
    <%= t('admin.tabActions') %>
  </a>
</nav>
