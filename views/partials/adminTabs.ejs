<%# Sub-page switcher for every /admin page.
    Expects: tab (the page's own slug, e.g. "overview" | "games" | "ai" | ...).

    Grouped, not one flat row: at eleven entries the single underlined row had stopped being
    scannable - finding a page meant reading the whole line. The groups are the three things the
    panel actually administers, and the pill styling (rather than statsTabs.ejs's bottom-border
    underline) is what makes a multi-row nav readable - an underline only lines up with the
    container border on the last row. %>
<%
  const adminTabGroups = [
    {
      label: null,
      tabs: [{ slug: "overview", href: "/admin", key: "admin.tabOverview", backward: true }],
    },
    {
      label: "admin.groupSite",
      tabs: [
        { slug: "statistics", href: "/admin/visits", key: "admin.tabStatistics" },
        { slug: "games", href: "/admin/games", key: "admin.tabGames" },
        { slug: "game-runs", href: "/admin/game-runs", key: "admin.tabGameRuns" },
        { slug: "news", href: "/admin/news", key: "admin.tabNews" },
        { slug: "page-themes", href: "/admin/page-themes", key: "admin.tabPageThemes" },
      ],
    },
    {
      label: "admin.groupBot",
      tabs: [
        { slug: "ai", href: "/admin/ai", key: "admin.tabAi" },
        { slug: "settings-log", href: "/admin/settings-log", key: "admin.tabSettingsLog" },
      ],
    },
    {
      label: "admin.groupServer",
      tabs: [
        { slug: "disk-usage", href: "/admin/disk-usage", key: "admin.tabDiskUsage" },
        { slug: "memory", href: "/admin/memory", key: "admin.tabMemory" },
        { slug: "actions", href: "/admin/actions", key: "admin.tabActions" },
      ],
    },
  ];
%>
<nav class="mb-10 pb-5 border-b border-neutral-800 flex flex-wrap items-start gap-x-8 gap-y-4">
  <% adminTabGroups.forEach(function (group) { %>
    <div class="min-w-0">
      <div class="px-2 mb-1.5 h-3 text-[10px] font-medium uppercase tracking-wider text-neutral-600">
        <% if (group.label) { %><%= t(group.label) %><% } %>
      </div>
      <div class="flex flex-wrap gap-1">
        <% group.tabs.forEach(function (item) { %>
          <a href="<%= item.href %>"<% if (item.backward) { %> data-transition="backward"<% } %>
             class="px-3 py-1.5 rounded-md text-sm font-medium border transition-colors <%= tab === item.slug ? 'border-purple-700 bg-purple-600/15 text-purple-200' : 'border-transparent text-neutral-500 hover:text-neutral-300 hover:bg-neutral-900' %>">
            <%= t(item.key) %>
          </a>
        <% }); %>
      </div>
    </div>
  <% }); %>
</nav>
