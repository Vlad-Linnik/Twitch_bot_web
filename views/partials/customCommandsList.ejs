<%#
  The existing-commands list on views/customCommands.ejs - a separate partial so it can be
  re-rendered server-side and swapped in wholesale after a fetch-based create/edit save
  (routes/customCommands.js's POST handler, public/js/custom-commands.js's submitCommandForm),
  the same way partials/commentThread.ejs backs the news comments page's AJAX posting. Expects:
  commands (flat, for the count), sections (grouped, see routes/customCommands.js), channel;
  t/csrfToken come through res.locals automatically, same as every other view in this app.
%>
<h2 class="text-lg font-semibold text-neutral-100 mb-3"><%= t('customCommands.existing') %> <span class="text-neutral-600 text-sm">(<%= commands.length %>)</span></h2>

<% if (commands.length === 0) { %>
  <p class="rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-6 text-center text-neutral-600 text-sm"><%= t('customCommands.none') %></p>
<% } else { %>
  <% sections.forEach(function(section) { %>
    <% if (section.name) { %>
      <% const allOn = section.commands.every(function(c) { return c.enabled; }); %>
      <div class="flex items-center justify-between mb-2 mt-6 first:mt-0">
        <h3 class="text-sm font-semibold text-neutral-300"><%= section.name %> <span class="text-neutral-600 font-normal">(<%= section.commands.length %>)</span></h3>
        <%# Group master switch: one request flips every command in this group to the same
            enabled state (routes/customCommands.js's "toggleGroup" action) - reads "on" as
            long as anything in the group still runs, "off" only once the whole group is off,
            same semantics as the fetch handler that repaints it (public/js/custom-commands.js). %>
        <form method="post" action="/<%= channel.channelLogin %>/settings/custom-commands/commands" data-group-toggle data-group="<%= section.name %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="action" value="toggleGroup" />
          <input type="hidden" name="group" value="<%= section.name %>" />
          <button type="submit"
                  class="relative inline-flex h-5 w-9 items-center rounded-full transition-colors <%= allOn ? 'bg-purple-600' : 'bg-neutral-700' %>"
                  aria-pressed="<%= allOn ? 'true' : 'false' %>"
                  aria-label="<%= t('customCommands.toggleGroupEnabled', { group: section.name }) %>">
            <span class="inline-block h-3.5 w-3.5 transform rounded-full bg-white transition-transform <%= allOn ? 'translate-x-4' : 'translate-x-1' %>"></span>
          </button>
        </form>
      </div>
    <% } %>
    <ul class="rounded-lg border border-neutral-800 bg-neutral-900 divide-y divide-neutral-800/70 mb-2">
      <% section.commands.forEach(function(c) { %>
        <%- include('customCommandRow', { c, channel, csrfToken, t }) %>
      <% }) %>
    </ul>
  <% }) %>
<% } %>
