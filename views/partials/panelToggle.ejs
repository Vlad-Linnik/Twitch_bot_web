<%#
  Owner-only eye / eye-slash button that shows/hides one panel of THIS profile page. Only ever
  included when isOwner is true - see views/userDashboard.ejs. Wired up client-side by
  public/js/user-dashboard.js's `[data-panel-toggle]` handler, which POSTs to panels.json and
  flips the corresponding data-component section's `hidden` attribute without a reload.

  Params: panel ('activity'|'heatmap'|'clouds'|'mentions'), hiddenState (bool - the panel's
  CURRENT visibility), t.
%>
<button type="button"
        class="shrink-0 p-1 rounded text-neutral-500 hover:text-neutral-200 transition-colors"
        data-panel-toggle="<%= panel %>"
        data-hidden="<%= hiddenState ? '1' : '0' %>"
        data-hide-label="<%= t('userDashboard.panelHide') %>"
        data-show-label="<%= t('userDashboard.panelShow') %>"
        aria-pressed="<%= hiddenState ? 'false' : 'true' %>"
        title="<%= hiddenState ? t('userDashboard.panelShow') : t('userDashboard.panelHide') %>">
  <svg data-icon-visible width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor"
       stroke-width="1.6" aria-hidden="true" <% if (hiddenState) { %>hidden<% } %>>
    <path d="M2 10s3-5.5 8-5.5 8 5.5 8 5.5-3 5.5-8 5.5-8-5.5-8-5.5Z" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="10" cy="10" r="2.25" />
  </svg>
  <svg data-icon-hidden width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor"
       stroke-width="1.6" aria-hidden="true" <% if (!hiddenState) { %>hidden<% } %>>
    <path d="M2 10s3-5.5 8-5.5c1.64 0 3.02.46 4.15 1.1M18 10s-1.02 1.87-3 3.35A9.6 9.6 0 0 1 10 15.5c-5 0-8-5.5-8-5.5a15 15 0 0 1 2.45-3.3"
          stroke-linecap="round" stroke-linejoin="round" />
    <path d="M4.6 5.6 15.4 14.4" stroke-linecap="round" />
  </svg>
</button>
