<%# The throne theme's hero, replacing the plain avatar+name header on /<channel>/user/<name>.
    Expects: theme, identity, profile, trophies, t, locale.

    Keeps the .user-header class: public/css/input.css pins it with view-transition-name, so a
    Top Chatters row morphs into this hall on arrival instead of cross-fading. Everything
    decorative is aria-hidden - a screen reader gets the name, the title and the four numbers,
    which is the whole informational content of this block.

    Tile labels reuse the page's existing translations (userDashboard.*) rather than inventing
    ceremonial names; only firstSeen needed a new key, because the page never showed that date. %>
<%
  const TROPHY_LABEL_KEYS = {
    rank: "userDashboard.rank",
    messages: "userDashboard.messages",
    mentions: "userDashboard.mentionsTotal",
    firstSeen: "userDashboard.firstSeen",
    nicknames: "userDashboard.nicknameHistory",
    topEmote: "userDashboard.emoteCloud",
  };
  // "сообщений"/"messages" is written lowercase because it is normally a suffix after a number;
  // as a tile heading it starts a line of its own.
  const asHeading = (s) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
  const medallionSrc = theme.medallionUrl || (profile && profile.avatarUrl) || null;
%>
<header class="throne-hero user-header" data-accent="<%= theme.accent.preset %>" data-scope="<%= theme.backdrop.scope %>"
        <% if (theme.accent.custom) { %>style="--throne-accent: <%= theme.accent.custom %>"<% } %>>

  <%# At page scope the hall is drawn once for the whole viewport (views/userDashboard.ejs) and
      the hero keeps only the cornice - the top of the wall belongs above the throne, and pinning
      a second one to the viewport would park a gold bar under the nav at every scroll position.
      At hero scope the hero draws the whole room itself.

      The drawn columns appear in VECTOR mode only. A backdrop photograph is already a room, with
      its own columns in its own perspective; standing flat grey shafts in front of it doesn't add
      a room, it puts a cardboard cutout over a real one. The cornice stays in both modes - it is
      a gilded edge along the top rather than a piece of architecture in perspective. %>
  <%- include('throneHall', {
        theme,
        pieces: theme.backdrop.scope === 'page'
          ? ['cornice']
          : (theme.backdrop.mode === 'photo' ? ['photo', 'cornice'] : ['cornice', 'columns']),
        fixed: false
      }) %>

  <%# The cartouche belongs to the hero at either scope: it is the halo behind the throne, not a
      feature of the room. %>
  <svg class="throne-hall__cartouche" viewBox="-90 -80 180 180" role="presentation" aria-hidden="true">
    <path d="M0 -58 C 46 -58 74 -30 74 6 C 74 44 40 66 0 78 C -40 66 -74 44 -74 6 C -74 -30 -46 -58 0 -58 Z"
          fill="var(--throne-stone)" fill-opacity="0.4" stroke="url(#throne-gold)" stroke-width="4" />
    <path d="M0 -40 C 30 -40 50 -22 50 4 C 50 30 26 48 0 56 C -26 48 -50 30 -50 4 C -50 -22 -30 -40 0 -40 Z"
          fill="none" stroke="var(--throne-gold-deep)" stroke-width="1.5" opacity="0.7" />
  </svg>

  <div class="throne-stage">
    <svg class="throne-seat" viewBox="0 0 400 390" role="presentation" aria-hidden="true">
      <%# Gradients come from partials/throneDefs.ejs, included once per page. %>
      <%# Dais: three steps, widest at the bottom. %>
      <rect x="50" y="352" width="300" height="22" rx="3" fill="url(#throne-gold-flat)" opacity="0.5" />
      <rect x="80" y="333" width="240" height="20" rx="3" fill="url(#throne-gold-flat)" opacity="0.68" />
      <rect x="105" y="314" width="190" height="20" rx="3" fill="url(#throne-gold-flat)" opacity="0.85" />

      <%# Back panel: a tall arched slab, deliberately narrower than the seat so the throne reads
          as a chair rather than as a bench. The inner fill is stone, which keeps the medallion
          laid over it legible whatever the accent colour is. %>
      <path d="M140 250 L140 92 C140 42 166 16 200 16 C234 16 260 42 260 92 L260 250 Z"
            fill="var(--throne-back)" stroke="url(#throne-gold)" stroke-width="7" stroke-linejoin="round" />
      <path d="M154 244 L154 96 C154 54 174 34 200 34 C226 34 246 54 246 96 L246 244 Z"
            fill="none" stroke="var(--throne-gold-deep)" stroke-width="2" opacity="0.7" />

      <%# Finials on the shoulders of the back panel. %>
      <circle cx="140" cy="88" r="12" fill="url(#throne-gold)" />
      <circle cx="260" cy="88" r="12" fill="url(#throne-gold)" />

      <%# Armrests: a bar ending in a scrolled volute on each side, the detail that separates a
          throne from a padded box. %>
      <path d="M112 244 L288 244 L288 258 L112 258 Z" fill="url(#throne-gold)" />
      <path d="M112 244 C 96 244 88 252 88 264 C 88 274 96 280 104 280 C 112 280 118 274 118 266"
            fill="none" stroke="url(#throne-gold)" stroke-width="9" stroke-linecap="round" />
      <path d="M288 244 C 304 244 312 252 312 264 C 312 274 304 280 296 280 C 288 280 282 274 282 266"
            fill="none" stroke="url(#throne-gold)" stroke-width="9" stroke-linecap="round" />

      <%# Seat and legs. %>
      <rect x="118" y="258" width="164" height="30" rx="5" fill="var(--throne-cushion)" />
      <rect x="118" y="258" width="164" height="30" rx="5" fill="none" stroke="url(#throne-gold)" stroke-width="4" />
      <rect x="132" y="288" width="18" height="28" rx="4" fill="url(#throne-gold-flat)" />
      <rect x="250" y="288" width="18" height="28" rx="4" fill="url(#throne-gold-flat)" />
    </svg>

    <%# The medallion: a portrait in a laurel ring, sitting on the throne's back panel. The
        laurel is 26 copies of one leaf rotated around the centre - drawing it as a loop keeps
        the ring even and the markup short. %>
    <div class="throne-medallion">
      <svg class="throne-medallion__laurel" viewBox="0 0 200 200" role="presentation" aria-hidden="true">
        <circle cx="100" cy="100" r="78" fill="none" stroke="var(--throne-gold-deep)" stroke-width="2" opacity="0.8" />
        <% for (let i = 0; i < 26; i++) { %>
          <ellipse cx="100" cy="22" rx="6.5" ry="12"
                   transform="rotate(<%= (360 / 26) * i %> 100 100) rotate(<%= i % 2 ? 18 : -18 %> 100 22)"
                   fill="url(#throne-gold)" opacity="<%= i % 2 ? 0.85 : 1 %>" />
        <% } %>
        <circle cx="100" cy="100" r="63" fill="none" stroke="url(#throne-gold)" stroke-width="5" />
      </svg>
      <% if (medallionSrc) { %>
        <img class="throne-medallion__portrait" src="<%= medallionSrc %>" alt="" width="126" height="126" />
      <% } else { %>
        <%# Same fallback the plain header uses: a monogram beats a broken image. %>
        <div class="throne-medallion__portrait throne-medallion__monogram">
          <%= identity.currentUserName.charAt(0).toUpperCase() %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="throne-plaque">
    <%# Deliberately NOT the user's chat colour (profile.color), unlike the plain header: those
        colours are picked to be legible in a dark chat window, and a saturated one on plaster
        next to gold reads as a rendering fault rather than as a choice. %>
    <h1 class="throne-name"><%= identity.currentUserName %></h1>
    <% if (theme.title) { %>
      <p class="throne-title"><%= theme.title %></p>
    <% } %>
    <% if (theme.motto) { %>
      <p class="throne-motto">«<%= theme.motto %>»</p>
    <% } %>

    <%# The nickname history the plain header carries in a chevron dropdown. It survives the
        theme swap rather than being dropped: it is the only place on the site that answers
        "who was this person before", and a skin has no business deleting information. %>
    <% if (nicknames && nicknames.length > 0) { %>
      <details class="throne-nicknames">
        <summary><%= t('userDashboard.nicknameHistory') %></summary>
        <ul>
          <% nicknames.forEach(function(name) { %>
            <li><%= name %></li>
          <% }) %>
        </ul>
      </details>
    <% } %>
  </div>

  <dl class="throne-trophies">
    <% trophies.forEach(function(tile) { %>
      <div class="throne-trophy">
        <dt class="throne-trophy__label"><%= asHeading(t(TROPHY_LABEL_KEYS[tile.key] || tile.key)) %></dt>
        <dd class="throne-trophy__value">
          <% if (tile.value === null || tile.value === undefined) { %>
            <span class="throne-trophy__empty">—</span>
          <% } else if (tile.kind === "rank") { %>
            #<%= tile.value.toLocaleString(locale) %><span class="throne-trophy__of">/ <%= tile.secondary.toLocaleString(locale) %></span>
          <% } else if (tile.kind === "number") { %>
            <%= tile.value.toLocaleString(locale) %>
          <% } else if (tile.kind === "date") { %>
            <%= new Date(tile.value).toLocaleDateString(locale, { year: "numeric", month: "long" }) %>
          <% } else if (tile.secondary) { %>
            <img class="throne-trophy__emote" src="<%= tile.secondary %>" alt="<%= tile.value %>" title="<%= tile.value %>" />
          <% } else { %>
            <span class="throne-trophy__word"><%= tile.value %></span>
          <% } %>
        </dd>
      </div>
    <% }) %>
  </dl>
</header>
