<%# Sub-page switcher inside the admin panel's AI section. Expects: aiTab. %>
<nav class="flex flex-wrap gap-1 mb-8">
  <%
    const aiSubTabs = [
      { slug: "settings", href: "/admin/ai", key: "admin.ai.tabSettings" },
      { slug: "channels", href: "/admin/ai/channels", key: "admin.ai.tabChannels" },
      { slug: "filter", href: "/admin/ai/filter", key: "admin.ai.tabFilter" },
      { slug: "cache", href: "/admin/ai/cache", key: "admin.ai.tabCache" },
      { slug: "memory", href: "/admin/ai/memory", key: "admin.ai.tabMemory" },
      { slug: "viewers", href: "/admin/ai/viewers", key: "admin.ai.tabViewers" },
      { slug: "log", href: "/admin/ai/log", key: "admin.ai.tabLog" },
      { slug: "verdicts", href: "/admin/ai/verdicts", key: "admin.ai.tabVerdicts" },
      { slug: "ignored", href: "/admin/ai/ignored", key: "admin.ai.tabIgnored" },
    ];
  %>
  <% aiSubTabs.forEach(function (item) { %>
    <a href="<%= item.href %>"
       class="px-3 py-1.5 rounded-md text-xs font-medium border transition-colors <%= aiTab === item.slug ? 'border-neutral-700 bg-neutral-800 text-neutral-100' : 'border-neutral-800 text-neutral-500 hover:text-neutral-300' %>">
      <%= t(item.key) %>
    </a>
  <% }); %>
</nav>
