<%#
  The queue panel's button theme (routes/donationMedia.js, POST .../buttons), on its own settings
  page (views/donationMediaButtons.ejs). Reads channel, buttons, iconSlots, sevenTvTheme,
  customIcons, iconErrorNames, csrfToken, error, errorPlatform from the page.
%>
<%
  const bInput = 'w-full bg-neutral-950 border border-neutral-800 rounded-md px-3 py-2 text-sm text-neutral-200 placeholder:text-neutral-600 focus:outline-none focus:border-purple-600';
  const bButton = 'px-4 py-2 rounded-md bg-purple-700 hover:bg-purple-600 text-white text-sm font-medium';
  const bGhost = 'px-3 py-2 rounded-md border border-neutral-700 hover:border-neutral-500 text-neutral-300 text-sm';
  const bError = (typeof error !== 'undefined' && error && errorPlatform === 'buttons') ? error : null;
  const bErrorKeys = ['iconType', 'iconTooLarge', 'iconUnknown', 'iconEmpty', 'iconTheme', 'iconSlot'];
  const unknownNames = typeof iconErrorNames === 'string' ? iconErrorNames : '';
  const drawIcon = (resolved) => resolved && resolved.imgs
    ? resolved.imgs.map((src) => `<img src="${src.replace(/"/g, '&quot;')}" alt="" class="h-7 w-auto inline-block" loading="lazy" />`).join('')
    : `<span class="text-xl leading-7">${resolved ? resolved.emoji : ''}</span>`;
  const themes = [
    { key: 'default', preview: (slot) => ({ emoji: slot.emoji }) },
    { key: '7tv', preview: (slot) => sevenTvTheme[slot.key] },
    { key: 'custom', preview: (slot) => customIcons[slot.key] },
  ];
%>
<section id="buttons" class="mb-10 rounded-lg border border-neutral-800 bg-neutral-900 p-6 scroll-mt-24">
  <p class="text-sm text-neutral-500 mb-5"><%= t('donationMedia.setup.buttonsIntro') %></p>

  <% if (bError) { %>
    <p class="mb-4 rounded-lg border border-red-800/50 bg-red-900/20 text-red-400 px-4 py-2.5 text-sm">
      <%= t('donationMedia.setup.errors.' + (bErrorKeys.includes(bError) ? bError : 'iconType')) %><% if (bError === 'iconUnknown' && unknownNames) { %>: <%= unknownNames %><% } %>
    </p>
  <% } %>

  <form method="post" enctype="multipart/form-data" action="/<%= channel.channelLogin %>/settings/donation-media/buttons" class="space-y-3 mb-8">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="action" value="theme" />
    <% for (const theme of themes) { %>
      <label class="flex flex-col sm:flex-row sm:items-center gap-3 rounded-md border px-4 py-3 cursor-pointer <%= buttons.theme === theme.key ? 'border-purple-600 bg-purple-900/10' : 'border-neutral-800 hover:border-neutral-600' %>">
        <span class="flex items-center gap-2 sm:w-44 shrink-0">
          <input type="radio" name="theme" value="<%= theme.key %>" <%= buttons.theme === theme.key ? 'checked' : '' %> class="accent-purple-600" />
          <span class="text-sm text-neutral-200 font-medium"><%= t('donationMedia.setup.theme.' + theme.key) %></span>
        </span>
        <span class="flex flex-wrap items-center gap-2">
          <% for (const slot of iconSlots) { %>
            <span title="<%= t('donationMedia.setup.slots.' + slot.key) %>" class="inline-flex items-center h-8"><%- drawIcon(theme.preview(slot)) %></span>
          <% } %>
        </span>
      </label>
    <% } %>
    <button type="submit" class="<%= bButton %>"><%= t('donationMedia.setup.themeSave') %></button>
  </form>

  <h3 class="text-sm font-semibold text-neutral-200 mb-1"><%= t('donationMedia.setup.customHeading') %></h3>
  <p class="text-xs text-neutral-500 mb-4"><%= t('donationMedia.setup.customIntro') %></p>
  <div class="space-y-3">
    <% for (const slot of iconSlots) { const own = buttons.custom[slot.key]; %>
      <form method="post" enctype="multipart/form-data" action="/<%= channel.channelLogin %>/settings/donation-media/buttons"
            class="rounded-md border border-neutral-800 px-4 py-3 flex flex-col lg:flex-row lg:items-center gap-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="slot" />
        <input type="hidden" name="slot" value="<%= slot.key %>" />
        <span class="flex items-center gap-2 lg:w-48 shrink-0">
          <span class="inline-flex items-center gap-1 min-w-[2.5rem]"><%- drawIcon(customIcons[slot.key]) %></span>
          <span class="text-sm text-neutral-300"><%= t('donationMedia.setup.slots.' + slot.key) %></span>
        </span>
        <span class="flex flex-wrap items-center gap-2 flex-1 min-w-0">
          <input type="text" name="refs" maxlength="400" autocomplete="off" spellcheck="false" placeholder="<%= t('donationMedia.setup.customRefsPlaceholder') %>" class="<%= bInput %> flex-1 min-w-[12rem]" />
          <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" title="<%= t('donationMedia.setup.customUpload') %>"
                 class="block text-xs text-neutral-400 max-w-full file:mr-2 file:rounded-md file:border-0 file:bg-neutral-800 file:px-2 file:py-1.5 file:text-neutral-200 hover:file:bg-neutral-700" />
        </span>
        <span class="flex gap-2 shrink-0">
          <button type="submit" class="<%= bButton %>"><%= t('donationMedia.setup.customSave') %></button>
          <% if (own) { %><button type="submit" name="reset" value="1" class="<%= bGhost %>" formnovalidate><%= t('donationMedia.setup.customReset') %></button><% } %>
        </span>
      </form>
    <% } %>
  </div>
</section>
