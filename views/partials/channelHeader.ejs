<%#
  Channel identity + channel navbar, at the top of every channel section page (statistics chat
  and mod, the news feed and a single post). Pinned via view-transition-name: channel-header
  (public/css/input.css) so it stays put while the page below it slides - same technique as the
  site nav (partials/nav.ejs) - and home's channel cards morph into it.

  Left: avatar + nick, linking to the streamer's Twitch channel, the nick in their real chat
  color. Right, on the same row: the sections from lib/channelNav.js's buildChannelNav. On a
  narrow screen the bar drops to its own row under the nick and scrolls sideways instead of
  wrapping, so the items keep their order and size.

  The header is as wide as the widest channel page, whatever the width of the <main> it sits in
  (.channel-header in public/css/input.css): the pages differ (news is narrow, statistics wide),
  and a header that followed them moved the bar under the cursor on every switch.

  Expects: channel, broadcaster ({avatarUrl, chatColor} | null - fail-soft to a monogram and the
  default text color), channelNav (buildChannelNav's output).
%>
<%
  // One small line icon per section (24-unit viewBox, stroked), keyed like lib/channelNav.js.
  const NAV_ICONS = {
    statistics: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
    news: '<path d="M4 5h13v14a1 1 0 001 1H5a1 1 0 01-1-1V5z"/><path d="M17 9h3v10a1 1 0 01-2 0"/><path d="M7.5 9h6M7.5 12.5h6M7.5 16h4"/>',
    movies: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 5v14M17 5v14M3 9.5h4M3 14.5h4M17 9.5h4M17 14.5h4"/>',
    games: '<path d="M7.5 7h9a4.5 4.5 0 014.4 5.4l-.8 4a2.6 2.6 0 01-4.5 1.2L14 16h-4l-1.6 1.6a2.6 2.6 0 01-4.5-1.2l-.8-4A4.5 4.5 0 017.5 7z"/><path d="M8 10v3M6.5 11.5h3"/><circle cx="15.5" cy="11" r=".6" fill="currentColor"/><circle cx="17" cy="12.8" r=".6" fill="currentColor"/>',
    recap: '<path d="M12 3l1.9 4.6L19 8.3l-3.9 3.4 1.2 5L12 14.1 7.7 16.7l1.2-5L5 8.3l5.1-.7z"/>',
  };
%>
<header class="channel-header mb-8">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
    <a href="https://twitch.tv/<%= channel.channelLogin %>" target="_blank" rel="noopener noreferrer"
       class="flex items-center gap-4 group min-w-0">
      <% if (broadcaster && broadcaster.avatarUrl) { %>
        <img src="<%= broadcaster.avatarUrl %>" alt="" width="56" height="56"
             class="w-14 h-14 rounded-full ring-2 ring-neutral-800 group-hover:ring-purple-500/70 transition-shadow shrink-0" />
      <% } else { %>
        <span class="w-14 h-14 rounded-full grid place-items-center bg-neutral-800 text-neutral-300 text-xl font-semibold ring-2 ring-neutral-800 shrink-0"><%= channel.channelLogin.charAt(0).toUpperCase() %></span>
      <% } %>
      <h1 class="text-3xl font-bold truncate group-hover:underline decoration-2 underline-offset-4 <%= broadcaster && broadcaster.chatColor ? '' : 'text-neutral-100' %>"
          <% if (broadcaster && broadcaster.chatColor) { %>style="color: <%= broadcaster.chatColor %>"<% } %>><%= channel.channelLogin %></h1>
    </a>

    <% if (channelNav.length > 1) { %>
      <nav aria-label="<%= t('channelNav.label') %>"
           class="channel-nav w-full md:w-auto md:ml-auto flex gap-0.5 p-1 overflow-x-auto whitespace-nowrap rounded-xl bg-neutral-900/80 ring-1 ring-white/[0.06] shadow-lg shadow-black/30">
        <% channelNav.forEach(function(item) { %>
          <a href="<%= item.href %>"<% if (item.transition) { %> data-transition="<%= item.transition %>"<% } %>
             <% if (item.active) { %>aria-current="page"<% } %>
             class="relative shrink-0 inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium transition-colors
                    focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-purple-500 <%=
               item.active
                 ? 'text-white'
                 : item.preview
                   ? 'text-neutral-600 hover:text-neutral-400 hover:bg-white/[0.03]'
                   : 'text-neutral-400 hover:text-neutral-100 hover:bg-white/[0.05]' %>">
            <% if (item.active) { %>
              <%# Its own view-transition-name (public/css/input.css): the highlight slides from the
                  section being left to the one being opened. %>
              <span class="channel-nav-pill absolute inset-0 rounded-lg bg-gradient-to-b from-purple-500/90 to-purple-700/90 shadow-md shadow-purple-900/50 ring-1 ring-inset ring-white/15" aria-hidden="true"></span>
            <% } %>
            <svg class="relative w-4 h-4 shrink-0<%= item.active ? '' : ' opacity-80' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- NAV_ICONS[item.key] || '' %></svg>
            <span class="relative"><%= t('channelNav.' + item.key) %></span>
            <% if (item.preview) { %><span class="relative text-[10px] uppercase tracking-wide text-amber-500/80"><%= t('channelNav.preview') %></span><% } %>
          </a>
        <% }) %>
      </nav>
    <% } %>
  </div>
</header>
