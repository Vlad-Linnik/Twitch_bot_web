<%#
  A run of grid tiles (movies and games) - the first portion of the grid and every portion
  list.json returns, so a tile loaded on scroll is the same markup as one rendered first.
  Expects: cards (routes/mediaSection.js's shapeCard), channel, section, csrf, sec/st (the section's
  view config and translator, set by the router).

  A suggestion's tile also gets the promote/not-now control (partials/suggestionVote.ejs) under it,
  outside the link - a form inside an <a> is invalid and would swallow the click. A planned
  (accepted) suggestion says so on the poster; a viewer's cover still waiting for approval is marked
  for the only people who can see it (its author and 0-2) - everyone else gets the placeholder.

  The look is the section's own, not the news feed's: no bordered box, the poster IS the tile, the
  title sits on it over a dark fade with the three scores under it (partials/ratingTrio).
  Amber/gold is this section's accent (news keeps neutral cards and purple).

  posterUrl is already the right copy: for an 18+ card it is the blurred file, never the normal one
  (lib/mediaImage.js's gridPosterUrl) - the grid's HTML does not contain the normal URL at all.
  The [data-list-item] wrapper is public/js/infinite-list.js's anchor for "back".
%>
<% const typeLabel = (c) => c.mediaType ? st('type.' + c.mediaType) : ''; %>
<% cards.forEach(function(card) { %>
  <div data-list-item="<%= card.id %>">
    <a href="/<%= channel.channelLogin %>/<%= section %>/<%= card.id %>"
       class="group block rounded-(--sec-radius) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--sec-accent)">
      <%# data-vt-name: the poster morphs into the card page's own poster (public/js/page-transitions.js
          tags it on click, mediaItem.ejs's .media-poster is the destination). %>
      <div data-vt-name="media-poster" class="relative aspect-(--sec-aspect) rounded-(--sec-radius) overflow-hidden bg-(--sec-surface) shadow-lg shadow-black/40 ring-1 ring-white/5
                  transition duration-200 group-hover:-translate-y-1 group-hover:ring-(--sec-accent)/70 group-hover:shadow-(--sec-accent)/10">
        <% if (card.posterUrl) { %>
          <img src="<%= card.posterUrl %>" alt="" loading="lazy" decoding="async"
               class="absolute inset-0 w-full h-full object-cover<%= card.nsfw ? ' scale-110' : '' %>" />
        <% } else { %>
          <span class="absolute inset-0 grid place-items-center bg-gradient-to-br from-stone-800 to-stone-950 text-4xl text-stone-700" aria-hidden="true">🎞</span>
        <% } %>

        <%# The fade the title sits on. %>
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/70 to-transparent"></div>

        <div class="absolute top-2 left-2 flex flex-col items-start gap-1">
          <% if (card.nsfw) { %>
            <span class="px-1.5 py-0.5 rounded-md bg-red-600 text-white text-[10px] font-bold tracking-wide">18+</span>
          <% } %>
          <% if (card.status === 'accepted') { %>
            <span class="px-1.5 py-0.5 rounded-md bg-sky-500 text-stone-950 text-[10px] font-bold"><%= st('statusPlanned') %></span>
          <% } else if (card.status === 'rejected') { %>
            <span class="px-1.5 py-0.5 rounded-md bg-stone-700 text-stone-200 text-[10px] font-bold"><%= st('statusRejected') %></span>
          <% } %>
          <% if (card.posterPending) { %>
            <span class="px-1.5 py-0.5 rounded-md bg-amber-950/90 text-amber-300 text-[10px] font-semibold ring-1 ring-amber-500/40"><%= st('coverPending') %></span>
          <% } %>
        </div>

        <div class="absolute inset-x-0 bottom-0 p-3">
          <% if (card.extras && card.extras.gameState) { %>
            <span class="inline-block mb-1.5 px-1.5 py-0.5 rounded bg-(--sec-accent)/15 text-(--sec-accent-strong) text-[10px] font-medium ring-1 ring-(--sec-accent)/30"><%= st('gameState.' + card.extras.gameState) %></span>
          <% } %>
          <% if (card.progress) { %>
            <span class="inline-block mb-1.5 px-1.5 py-0.5 rounded bg-(--sec-accent)/15 text-(--sec-accent-strong) text-[10px] font-medium tabular-nums ring-1 ring-(--sec-accent)/30">
              <% if (card.progress.kind === 'percent') { %><%= st('progressPercent', { done: card.progress.done }) %><% } else if (card.progress.total) { %><%= st('progressEpisodes', { done: card.progress.done, total: card.progress.total }) %><% } else { %><%= st('progressEpisodesOpen', { done: card.progress.done }) %><% } %>
            </span>
          <% } %>
          <h3 class="text-sm font-bold text-white leading-snug line-clamp-2 drop-shadow"><%= card.title %></h3>
          <p class="text-[11px] text-stone-300/80"><%= [card.year, typeLabel(card)].filter(Boolean).join(' · ') %></p>
          <%- include('ratingTrio', { card }) %>
        </div>
      </div>

      <%# Under the poster: what is not a score - hours on stream (games), the comment count. %>
      <% if ((card.extras && card.extras.minutes) || card.commentCount) { %>
      <p class="mt-2 px-0.5 flex items-center gap-2 text-[11px] tabular-nums">
        <% if (card.extras && card.extras.minutes) { %>
          <span class="inline-flex items-center gap-1 text-(--sec-accent-soft)" title="<%= st('onStream') %>">
            <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm.75 4v3.69l2.53 2.53-1.06 1.06-2.97-2.97V6h1.5z"/></svg>
            <%= card.extras.minutes >= 60 ? st('hoursShort', { n: Math.round(card.extras.minutes / 60) }) : st('minutesShort', { n: card.extras.minutes }) %>
          </span>
        <% } %>
        <% if (card.commentCount) { %>
          <span class="ml-auto inline-flex items-center gap-1 text-stone-500" title="<%= t('comments.heading') %>">
            <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 5a3 3 0 013-3h10a3 3 0 013 3v6a3 3 0 01-3 3H9l-4 4v-4H5a3 3 0 01-3-3z"/></svg>
            <%= card.commentCount %>
          </span>
        <% } %>
      </p>
      <% } %>
      <% if (card.excerpt) { %>
        <p class="mt-1 px-0.5 text-[11px] italic text-stone-400 line-clamp-2">«<%= card.excerpt %>»</p>
      <% } %>
    </a>
    <% if (card.votable) { %>
      <div class="mt-2 px-0.5">
        <%- include('suggestionVote', { card, channel, section, csrf, user, size: 'sm' }) %>
      </div>
    <% } %>
  </div>
<% }) %>
