<%#
  A run of grid tiles (movies now, games later) - the first portion of the grid and every portion
  list.json returns, so a tile loaded on scroll is the same markup as one rendered first.
  Expects: cards (routes/movies.js's shapeCard), channel, section.

  The look is the section's own, not the news feed's: no bordered box, the poster IS the tile, the
  title sits on it over a dark fade, and the streamer's score is a gold ticket stub in the corner.
  Amber/gold is this section's accent (news keeps neutral cards and purple).

  posterUrl is already the right copy: for an 18+ card it is the blurred file, never the normal one
  (lib/mediaImage.js's gridPosterUrl) - the grid's HTML does not contain the normal URL at all.
  The [data-list-item] wrapper is public/js/infinite-list.js's anchor for "back".
%>
<% const typeLabel = (c) => c.mediaType ? t('movies.type.' + c.mediaType) : ''; %>
<% cards.forEach(function(card) { %>
  <div data-list-item="<%= card.id %>">
    <a href="/<%= channel.channelLogin %>/<%= section %>/<%= card.id %>"
       class="group block rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-400">
      <div class="relative aspect-[2/3] rounded-xl overflow-hidden bg-stone-900 shadow-lg shadow-black/40 ring-1 ring-white/5
                  transition duration-200 group-hover:-translate-y-1 group-hover:ring-amber-400/70 group-hover:shadow-amber-500/10">
        <% if (card.posterUrl) { %>
          <img src="<%= card.posterUrl %>" alt="" loading="lazy" decoding="async"
               class="absolute inset-0 w-full h-full object-cover<%= card.nsfw ? ' scale-110' : '' %>" />
        <% } else { %>
          <span class="absolute inset-0 grid place-items-center bg-gradient-to-br from-stone-800 to-stone-950 text-4xl text-stone-700" aria-hidden="true">🎞</span>
        <% } %>

        <%# The fade the title sits on. %>
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/70 to-transparent"></div>

        <% if (card.nsfw) { %>
          <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded-md bg-red-600 text-white text-[10px] font-bold tracking-wide">18+</span>
        <% } %>
        <% if (card.streamerRating) { %>
          <%# A ticket stub flush to the right edge - the score that is the streamer's own. %>
          <span class="absolute top-2 right-0 flex items-center gap-1 pl-2 pr-2.5 py-1 rounded-l-md bg-amber-400 text-stone-950 text-xs font-extrabold tabular-nums shadow"
                title="<%= t('movies.ratingStreamer') %>">
            <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg>
            <%= card.streamerRating %>
          </span>
        <% } %>

        <div class="absolute inset-x-0 bottom-0 p-3">
          <% if (card.progress) { %>
            <span class="inline-block mb-1.5 px-1.5 py-0.5 rounded bg-amber-400/15 text-amber-300 text-[10px] font-medium tabular-nums ring-1 ring-amber-400/30">
              <% if (card.progress.kind === 'percent') { %><%= t('movies.progressPercent', { done: card.progress.done }) %><% } else if (card.progress.total) { %><%= t('movies.progressEpisodes', { done: card.progress.done, total: card.progress.total }) %><% } else { %><%= t('movies.progressEpisodesOpen', { done: card.progress.done }) %><% } %>
            </span>
          <% } %>
          <h3 class="text-sm font-bold text-white leading-snug line-clamp-2 drop-shadow"><%= card.title %></h3>
          <p class="text-[11px] text-stone-300/80"><%= [card.year, typeLabel(card)].filter(Boolean).join(' · ') %></p>
        </div>
      </div>

      <%# Under the poster: the two outside numbers, compact. %>
      <p class="mt-2 px-0.5 flex items-center gap-2 text-[11px] tabular-nums">
        <span class="inline-flex items-center gap-1 <%= card.viewerAverage !== null ? 'text-amber-200' : 'text-stone-600' %>" title="<%= t('movies.ratingViewers') %>">
          <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg>
          <%= card.viewerAverage !== null ? card.viewerAverage.toFixed(1) : '—' %>
        </span>
        <% if (card.imdbRating !== null && card.imdbRating !== undefined) { %>
          <span class="inline-flex items-center gap-1 text-stone-300" title="IMDb">
            <span class="px-1 rounded-sm bg-[#f5c518] text-black text-[9px] font-black leading-[1.4]">IMDb</span><%= card.imdbRating.toFixed(1) %>
          </span>
        <% } %>
        <% if (card.commentCount) { %>
          <span class="ml-auto inline-flex items-center gap-1 text-stone-500" title="<%= t('comments.heading') %>">
            <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 5a3 3 0 013-3h10a3 3 0 013 3v6a3 3 0 01-3 3H9l-4 4v-4H5a3 3 0 01-3-3z"/></svg>
            <%= card.commentCount %>
          </span>
        <% } %>
      </p>
      <% if (card.excerpt) { %>
        <p class="mt-1 px-0.5 text-[11px] italic text-stone-400 line-clamp-2">«<%= card.excerpt %>»</p>
      <% } %>
    </a>
  </div>
<% }) %>
