<%#
  One command in a channel's custom-commands list (views/customCommands.ejs, one per section).
  Expects: c (the mapped command object from routes/customCommands.js), channel, csrfToken,
  maxGroupLength, t.

  draggable/data-command/data-group are what public/js/custom-commands.js's drag-and-drop reads to
  move this command into another group; the "..." menu below is the same operation's no-drag (and
  keyboard-reachable) path, plus edit and delete.
%>
<li class="cc-row px-4 py-3 flex items-start gap-3"
    draggable="true"
    data-command="<%= c.command %>"
    data-group="<%= c.group %>">
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2 flex-wrap">
      <code class="text-purple-400 font-medium">!<%= c.command %></code>
      <% if (c.enabled === false) { %>
        <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-500 border border-neutral-700"><%= t('customCommands.disabledBadge') %></span>
      <% } %>
      <% if (c.timerSeconds) { %>
        <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400"><%= t('customCommands.every') %> <%= c.timerSeconds %>s</span>
      <% } %>
      <% if (c.pin) { %>
        <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-amber-600/20 text-amber-500 border border-amber-600/30"><%= t('customCommands.pinned') %></span>
      <% } %>
      <% if (c.announce) { %>
        <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-purple-600/20 text-purple-400 border border-purple-600/30"><%= t('customCommands.announced') %> · <%= t('customCommands.color.' + c.announceColor) %></span>
      <% } %>
      <% if (c.modOnly) { %>
        <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-red-600/20 text-red-400 border border-red-600/30"><%= t('customCommands.modOnlyBadge') %></span>
      <% } %>
      <% if (c.categoryTexts.length) { %>
        <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-blue-600/20 text-blue-400 border border-blue-600/30"><%= t('customCommands.categoryOverridesBadge') %> · <%= c.categoryTexts.length %></span>
      <% } %>
      <% c.aliases.forEach(function(alias) { %>
        <code class="text-[10px] px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400 border border-neutral-700">!<%= alias %></code>
      <% }) %>
    </div>
    <p class="text-sm text-neutral-400 mt-1 break-words"><%= c.result %></p>
    <% if (c.categoryTexts.length) { %>
      <ul class="mt-1 space-y-0.5">
        <% c.categoryTexts.forEach(function(ov) { %>
          <li class="text-xs text-neutral-500 break-words"><span class="text-neutral-400 font-medium"><%= ov.category %>:</span> <%= ov.result %></li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="flex items-center gap-1 shrink-0">
    <%# Enable/disable toggle: submits via fetch when JS is available
        (public/js/custom-commands.js's data-command-toggle handler - flips the switch
        in place, no reload, so the CSS transition actually plays) and falls back to a
        plain form submit (classic redirect) otherwise. data-group lets the group header's
        master switch (if any) find and repaint this button after a bulk toggle. %>
    <form method="post" action="/<%= channel.channelLogin %>/settings/custom-commands/commands" data-command-toggle data-group="<%= c.group %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="action" value="toggle" />
      <input type="hidden" name="name" value="<%= c.command %>" />
      <button type="submit"
              class="relative inline-flex h-5 w-9 items-center rounded-full transition-colors <%= c.enabled ? 'bg-purple-600' : 'bg-neutral-700' %>"
              aria-pressed="<%= c.enabled ? 'true' : 'false' %>"
              aria-label="<%= t('customCommands.toggleEnabled') %>">
        <span class="inline-block h-3.5 w-3.5 transform rounded-full bg-white transition-transform <%= c.enabled ? 'translate-x-4' : 'translate-x-1' %>"></span>
      </button>
    </form>

    <%# Row actions, collapsed behind one "..." button. <details> again (same reasoning as the
        group headers in partials/customCommandsList.ejs): it opens without JS, so the delete and
        move forms inside stay reachable with scripting off - both are ordinary POSTs that fall
        back to the classic redirect. public/js/custom-commands.js only adds closing-on-
        outside-click, one-menu-at-a-time, and the fetch-based submit. %>
    <details class="cc-menu relative">
      <summary class="cc-menu-summary p-1.5 rounded text-neutral-500 hover:text-neutral-200 hover:bg-neutral-800 transition-colors cursor-pointer select-none"
               aria-label="<%= t('customCommands.rowMenu') %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path d="M6 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm7.5 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm7.5 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
        </svg>
      </summary>

      <%# draggable="false" here (and the guard in public/js/custom-commands.js's dragstart) keeps
          the row's own drag from hijacking a click or a text selection inside the open menu -
          the <li> above is draggable, and a draggable ancestor otherwise swallows pointer
          gestures on its descendants. %>
      <div class="cc-menu-panel absolute right-0 top-full mt-1 z-20 w-72 rounded-lg border border-neutral-700 bg-neutral-950 shadow-xl shadow-black/50 p-1 text-left" draggable="false">
        <%# Edit is client-side only: it copies the row back into the form above. The form posts
            an upsert, so "edit" and "create" are the same request - and it deliberately carries
            no group field, so editing never moves a command out of its group. %>
        <button type="button"
                class="js-edit w-full flex items-center gap-2 px-2.5 py-2 rounded-md text-sm text-neutral-300 hover:bg-neutral-800 hover:text-neutral-100 transition-colors"
                data-name="<%= c.command %>"
                data-result="<%= c.result %>"
                data-timer="<%= c.timerSeconds || '' %>"
                data-pin="<%= c.pin ? '1' : '' %>"
                data-announce="<%= c.announce ? '1' : '' %>"
                data-announce-color="<%= c.announceColor %>"
                data-mod-only="<%= c.modOnly ? '1' : '' %>"
                data-category-texts="<%= JSON.stringify(c.categoryTexts) %>"
                data-aliases="<%= c.aliases.join(', ') %>"><%- include('iconPencil') %><%= t('customCommands.edit') %></button>

        <div class="my-1 border-t border-neutral-800"></div>

        <%# Move to another group. A free-text input backed by the list's shared <datalist> covers
            both halves of the operation in one control: pick an existing group, or type a name
            that doesn't exist yet and it's created on save. Left blank, the command drops out of
            every group. %>
        <form method="post" action="/<%= channel.channelLogin %>/settings/custom-commands/commands" class="js-row-action px-2.5 py-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="action" value="setGroup" />
          <input type="hidden" name="name" value="<%= c.command %>" />
          <label class="block text-[10px] uppercase tracking-wide text-neutral-500 mb-1" for="move-<%= c.command %>"><%= t('customCommands.moveToGroup') %></label>
          <div class="flex gap-1.5">
            <input type="text" id="move-<%= c.command %>" name="group" value="<%= c.group %>"
                   list="group-list" autocomplete="off" maxlength="<%= maxGroupLength %>"
                   placeholder="<%= t('customCommands.moveNoGroup') %>"
                   class="min-w-0 flex-1 bg-neutral-900 border border-neutral-700 rounded-md px-2 py-1.5 text-sm text-neutral-200 placeholder:text-neutral-600 focus:outline-none focus:border-purple-600" />
            <button type="submit"
                    class="shrink-0 px-2.5 py-1.5 rounded-md bg-purple-600 hover:bg-purple-500 text-white text-xs font-medium transition-colors"><%= t('customCommands.move') %></button>
          </div>
          <p class="text-[11px] text-neutral-600 mt-1"><%= t('customCommands.moveHint') %></p>
        </form>

        <div class="my-1 border-t border-neutral-800"></div>

        <form method="post" action="/<%= channel.channelLogin %>/settings/custom-commands/commands" class="js-row-action js-delete-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="name" value="<%= c.command %>" />
          <button type="submit"
                  class="w-full flex items-center gap-2 px-2.5 py-2 rounded-md text-sm text-neutral-400 hover:bg-red-500/10 hover:text-red-400 transition-colors"><%- include('iconTrash') %><%= t('customCommands.delete') %></button>
        </form>
      </div>
    </details>
  </div>
</li>
