<%# The emote after a recap heading (lib/recapHeadingEmotes.js's resolveHeadingEmotes). Nothing
    when the channel cannot draw it - never the bare name. Sized to the heading's own text.
    Params: emote ({ name, url } or undefined). -%>
<% if (emote && emote.url) { %><img src="<%= emote.url %>" alt="<%= emote.name %>" title="<%= emote.name %>" loading="lazy" class="recap-heading-emote" /><% } -%>
