<%# The emote after a recap heading (lib/recapHeadingEmotes.js). Drawn only when the channel has a
    picture for it; otherwise nothing - never the bare name. Sized to the heading's own text.
    Params: name (emote name or undefined), images (Map name -> url). -%>
<% const headingUrl = name && images && typeof images.get === 'function' ? images.get(name) : null; -%>
<% if (headingUrl) { %><img src="<%= headingUrl %>" alt="<%= name %>" title="<%= name %>" loading="lazy" class="recap-heading-emote" /><% } -%>
