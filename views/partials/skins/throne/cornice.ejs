<%# The gilded hall's cornice: three bands of moulding with a row of beads.

    preserveAspectRatio="none" is safe HERE because the ornament is bands and a bead pattern -
    horizontal stretch moves the band edges and nothing else. The rose skin cannot do this; see
    the note in its own cornice. %>
<svg class="throne-hall__cornice" viewBox="0 0 1200 46" preserveAspectRatio="none" role="presentation">
  <rect x="0" y="0" width="1200" height="26" fill="url(#throne-gold-flat)" opacity="0.9" />
  <rect x="0" y="26" width="1200" height="12" fill="url(#throne-beads)" />
  <rect x="0" y="38" width="1200" height="5" fill="var(--throne-gold-deep)" opacity="0.6" />
</svg>
