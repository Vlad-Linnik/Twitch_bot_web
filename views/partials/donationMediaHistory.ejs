<%#
  How many finished donations the queue panel's history keeps (routes/donationMedia.js, POST
  .../buttons with action=history), on the owner's setup page. Reads channel, historyLimit,
  historyMin, historyMax, csrfToken from the page.
%>
<%
  const hInput = 'w-full bg-neutral-950 border border-neutral-800 rounded-md px-3 py-2 text-sm text-neutral-200 placeholder:text-neutral-600 focus:outline-none focus:border-purple-600';
  const hButton = 'px-4 py-2 rounded-md bg-purple-700 hover:bg-purple-600 text-white text-sm font-medium';
%>
<section id="history" class="mb-10 rounded-lg border border-neutral-800 bg-neutral-900 p-6 scroll-mt-24">
  <h2 class="text-lg font-semibold text-neutral-100 mb-1"><%= t('donationMedia.setup.historyHeading') %></h2>
  <p class="text-sm text-neutral-500 mb-4"><%= t('donationMedia.setup.historyIntro') %></p>
  <form method="post" enctype="multipart/form-data" action="/<%= channel.channelLogin %>/settings/donation-media/buttons" class="flex flex-wrap items-center gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="action" value="history" />
    <input type="number" name="historyLimit" min="<%= historyMin %>" max="<%= historyMax %>" step="1" value="<%= historyLimit %>" required class="<%= hInput %> w-28" />
    <span class="text-sm text-neutral-500"><%= t('donationMedia.setup.historyUnit', { min: historyMin, max: historyMax }) %></span>
    <button type="submit" class="<%= hButton %>"><%= t('donationMedia.setup.historySave') %></button>
  </form>
</section>
