<%#
  A whole split into a few parts (at most three here: a film's type, a game's state), as a ring with
  a 2-unit gap between segments and the total in the middle. Colours come from the fixed categorical
  slots (--series-1..3, public/css/input.css, validated as a set on the dark surface) by the part's
  position in the field's own order, so a colour always means the same value. Identity never rests on
  colour alone: the legend beside it names every part with its count and share.
  Expects: parts ([{label, count, share, slot}]), total, centerLabel.
%>
<%
  const R = 46, C = 2 * Math.PI * R, GAP = parts.length > 1 ? 2 : 0;
  let offset = 0;
%>
<div class="flex flex-wrap items-center gap-6">
  <svg viewBox="0 0 120 120" class="w-36 h-36 shrink-0" role="img" aria-label="<%= parts.map(function(p) { return p.label + ': ' + p.count; }).join(', ') %>">
    <g transform="rotate(-90 60 60)">
    <circle cx="60" cy="60" r="<%= R %>" fill="none" stroke="#292524" stroke-width="16" />
    <% parts.forEach(function(p) { const len = (p.count / total) * C; %>
      <circle cx="60" cy="60" r="<%= R %>" fill="none" stroke="var(--series-<%= p.slot %>)" stroke-width="16"
              stroke-dasharray="<%= Math.max(len - GAP, 0.5) %> <%= C %>" stroke-dashoffset="<%= -offset %>"
              class="transition-opacity hover:opacity-80"><title><%= p.label %>: <%= p.count %> (<%= p.share %>%)</title></circle>
      <% offset += len; %>
    <% }) %>
    </g>
    <g>
      <text x="60" y="60" text-anchor="middle" class="fill-stone-100 text-[22px] font-extrabold tabular-nums"><%= total %></text>
      <text x="60" y="76" text-anchor="middle" class="fill-stone-400 text-[9px]"><%= centerLabel %></text>
    </g>
  </svg>
  <ul class="space-y-1.5 text-sm">
    <% parts.forEach(function(p) { %>
      <li class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-sm shrink-0" style="background: var(--series-<%= p.slot %>)" aria-hidden="true"></span>
        <span class="text-stone-200"><%= p.label %></span>
        <span class="ml-auto pl-4 tabular-nums text-stone-400"><%= p.count %> · <%= p.share %>%</span>
      </li>
    <% }) %>
  </ul>
</div>
