<%- include('partials/head', { title: channel.channelLogin + ' ' + t('recap.awards.titleSuffix') }) %>
<%- include('partials/nav') %>
<%
  const loc = locale === 'ru' ? 'ru-RU' : 'en-GB';
  const fmt = (n) => Number(n || 0).toLocaleString(loc);
  const fmtDate = (d, opts) => new Date(d).toLocaleString(loc, Object.assign({ timeZone: 'Europe/Moscow' }, opts));
  const card = 'rounded-xl border border-neutral-800 bg-neutral-900/60 p-5';
  // In the admin's test view the buttons are drawn, as a voter would see them, but inert: the
  // real window is not open, and the server would refuse the vote anyway.
  const canVote = phase === 'open' && (previewPhase || (loggedIn && eligible));
  const inert = Boolean(previewPhase);
  const base = '/' + channel.channelLogin + '/recap/' + year + '/awards';
  const lastDay = new Date(awardWindow.closes.getTime() - 1);
  const csrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
%>

<main class="pt-14 max-w-3xl mx-auto px-4 sm:px-6 py-12">

  <%- include('partials/channelHeader', { channel, broadcaster, channelNav }) %>

  <p class="mb-4 text-sm"><a href="/<%= channel.channelLogin %>/recap/<%= year %>" class="text-purple-300 hover:text-purple-200">← <%= t('recap.me.backToChannel', { year }) %></a></p>

  <% if (preview) { %>
    <div class="mb-8 rounded-md border border-amber-800/60 bg-amber-950/40 text-amber-300 text-sm px-4 py-3"><%= t('recap.previewNotice') %></div>
  <% } %>

  <%# Site admin only: the page in any phase, today (routes/annualRecap.js's previewPhase). %>
  <% if (isAdmin) { %>
    <div class="mb-6 rounded-lg border border-sky-900/60 bg-sky-950/30 px-4 py-3 text-sm">
      <p class="text-sky-300 font-medium"><%= t('recap.awards.test.heading') %></p>
      <nav class="mt-2 flex flex-wrap gap-2" aria-label="<%= t('recap.awards.test.heading') %>">
        <% [['soon', 'soon'], ['open', 'open'], ['closed', 'closed'], [null, 'real']].forEach(function (opt) {
             const active = opt[0] === previewPhase; %>
          <a href="<%= base %><%= opt[0] ? '?preview=' + opt[0] : '' %>"
             class="px-2.5 py-1 rounded-md text-xs <%= active ? 'bg-sky-700 text-white' : 'border border-sky-900 text-sky-300 hover:bg-sky-900/40' %>"><%= t('recap.awards.test.' + opt[1]) %></a>
        <% }) %>
      </nav>
      <% if (previewPhase) { %>
        <p class="mt-2 text-xs text-sky-200/80"><%= t('recap.awards.test.note') %><% if (demo) { %> <strong class="text-amber-300"><%= t('recap.awards.test.demoVotes') %></strong><% } %></p>
      <% } %>
    </div>
  <% } %>

  <section class="mb-8 rounded-2xl border border-amber-900/50 bg-gradient-to-br from-amber-950/60 via-neutral-900 to-neutral-950 p-6">
    <p class="text-xs uppercase tracking-widest text-amber-300/80"><%= t('recap.awards.kicker') %></p>
    <h1 class="mt-1 text-3xl font-bold text-white"><%= t('recap.awards.heading', { year }) %></h1>
    <p class="mt-2 text-sm text-neutral-300">
      <% if (phase === 'soon') { %>
        <%= t('recap.awards.soon', { date: fmtDate(awardWindow.opens, { day: 'numeric', month: 'long' }) }) %>
      <% } else if (phase === 'open') { %>
        <%= t('recap.awards.open', { date: fmtDate(lastDay, { day: 'numeric', month: 'long' }), n: fmt(voters) }) %>
      <% } else { %>
        <%= t('recap.awards.closed', { n: fmt(voters) }) %>
      <% } %>
    </p>
    <% if (phase === 'open') { %>
      <p class="mt-3 text-xs text-neutral-400">
        <% if (previewPhase) { %>
          <%= t('recap.awards.howTo') %>
        <% } else if (!loggedIn) { %>
          <a href="/auth/login?returnTo=<%= encodeURIComponent(currentUrl) %>" class="text-purple-300 hover:text-purple-200 underline"><%= t('nav.login') %></a> — <%= t('recap.awards.loginToVote', { n: minMessages }) %>
        <% } else if (!eligible) { %>
          <%= t('recap.awards.notEligible', { n: minMessages }) %>
        <% } else { %>
          <%= t('recap.awards.howTo') %>
        <% } %>
      </p>
    <% } %>
    <% if (liveResults) { %>
      <p class="mt-3 text-xs text-amber-400"><%= t('recap.awards.adminLive') %></p>
    <% } %>
  </section>

  <% if (phase === 'soon') { %>
    <ul class="grid sm:grid-cols-2 gap-3">
      <% ['voice', 'pair', 'word', 'emote', 'opener', 'moment'].forEach(function (key) { %>
        <li class="<%= card %>"><p class="font-semibold text-neutral-100"><%= t('recap.awards.name.' + key) %></p><p class="text-xs text-neutral-500 mt-1"><%= t('recap.awards.desc.' + key) %></p></li>
      <% }) %>
    </ul>
  <% } else if (!ballot.length) { %>
    <p class="text-center text-neutral-500 text-sm py-16"><%= t('recap.awards.empty') %></p>
  <% } else { %>
  <div class="grid gap-6" data-awards>
    <% ballot.forEach(function (award) {
         const r = results && results[award.key];
         const maxVotes = r ? Math.max(1, ...r.tally.map(function (x) { return x.votes; })) : 1; %>
      <section id="award-<%= award.key %>" class="<%= card %>" data-award="<%= award.key %>">
        <h2 class="text-lg font-semibold text-neutral-100"><%= t('recap.awards.name.' + award.key) %></h2>
        <p class="text-xs text-neutral-500 mb-4"><%= t('recap.awards.desc.' + award.key) %></p>
        <ul class="space-y-2">
          <% award.nominees.forEach(function (n) {
               const mine = myVotes[award.key] === n.id;
               const votes = r ? (r.tally.find(function (x) { return x.id === n.id; }) || { votes: 0 }).votes : null;
               const won = r && phase === 'closed' && r.winners.includes(n.id); %>
            <li class="relative rounded-lg border <%= won ? 'border-amber-500/70 bg-amber-950/30' : mine ? 'border-purple-500/70 bg-purple-950/30' : 'border-neutral-800 bg-black/20' %> px-3 py-2" data-nominee="<%= n.id %>">
              <% if (votes !== null) { %>
                <div class="absolute inset-y-0 left-0 rounded-lg bg-amber-500/10" style="width: <%= Math.round((votes / maxVotes) * 100) %>%" aria-hidden="true"></div>
              <% } %>
              <div class="relative flex items-center gap-3">
                <% if (won) { %><span title="<%= t('recap.awards.winner') %>">🏆</span><% } %>
                <div class="min-w-0 flex-1">
                  <% if (award.key === 'emote') { %>
                    <span class="text-neutral-100"><%- include('partials/recapChatText', { text: n.label, images }) %></span> <span class="text-xs text-neutral-500"><%= n.label %></span>
                  <% } else if (award.key === 'moment') { %>
                    <span class="text-neutral-100"><%= fmtDate(n.at, { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) %></span>
                    <% if (n.label) { %><span class="text-neutral-300 break-words"> — «<%- include('partials/recapChatText', { text: n.label, images }) %>»</span><% } %>
                    <% if (n.category) { %><span class="text-xs text-neutral-500"> · <%= n.category %></span><% } %>
                  <% } else { %>
                    <span class="text-neutral-100 break-words"><%= n.label %></span>
                    <% if (award.key === 'word' && n.by) { %><span class="text-xs text-neutral-500"> · <%= t('recap.awards.wordBy', { name: n.by }) %></span><% } %>
                  <% } %>
                  <p class="text-xs text-neutral-500"><%= t('recap.awards.stat.' + award.key, { n: fmt(n.n) }) %></p>
                </div>
                <% if (votes !== null) { %>
                  <span class="text-sm text-amber-300 tabular-nums"><%= fmt(votes) %></span>
                <% } %>
                <% if (canVote && inert) { %>
                  <button type="button" disabled title="<%= t('recap.awards.test.inert') %>" class="px-3 py-1 rounded-md text-xs font-medium border border-neutral-700 text-neutral-400 cursor-not-allowed"><%= t('recap.awards.vote') %></button>
                <% } else if (canVote) { %>
                  <form method="post" action="/<%= channel.channelLogin %>/recap/<%= year %>/awards/vote" data-vote-form>
                    <input type="hidden" name="_csrf" value="<%= csrf %>" />
                    <input type="hidden" name="key" value="<%= award.key %>" />
                    <input type="hidden" name="nominee" value="<%= n.id %>" />
                    <button type="submit" class="vote-btn px-3 py-1 rounded-md text-xs font-medium border <%= mine ? 'border-purple-500 bg-purple-600 text-white' : 'border-neutral-700 text-neutral-300 hover:border-purple-500' %>"
                            data-label-vote="<%= t('recap.awards.vote') %>" data-label-mine="<%= t('recap.awards.yourVote') %>"><%= mine ? t('recap.awards.yourVote') : t('recap.awards.vote') %></button>
                  </form>
                <% } else if (mine) { %>
                  <span class="text-xs text-purple-300"><%= t('recap.awards.yourVote') %></span>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      </section>
    <% }) %>
  </div>
  <p class="mt-6 text-xs text-neutral-500"><%= t('recap.awards.footnote', { n: minMessages }) %></p>
  <% } %>
</main>

<script src="<%= asset('/js/chat-awards.js') %>" defer></script>
<%- include('partials/foot') %>
